<%
  // 1. Safe normalization of data passed from controller or defaults
  const allOrders = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : [];
  
  const searchVal = (typeof search !== 'undefined' && search) 
    ? String(search).trim() 
    : ((typeof locals !== 'undefined' && locals.search) ? String(locals.search).trim() : '');

  const statusVal = (typeof status !== 'undefined' && status) 
    ? String(status).trim() 
    : ((typeof locals !== 'undefined' && locals.status) ? String(locals.status).trim() : 'all');

  const dateRangeVal = (typeof dateRange !== 'undefined' && dateRange) 
    ? String(dateRange).trim() 
    : ((typeof locals !== 'undefined' && locals.dateRange) ? String(locals.dateRange).trim() : 'all');

  const cardDataObj = (typeof cardData !== 'undefined' && cardData) ? cardData : {
    confirmedOrders: 0,
    processingOrders: 0,
    shippedOrders: 0,
    deliveredOrders: 0,
    returnedOrders: 0
  };

  const totalOrdersCountServer = typeof totalOrders !== 'undefined' ? Number(totalOrders) : allOrders.length;

  // 2. Determine whether server already provided pagination
  const serverHasPaginated = typeof pagination !== 'undefined' && pagination && typeof pagination.currentPage !== 'undefined';

  let currentPageNum = 1;
  let totalPagesCount = 1;
  let totalCount = totalOrdersCountServer;
  let fromCount = 0;
  let toCount = 0;
  let displayOrders = allOrders;

  if (serverHasPaginated) {
    currentPageNum = Number(pagination.currentPage) || 1;
    totalCount = Number(pagination.total) || totalOrdersCountServer;
    const limit = Number(pagination.limit) || 10;
    totalPagesCount = Number(pagination.lastPage || pagination.totalPages) || Math.max(1, Math.ceil(totalCount / limit));
    fromCount = typeof pagination.from !== 'undefined' ? Number(pagination.from) : (totalCount === 0 ? 0 : (currentPageNum - 1) * limit + 1);
    toCount = typeof pagination.to !== 'undefined' ? Number(pagination.to) : Math.min(currentPageNum * limit, totalCount);
    displayOrders = allOrders;
  } else {
    // Client-side / in-template filtering fallback if server passed unpaginated orders
    let filtered = allOrders;

    if (searchVal) {
      const q = searchVal.toLowerCase();
      filtered = filtered.filter(function(o) {
        const orderIdMatch = o.orderId && o.orderId.toLowerCase().includes(q);
        const nameMatch = o.shippingAddress && o.shippingAddress.fullName && o.shippingAddress.fullName.toLowerCase().includes(q);
        const phoneMatch = o.shippingAddress && o.shippingAddress.phoneNumber && String(o.shippingAddress.phoneNumber).includes(q);
        const userEmailMatch = o.user && o.user.email && o.user.email.toLowerCase().includes(q);
        const amountMatch = o.totalPrice && String(o.totalPrice).includes(q);
        return orderIdMatch || nameMatch || phoneMatch || userEmailMatch || amountMatch;
      });
    }

    if (statusVal && statusVal !== 'all') {
      filtered = filtered.filter(function(o) {
        return (o.orderStatus || '').toLowerCase() === statusVal.toLowerCase();
      });
    }

    if (dateRangeVal && dateRangeVal !== 'all') {
      const now = new Date();
      filtered = filtered.filter(function(o) {
        const d = new Date(o.createdAt);
        if (isNaN(d.getTime())) return true;
        if (dateRangeVal === 'today') {
          return d.toDateString() === now.toDateString();
        } else if (dateRangeVal === '7days') {
          return (now.getTime() - d.getTime()) <= (7 * 24 * 60 * 60 * 1000);
        } else if (dateRangeVal === '30days') {
          return (now.getTime() - d.getTime()) <= (30 * 24 * 60 * 60 * 1000);
        } else if (dateRangeVal === 'this-month') {
          return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
        } else if (dateRangeVal === 'this-year') {
          return d.getFullYear() === now.getFullYear();
        }
        return true;
      });
    }

    const pageSize = 10;
    totalCount = filtered.length;
    totalPagesCount = Math.max(1, Math.ceil(totalCount / pageSize));

    let requestedPage = 1;
    if (typeof currentPage !== 'undefined') requestedPage = Number(currentPage);
    else if (typeof page !== 'undefined') requestedPage = Number(page);
    else if (typeof locals !== 'undefined' && locals.page) requestedPage = Number(locals.page);
    
    if (isNaN(requestedPage) || requestedPage < 1) requestedPage = 1;
    if (requestedPage > totalPagesCount && totalPagesCount > 0) requestedPage = totalPagesCount;
    currentPageNum = requestedPage;

    fromCount = totalCount === 0 ? 0 : (currentPageNum - 1) * pageSize + 1;
    toCount = Math.min(currentPageNum * pageSize, totalCount);

    displayOrders = filtered.slice(fromCount > 0 ? fromCount - 1 : 0, toCount);
  }
%>
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Order Management · Voltiq Admin Portal' %>
  </title>
  <link rel="stylesheet" href="/css/admin/order-management.css">
</head>

<body>

  <div class="admin-layout">

    <!-- ================= SIDEBAR ================= -->
    <aside class="admin-sidebar">
      <a href="/admin/dashboard" class="brand-wrapper">
        <svg class="brand-bolt-icon" viewBox="0 0 24 24" fill="currentColor">
          <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" />
        </svg>
        <div class="brand-text-block">
