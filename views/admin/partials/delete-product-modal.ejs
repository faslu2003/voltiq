<!-- ================= REUSABLE DELETE PRODUCT MODAL PARTIAL ================= -->
<div class="product-modal-backdrop hidden" id="deleteProductModalBackdrop" onclick="handleDeleteProductBackdropClick(event)">
  <div class="delete-modal-dialog" role="dialog" aria-labelledby="deleteProductModalTitle" aria-modal="true">
    
    <!-- Modal Header with Warning Icon -->
    <div class="delete-modal-header">
      <div class="warning-icon-badge">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          <line x1="10" y1="11" x2="10" y2="17"></line>
          <line x1="14" y1="11" x2="14" y2="17"></line>
        </svg>
      </div>
      <button type="button" class="category-modal-close" onclick="closeDeleteProductModal()" aria-label="Close modal">✕</button>
    </div>

    <!-- Modal Body Content -->
    <div class="delete-modal-body">
      <h2 class="delete-modal-title" id="deleteProductModalTitle">Delete Product?</h2>
      <p class="delete-modal-desc">
        Are you sure you want to delete <strong id="deleteProductName">this product</strong>? This action cannot be undone. You can set it to <strong>Inactive</strong> instead to hide it from shoppers.
      </p>

      <!-- Target Product Details Card -->
      <div class="delete-category-card">
        <div class="delete-thumb-box">
          <img src="/images/avatar.jpg" alt="Product Image" id="deleteProductImg">
        </div>
        <div class="delete-card-info">
          <span class="delete-card-title" id="deleteProductCardTitle">Product Name</span>
          <span class="delete-card-subtext" id="deleteProductCardSubtext">SKU: PROD-123</span>
        </div>
      </div>
    </div>

    <!-- Modal Footer Actions: Inactive & Delete Product -->
    <div class="delete-modal-actions">
      <button type="button" class="btn-modal-inactive" onclick="makePendingProductInactive()">Inactive</button>
      <button type="button" class="btn-confirm-delete" id="btnConfirmDeleteProduct" onclick="confirmProductDelete()">Delete Product</button>
    </div>

  </div>
</div>
