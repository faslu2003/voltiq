<!-- ================= REUSABLE INACTIVE CATEGORY MODAL PARTIAL ================= -->
<div class="category-modal-backdrop hidden" id="inactiveModalBackdrop" onclick="handleInactiveBackdropClick(event)">
  <div class="inactive-modal-dialog" role="dialog" aria-labelledby="inactiveModalTitle" aria-modal="true">
    
    <!-- Modal Header with Amber Warning Icon -->
    <div class="inactive-modal-header">
      <div class="amber-icon-badge">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
          <line x1="1" y1="1" x2="23" y2="23"></line>
        </svg>
      </div>
      <button type="button" class="category-modal-close" onclick="cancelCategoryInactive()" aria-label="Close modal">✕</button>
    </div>

    <!-- Modal Body Content -->
    <div class="inactive-modal-body">
      <h2 class="inactive-modal-title" id="inactiveModalTitle">Hide Category?</h2>
      <p class="inactive-modal-desc">
        Are you sure you want to set <strong id="inactiveCategoryName">this category</strong> to inactive? It will no longer be visible to shoppers on the public storefront.
      </p>

      <!-- Target Category Details Card -->
      <div class="inactive-category-card">
        <div class="inactive-thumb-box">
          <img src="/images/avatar.jpg" alt="Category Image" id="inactiveCategoryImg">
        </div>
        <div class="inactive-card-info">
          <span class="inactive-card-title" id="inactiveCardTitle">Category Name</span>
          <span class="inactive-card-subtext" id="inactiveCardSubtext">148 Storefront Items</span>
        </div>
      </div>
    </div>

    <!-- Modal Footer Actions -->
    <div class="inactive-modal-actions">
      <button type="button" class="btn-modal-cancel" onclick="cancelCategoryInactive()">Cancel</button>
      <button type="button" class="btn-confirm-inactive" id="btnConfirmInactive" onclick="confirmCategoryInactive()">Make Inactive</button>
    </div>

  </div>
</div>
