<!-- ================= REUSABLE ADD PRODUCT MODAL PARTIAL ================= -->
<div class="product-modal-backdrop hidden" id="productModalBackdrop" onclick="handleProductBackdropClick(event)">
  <div class="product-modal-dialog" role="dialog" aria-labelledby="productModalTitle" aria-modal="true">
    
    <!-- Modal Header -->
    <div class="product-modal-header">
      <div class="header-text-group">
        <h2 class="product-modal-title" id="productModalTitle">Add New Product</h2>
        <p class="product-modal-subtitle">Fill in the details to create a new SKU in your digital catalog.</p>
      </div>
      <button type="button" class="product-modal-close" onclick="closeProductModal()" aria-label="Close modal">✕</button>
    </div>

    <!-- Form Body -->
    <form action="/admin/products" method="POST" enctype="multipart/form-data" class="product-modal-form" id="addProductForm">
      
      <!-- SECTION 1: BASIC INFORMATION -->
      <div class="modal-form-section">
        <div class="section-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          BASIC INFORMATION
        </div>

        <!-- Product Name (productName) -->
        <div class="form-field-group">
          <label for="productName" class="field-label">Product Name</label>
          <input type="text" id="productName" name="name" class="field-input" placeholder="e.g. Voltiq Ultra Pro Headphones" autocomplete="off">
        </div>

        <!-- Category (categoryId) & Brand (brandId) 2-Column Grid -->
        <div class="field-grid-2">
          <div class="form-field-group">
            <label for="productCategoryId" class="field-label">Category</label>
            <div class="select-wrapper">
              <select id="productCategoryId" name="categoryId" class="field-select">
                <option value="" disabled selected>Select Category</option>
                <% if (typeof categories !== 'undefined' && categories.length) { %>
                  <% categories.forEach((category) => { %>
                    <option value="<%= category._id %>"><%= category.categoryName %></option>
                  <% }) %>
                <% } %>
              </select>
              <svg class="select-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>

          <div class="form-field-group">
            <label for="productBrandId" class="field-label">Brand</label>
            <div class="select-wrapper">
              <select id="productBrandId" name="brandId" class="field-select">
                <option value="" disabled selected>Select Brand</option>
                <% if (typeof brands !== 'undefined' && brands.length) { %>
                  <% brands.forEach((brand) => { %>
                    <option value="<%= brand._id %>"><%= brand.name %></option>
                  <% }) %>
                <% } %>
              </select>
              <svg class="select-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>
        </div>

        <!-- Base Price (price) -->
        <div class="form-field-group">
          <label for="productPrice" class="field-label">Base Price (INR)</label>
          <div class="price-input-wrapper">
            <span class="currency-symbol">₹</span>
            <input type="number" id="productPrice" name="basePrice" class="field-input price-input" placeholder="0.00" step="0.01" min="0">
          </div>
        </div>

        <!-- Description (description) -->
        <div class="form-field-group">
          <label for="productDescription" class="field-label">Description</label>
          <textarea id="productDescription" name="description" class="field-textarea" placeholder="Describe key product features, specs, and details..."></textarea>
        </div>
      </div>

      <!-- SECTION 2: PRODUCT IMAGES (imgUrls with Crop & Resize) -->
      <div class="modal-form-section">
        <div class="section-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          MAIN GALLERY IMAGES
        </div>

        <div class="form-field-group">
          <div class="field-header-row">
            <!-- <label class="field-label">Product Main Images</label> -->
          </div>

          <!-- Native HTML Label Dropzone -->
          <label for="productImagesInput" class="multi-image-dropzone" id="productDropzone" ondragover="handleProductDragOver(event)" ondragleave="handleProductDragLeave(event)" ondrop="handleProductFileDrop(event)">
            <input type="file" id="productImagesInput" name="productImages" class="hidden-file-input" accept="image/png, image/jpeg, image/webp" multiple onchange="handleProductFilesSelect(event)">
            
            <div class="upload-zone-content" id="productUploadContent">
              <div class="upload-icon-circle">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="12" y1="18" x2="12" y2="12"></line>
                  <polyline points="9 15 12 12 15 15"></polyline>
                </svg>
              </div>
              <span class="upload-primary-text">Click to upload or drag & drop main gallery images</span>
              <span class="upload-secondary-text">PNG, JPG, WEBP (Select multiple images. Hover thumbnails to crop/resize)</span>
            </div>

            <!-- Thumbnails Preview Grid -->
            <div class="image-preview-grid hidden" id="productPreviewGrid" onclick="event.stopPropagation();"></div>
          </label>
        </div>
      </div>

      <!-- SECTION 3: VARIANTS (Multiple Images & Stocks per Variant) -->
      <div class="modal-form-section">
        <div class="section-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          VARIANTS
        </div>

        <div class="variants-container" id="variantsContainer">
          <!-- Variant rows will be appended dynamically by JavaScript -->
        </div>

        <button type="button" class="btn-add-variant-dashed" onclick="addVariantRow()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Another Variant
        </button>
      </div>

      <!-- SECTION 4: PRODUCT HIGHLIGHTS -->
      <div class="modal-form-section">
        <div class="section-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          PRODUCT HIGHLIGHTS
        </div>

        <div class="highlights-container" id="highlightsContainer">
          <div class="highlight-row-input">
            <span class="highlight-bullet">•</span>
            <input type="text" name="highlights[]" class="field-input" placeholder="e.g. Ceramic Shield front glass, 4x stronger drop performance">
            <button type="button" class="btn-remove-highlight" onclick="removeHighlightRow(this)">✕</button>
          </div>
          <div class="highlight-row-input">
            <span class="highlight-bullet">•</span>
            <input type="text" name="highlights[]" class="field-input" placeholder="e.g. A18 Pro Bionic Chip with 6-core GPU">
            <button type="button" class="btn-remove-highlight" onclick="removeHighlightRow(this)">✕</button>
          </div>
        </div>

        <button type="button" class="btn-add-highlight-dashed" onclick="addHighlightRow()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Highlight Bullet
        </button>
      </div>

      <!-- SECTION 5: VISIBILITY -->
      <div class="visibility-toggle-card">
        <div class="visibility-info">
          <div class="visibility-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <div class="visibility-text">
            <span class="visibility-title">Visibility</span>
            <span class="visibility-subtitle" id="productVisibilityText">Show this product on the public storefront</span>
          </div>
        </div>
        <label class="modal-toggle-switch">
          <input type="checkbox" id="productIsActive" name="isActive" checked onchange="toggleProductVisibilityLabel(this)">
          <span class="modal-toggle-slider"></span>
        </label>
      </div>

      <!-- Modal Footer Action Buttons -->
      <div class="product-modal-actions">
        <button type="button" class="btn-modal-cancel" onclick="closeProductModal()">Cancel</button>
        <button type="submit" class="btn-modal-save" id="btnSaveProduct">Add Product</button>
      </div>

    </form>
  </div>
</div>

<!-- ================= CROP & RESIZE MODAL OVERLAY ================= -->
<div class="crop-modal-backdrop hidden" id="cropModalBackdrop" onclick="handleCropBackdropClick(event)">
  <div class="crop-modal-dialog">
    <div class="crop-modal-header">
      <div>
        <h3 class="crop-modal-title">Crop & Resize Image</h3>
        <p class="crop-modal-subtitle">Adjust position, zoom, aspect ratio, and custom target dimensions.</p>
      </div>
      <button type="button" class="crop-modal-close" onclick="closeCropModal()">✕</button>
    </div>

    <div class="crop-modal-body">
      <!-- Cropper Image Container -->
      <div class="cropper-view-wrapper">
        <img id="cropperTargetImage" src="" alt="Target Image to Crop">
      </div>

      <!-- Cropper Control Toolbar -->
      <div class="cropper-toolbar">
        <div class="tool-group">
          <span class="tool-label">Aspect Ratio:</span>
          <button type="button" class="tool-btn active" onclick="setCropRatio(1, this)">1:1 Square</button>
          <button type="button" class="tool-btn" onclick="setCropRatio(4/3, this)">4:3</button>
          <button type="button" class="tool-btn" onclick="setCropRatio(16/9, this)">16:9</button>
          <button type="button" class="tool-btn" onclick="setCropRatio(NaN, this)">Free</button>
        </div>

        <div class="tool-group">
          <span class="tool-label">Transform:</span>
          <button type="button" class="tool-btn icon" onclick="rotateCropper(-90)" title="Rotate Left 90°">↺ -90°</button>
          <button type="button" class="tool-btn icon" onclick="rotateCropper(90)" title="Rotate Right 90°">↻ +90°</button>
          <button type="button" class="tool-btn icon" onclick="zoomCropper(0.1)" title="Zoom In">+</button>
          <button type="button" class="tool-btn icon" onclick="zoomCropper(-0.1)" title="Zoom Out">-</button>
        </div>

        <div class="tool-group">
          <span class="tool-label">Resize Dimensions (px):</span>
          <input type="number" id="cropWidthInput" class="crop-size-input" placeholder="W" value="800" min="100" max="3000">
          <span style="font-weight: 700; color: #718096;">×</span>
          <input type="number" id="cropHeightInput" class="crop-size-input" placeholder="H" value="800" min="100" max="3000">
        </div>
      </div>
    </div>

    <div class="crop-modal-footer">
      <button type="button" class="btn-crop-cancel" onclick="closeCropModal()">Cancel</button>
      <button type="button" class="btn-crop-save" onclick="applyCroppedImage()">Apply Crop & Resize</button>
    </div>
  </div>
</div>
