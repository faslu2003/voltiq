<!-- ================= REUSABLE EDIT PRODUCT MODAL PARTIAL =================
     Deliberately reuses the exact classes from add-product-modal.ejs
     (.product-modal-backdrop, .product-modal-dialog, .form-field-group,
     .multi-image-dropzone, .variant-row-card, .visibility-toggle-card, etc.)
     so it inherits its styling straight from add-product-modal.css.
     No separate CSS file needed — same pattern already used by
     delete-product-modal.ejs / inactive-product-modal.ejs, which reuse
     the category modal's CSS rather than duplicating stylesheets.
==================================================================== -->
<div class="product-modal-backdrop hidden" id="editProductModalBackdrop" onclick="handleEditProductBackdropClick(event)">
  <div class="product-modal-dialog" role="dialog" aria-labelledby="editProductModalTitle" aria-modal="true">

    <!-- Modal Header -->
    <div class="product-modal-header">
      <div class="header-text-group">
        <h2 class="product-modal-title" id="editProductModalTitle">Edit Product</h2>
        <p class="product-modal-subtitle">Update the details for this SKU in your digital catalog.</p>
      </div>
      <button type="button" class="product-modal-close" onclick="closeEditProductModal()" aria-label="Close modal">✕</button>
    </div>

    <!-- Form Body -->
    <form action="/admin/products/update" method="POST" enctype="multipart/form-data" class="product-modal-form" id="editProductForm" onsubmit="handleEditProductSubmit(event)">

      <!-- Hidden Product ID -->
      <input type="hidden" id="editProductId" name="id" value="">

      <!-- SECTION 1: BASIC INFORMATION -->
      <div class="modal-form-section">
        <div class="section-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          BASIC INFORMATION
        </div>

        <!-- Product Name -->
        <div class="form-field-group">
          <label for="editProductName" class="field-label">Product Name</label>
          <input type="text" id="editProductName" name="productName" class="field-input" placeholder="e.g. Voltiq Ultra Pro Headphones" required autocomplete="off">
        </div>

        <!-- Category & Brand 2-Column Grid -->
        <div class="field-grid-2">
          <div class="form-field-group">
            <label for="editProductCategoryId" class="field-label">Category</label>
            <div class="select-wrapper">
              <select id="editProductCategoryId" name="categoryId" class="field-select" required>
                <option value="" disabled>Select Category</option>
                <option value="Smartphones">Smartphones</option>
                <option value="Laptops">Laptops</option>
                <option value="Audio">Audio</option>
                <option value="Wearables">Wearables</option>
                <option value="Cameras">Cameras</option>
                <option value="Accessories">Accessories</option>
              </select>
              <svg class="select-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>

          <div class="form-field-group">
            <label for="editProductBrandId" class="field-label">Brand</label>
            <div class="select-wrapper">
              <select id="editProductBrandId" name="brandId" class="field-select" required>
                <option value="" disabled>Select Brand</option>
                <option value="Apple">Apple</option>
                <option value="Samsung">Samsung</option>
                <option value="Google">Google</option>
                <option value="OnePlus">OnePlus</option>
                <option value="Sony">Sony</option>
                <option value="Voltiq">Voltiq Original</option>
              </select>
              <svg class="select-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </div>
          </div>
        </div>

        <!-- Base Price -->
        <div class="form-field-group">
          <label for="editProductPrice" class="field-label">Base Price (INR)</label>
          <div class="price-input-wrapper">
            <span class="currency-symbol">₹</span>
            <input type="number" id="editProductPrice" name="price" class="field-input price-input" placeholder="0.00" step="0.01" min="0" required>
          </div>
        </div>

        <!-- Description -->
        <div class="form-field-group">
          <label for="editProductDescription" class="field-label">Description</label>
          <textarea id="editProductDescription" name="description" class="field-textarea" placeholder="Describe key product features, specs, and details..." required></textarea>
        </div>
      </div>

      <!-- SECTION 2: PRODUCT IMAGES -->
      <div class="modal-form-section">
        <div class="section-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          PRODUCT IMAGES (imgUrls)
        </div>

        <div class="form-field-group">
          <label class="field-label">Gallery Images</label>

          <label for="editProductImagesInput" class="multi-image-dropzone" id="editProductDropzone" ondragover="handleEditProductDragOver(event)" ondragleave="handleEditProductDragLeave(event)" ondrop="handleEditProductFileDrop(event)">
            <input type="file" id="editProductImagesInput" name="imgUrls" class="hidden-file-input" accept="image/png, image/jpeg, image/webp" multiple onchange="handleEditProductFilesSelect(event)">

            <div class="upload-zone-content" id="editProductUploadContent">
              <div class="upload-icon-circle">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="12" y1="18" x2="12" y2="12"></line>
                  <polyline points="9 15 12 12 15 15"></polyline>
                </svg>
              </div>
              <span class="upload-primary-text">Click to upload or drag and drop product images</span>
              <span class="upload-secondary-text">PNG, JPG, or WEBP (Select multiple images, Max 5MB each)</span>
            </div>

            <!-- Existing + newly added thumbnails render here -->
            <div class="image-preview-grid hidden" id="editProductPreviewGrid" onclick="event.stopPropagation();"></div>
          </label>
        </div>
      </div>

      <!-- SECTION 3: VARIANTS -->
      <div class="modal-form-section">
        <div class="section-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          VARIANTS
        </div>

        <div class="variants-container" id="editVariantsContainer">
          <!-- Rows are (re)populated by openEditProductModal() in inventory.ejs -->
          <div class="variant-row-card">
            <div class="form-field-group">
              <label class="field-label-sm">Variant Name</label>
              <input type="text" name="variantName[]" class="field-input-sm" placeholder="e.g. Midnight, 256GB">
            </div>
            <div class="form-field-group">
              <label class="field-label-sm">Color</label>
              <input type="text" name="variantColor[]" class="field-input-sm" placeholder="Lilac">
            </div>
            <div class="form-field-group">
              <label class="field-label-sm">Storage</label>
              <input type="text" name="variantStorage[]" class="field-input-sm" placeholder="256GB">
            </div>
            <div class="form-field-group">
              <label class="field-label-sm">Addl. Price</label>
              <input type="number" name="variantAddlPrice[]" class="field-input-sm" placeholder="0.00" step="0.01">
            </div>
            <label class="variant-cam-btn" title="Attach Variant Image">
              <input type="file" name="variantImage[]" accept="image/*" class="hidden-file-input" onchange="handleVariantImageSelect(this)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
            </label>
          </div>
        </div>

        <button type="button" class="btn-add-variant-dashed" onclick="addEditVariantRow()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Another Variant
        </button>
      </div>

      <!-- SECTION 4: PRODUCT HIGHLIGHTS -->
      <div class="modal-form-section">
        <div class="section-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          PRODUCT HIGHLIGHTS (highlights)
        </div>

        <div class="highlights-container" id="editHighlightsContainer">
          <!-- Rows are (re)populated by openEditProductModal() in inventory.ejs -->
          <div class="highlight-row-input">
            <span class="highlight-bullet">•</span>
            <input type="text" name="highlights[]" class="field-input" placeholder="e.g. Ceramic Shield front glass, 4x stronger drop performance" required>
            <button type="button" class="btn-remove-highlight" onclick="removeEditHighlightRow(this)">✕</button>
          </div>
        </div>

        <button type="button" class="btn-add-highlight-dashed" onclick="addEditHighlightRow()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          Add Highlight Bullet
        </button>
      </div>

      <!-- SECTION 5: VISIBILITY & STATUS -->
      <div class="visibility-toggle-card">
        <div class="visibility-info">
          <div class="visibility-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
              <circle cx="12" cy="12" r="3"></circle>
            </svg>
          </div>
          <div class="visibility-text">
            <span class="visibility-title">Visibility (isActive)</span>
            <span class="visibility-subtitle" id="editProductVisibilityText">Show this product on the public storefront</span>
          </div>
        </div>
        <label class="modal-toggle-switch">
          <input type="checkbox" id="editProductIsActive" name="isActive" checked onchange="toggleEditProductVisibilityLabel(this)">
          <span class="modal-toggle-slider"></span>
        </label>
      </div>

      <!-- Modal Footer Actions -->
      <div class="product-modal-actions">
        <button type="button" class="btn-modal-cancel" onclick="closeEditProductModal()">Cancel</button>
        <button type="submit" class="btn-modal-save" id="btnSaveEditProduct">Save Changes</button>
      </div>

    </form>
  </div>
</div>
