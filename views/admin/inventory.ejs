<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Inventory Management · Voltiq Admin Portal' %>
  </title>
  <link rel="stylesheet" href="/css/admin/inventory.css">
  <link rel="stylesheet" href="/css/admin/add-product-modal.css">
  <link rel="stylesheet" href="/css/admin/delete-category-modal.css">
  <link rel="stylesheet" href="/css/admin/inactive-category-modal.css">
  <!-- Cropper.js CSS CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
</head>

<body>

  <div class="admin-layout">

    <!-- ================= SIDEBAR ================= -->
    <aside class="admin-sidebar">
      <a href="/admin/dashboard" class="brand-wrapper">
        <div class="brand-logo-text">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          voltiq
        </div>
        <span class="brand-subtitle">Admin Portal</span>
      </a>

      <nav class="sidebar-nav">
        <!-- Dashboard -->
        <a href="/admin/dashboard" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </span>
            Dashboard
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>

        <!-- Sub Nav Items -->
        <div class="sub-nav">
          <a href="/admin/overview" class="sub-nav-item">Overview</a>
          <a href="/admin/sales" class="sub-nav-item">Sales Performance</a>
        </div>

        <!-- Inventory (ACTIVE) -->
        <a href="/admin/inventory" class="nav-item active">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                </path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </span>
            Inventory
          </div>
        </a>

        <!-- Categories -->
        <a href="/admin/categories" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
              </svg>
            </span>
            Categories
          </div>
        </a>

        <!-- Orders -->
        <a href="/admin/orders" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </span>
            Orders
          </div>
        </a>

        <!-- Customers -->
        <a href="/admin/customers" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            Customers
          </div>
        </a>

        <!-- Promotions -->
        <a href="/admin/promotions" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </span>
            Promotions
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>

        <!-- Brand Management -->
        <a href="/admin/brands" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            Brand Management
          </div>
        </a>
      </nav>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="admin-main">

              <!-- TOP HEADER BAR (SEARCH BAR MATCHING CATEGORIES PAGE) -->
              <header class="top-header">
                <h2 class="header-title-text">Inventory</h2>

                <div class="header-search">
                  <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  </svg>

                  <input type="text" id="searchInput" class="search-input" placeholder="Search products..."
                    value="<%= search || '' %>" onkeydown="handleSearch(event)">

                  <% if (search) { %>
                    <button type="button" class="search-clear" onclick="clearSearch()">
                      ×
                    </button>
                    <% } %>
                </div>

                <div class="header-right-actions">
                  <button class="icon-button" aria-label="Notifications">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                  </button>

                  <button class="icon-button" aria-label="User Account">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                      <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                  </button>
                </div>
              </header>

              <!-- PAGE CONTENT -->
              <main class="page-content">

                <!-- Page Heading Bar -->
                <div class="page-heading-bar">
                  <div class="heading-title-group">
                    <h1>Product Catalog</h1>
                    <p>Manage your global inventory and stock levels across regions.</p>
                  </div>

                  <div class="heading-actions-group">
                    <button type="button" class="btn-export-csv" onclick="exportCSV()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                      Export CSV
                    </button>

                    <button type="button" class="btn-add-product" onclick="openAddProductModal()">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                      </svg>
                      Add New Product
                    </button>
                  </div>
                </div>

                <!-- Metrics Cards Grid (4 Stat Cards) -->
                <div class="metrics-grid-4">

                  <!-- Card 1: Total Products -->
                  <div class="stat-card">
                    <div class="stat-header">
                      <div class="stat-icon-wrapper purple">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path
                            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                          </path>
                        </svg>
                      </div>
                      <!-- <span class="stat-badge-green">+2.4%</span> -->
                    </div>
                    <div class="stat-body">
                      <span class="stat-label">Total Products</span>
                      <span class="stat-value">
                        <%= totalProducts %>
                      </span>
                    </div>
                  </div>

                  <!-- Card 2: Categories -->
                  <div class="stat-card">
                    <div class="stat-header">
                      <div class="stat-icon-wrapper gray">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                        </svg>
                      </div>
                    </div>
                    <div class="stat-body">
                      <span class="stat-label">Categories</span>
                      <span class="stat-value">
                        <%= categories.length %>
                      </span>
                    </div>
                  </div>

                  <!-- Card 3: Low Stock Items -->
                  <div class="stat-card">
                    <div class="stat-header">
                      <div class="stat-icon-wrapper orange">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path
                            d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z">
                          </path>
                          <line x1="12" y1="9" x2="12" y2="13"></line>
                          <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                      </div>
                    </div>
                    <div class="stat-body">
                      <span class="stat-label">Low Stock Items</span>
                      <span class="stat-value orange">
                        <%= lowStockCount %>
                      </span>
                    </div>
                  </div>

                  <!-- Card 4: Out of Stock -->
                  <div class="stat-card">
                    <div class="stat-header">
                      <div class="stat-icon-wrapper red">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                        </svg>
                      </div>
                    </div>
                    <div class="stat-body">
                      <span class="stat-label">Out of Stock</span>
                      <span class="stat-value red">
                        <%= outOfStockCount %>
                      </span>
                    </div>
                  </div>

                </div>

                <!-- Product Table Card -->
                <div class="table-card">

                  <!-- Table Controls Toolbar -->
                  <div class="filter-toolbar">
                    <div class="filter-left-controls">
                      <select class="filter-select" id="categoryFilter" onchange="applyFilters()">
                        <option value="all" <%=categoryFilter==='all' ? 'selected' : '' %>>All Categories</option>

                        <% categories.forEach(category=> { %>
                          <option value="<%= category._id %>" <%=categoryFilter===category._id.toString() ? 'selected'
                            : '' %>>
                            <%= category.categoryName %>
                          </option>
                          <% }) %>
                      </select>

                      <select class="filter-select" id="statusFilter" onchange="applyFilters()">
                        <option value="all" <%=statusFilter==='all' ? 'selected' : '' %>>All Status</option>
                        <option value="In Stock" <%=statusFilter==='In Stock' ? 'selected' : '' %>>In Stock</option>
                        <option value="Low Stock" <%=statusFilter==='Low Stock' ? 'selected' : '' %>>Low Stock</option>
                        <option value="Out of Stock" <%=statusFilter==='Out of Stock' ? 'selected' : '' %>>Out of Stock
                        </option>
                      </select>

                      <!-- <button type="button" class="btn-filter-more">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                More Filters
              </button> -->
                    </div>

                    <span class="showing-count-label" id="showingCountLabel">SHOWING <%= products.length %> OF <%=
                          totalItems %>
                          ITEMS</span>
                  </div>

                  <!-- Table Responsive Container -->
                  <div class="table-responsive">
                    <table class="inventory-table" id="inventoryTable">
                      <thead>
                        <tr>
                          <th>Product Name</th>
                          <!-- <th>Description</th> -->
                          <th>Category</th>
                          <th>Stock</th>
                          <th>Price</th>
                          <th>Status</th>
                          <th>Visibility</th>
                          <th class="text-right">Actions</th>
                        </tr>
                      </thead>
                      <tbody id="inventoryTableBody">

                        <% products.forEach(item=> { %>

                          <% const product=item.product; const variant=item.variant; %>

                            <tr data-product-id="<%= product._id %>"
                              data-category="<%= product.categoryId ? (product.categoryId.categoryName || product.categoryId) : 'Smartphones' %>"
                              data-status="<%= variant.stock === 0 ? 'Out of Stock' : (variant.stock < 10 ? 'Low Stock' : 'In Stock') %>">
                              <td>
                                <div class="product-cell">
                                  <div class="product-thumb-box">
                                    <img src="<%= variant.imgUrls[0] %>" alt="<%= product.name %>"
                                      class="product-thumb-img">
                                  </div>
                                  <div>
                                    <span class="product-title-text">
                                      <%= product.name %>
                                    </span>
                                    <span class="product-sub-text">
                                      <%= variant.color %>, <%= variant.storage %>
                                    </span>
                                  </div>
                                </div>
                              </td>
                              <!-- <td><span class="sku-text">
                          <%= product.description %>
                        </span></td> -->
                              <td><span class="category-pill">
                                  <%= product.categoryId.categoryName %>
                                </span></td>
                              <td>
                                <div class="stock-cell">
                                  <span class="stock-text">
                                    <%= variant.stock %>
                                  </span>
                                </div>
                              </td>
                              <td><span class="price-text">₹<%= variant.price.toLocaleString('en-IN') %></span></td>
                              <td>
                                <span class="status-dot"></span>
                                <% if (variant.stock===0) { %>
                                  <span class="status-badge-pill out-of-stock">
                                    <span class="status-dot"></span>
                                    <%= 'Out of Stock' %>
                                  </span>
                                  <% } else if (variant.stock < 10) { %>
                                    <span class="status-badge-pill low-stock">
                                      <span class="status-dot"></span>
                                      <%= 'Low Stock' %>
                                    </span>
                                    <% } else { %>
                                      <span class="status-badge-pill in-stock">
                                        <span class="status-dot"></span>
                                        <%= 'In Stock' %>
                                      </span>
                                      <% } %>
                              </td>
                              <td>
                                <label class="toggle-switch">
                                  <input type="checkbox" <%=product.isActive ? 'checked' : '' %>
                                  onchange="handleVisibilityToggleProduct(this, '<%= product._id %>', '<%= product.name
                                      %>')">
                                      <span class="slider"></span>
                                </label>
                              </td>
                              <td class="text-right">
                                <div class="actions-cell">
                                  <button type="button" class="action-icon-btn edit" title="Edit Product"
                                    data-product-id="<%= product._id %>" data-variant-id="<%= variant._id %>"
                                    onclick="openEditProductModal(this)">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                      stroke-width="2">
                                      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                  </button>
                                  <button type="button" class="action-icon-btn delete" title="Delete Product"
                                    onclick="deleteProductRow(this, '<%= product._id %>')">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                      stroke-width="2">
                                      <polyline points="3 6 5 6 21 6"></polyline>
                                      <path
                                        d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                      </path>
                                    </svg>
                                  </button>
                                </div>
                              </td>
                            </tr>

                            <% }) %>

                      </tbody>
                    </table>
                  </div>

                  <!-- Pagination Bar -->
                  <div class="pagination-bar">
                    <span class="pagination-text">
                      Page <%= currentPage %> of <%= totalPages %>
                    </span>
                    <div class="pagination-controls">
                      <!-- Previous -->
                      <button type="button" class="page-btn" <%=currentPage===1 ? 'disabled' : '' %>
                        <% if (currentPage> 1) { %>
                          onclick="window.location.href='/admin/products?page=<%= currentPage - 1 %>'"
                            <% } %>
                              >
                              &lt;
                      </button>
                      <!-- Page Numbers -->
                      <% for (let i=1; i <=totalPages; i++) { %>
                        <button type="button" class="page-btn <%= currentPage === i ? 'active' : '' %>"
                          onclick="window.location.href='/admin/products?page=<%= i %>'">
                          <%= i %>
                        </button>
                        <% } %>
                          <!-- Next -->
                          <button type="button" class="page-btn" <%=currentPage===totalPages ? 'disabled' : '' %>
                            onclick="window.location.href='/admin/products?page=<%= currentPage + 1 %>'"
                              >
                              &gt;
                          </button>
                    </div>
                  </div>

                </div>

              </main>

              <!-- ADMIN FOOTER -->
              <footer class="admin-footer">
                <div>© <%= new Date().getFullYear() %> Voltiq Global Electronics Admin. All rights reserved.</div>
              </footer>

    </div>
  </div>

  <!-- ================= REUSABLE ADD PRODUCT MODAL PARTIAL ================= -->
  <%- include('partials/add-product-modal.ejs') %>

    <!-- ================= REUSABLE EDIT PRODUCT MODAL PARTIAL ================= -->
    <%- include('partials/edit-product-modal.ejs') %>

      <!-- ================= REUSABLE DELETE PRODUCT MODAL PARTIAL ================= -->
      <%- include('partials/delete-product-modal.ejs') %>

        <!-- ================= REUSABLE INACTIVE PRODUCT MODAL PARTIAL ================= -->
        <%- include('partials/inactive-product-modal.ejs') %>

          <!-- INTERACTIVE CLIENT SCRIPT -->
          <script>
            const allProducts = <%- JSON.stringify(allProducts) %>;
          </script>
          <script>
            let pendingDeleteProductRow = null;
            let pendingDeleteProductId = null;

            let pendingInactiveProductCheckbox = null;
            let pendingInactiveProductId = null;

            function filterInventoryTable() {
              const searchVal = document.getElementById('searchInput').value.toLowerCase();
              const catVal = document.getElementById('categoryFilter').value;
              const statusVal = document.getElementById('statusFilter').value;

              const rows = document.querySelectorAll('#inventoryTableBody tr');
              let visibleCount = 0;

              rows.forEach(row => {
                const title = row.querySelector('.product-title-text').textContent.toLowerCase();
                const sku = row.querySelector('.sku-text').textContent.toLowerCase();
                const cat = row.getAttribute('data-category');
                const status = row.getAttribute('data-status');

                const matchesSearch = title.includes(searchVal) || sku.includes(searchVal);
                const matchesCat = (catVal === 'all' || cat === catVal);
                const matchesStatus = (statusVal === 'all' || status === statusVal);

                if (matchesSearch && matchesCat && matchesStatus) {
                  row.style.display = '';
                  visibleCount++;
                } else {
                  row.style.display = 'none';
                }
              });

              document.getElementById('showingCountLabel').textContent = `SHOWING ${visibleCount} OF 1,240 ITEMS`;
            }


            function handleSearch(event) {
              if (event.key === 'Enter') {
                const search = document
                  .getElementById('searchInput')
                  .value
                  .trim();

                if (search) {
                  window.location.href =
                    `/admin/products?search=${encodeURIComponent(search)}`;
                } else {
                  window.location.href = '/admin/products';
                }
              }
            }


            function clearSearch() {
              window.location.href = '/admin/products';
            }


            function applyFilters() {
              const category = document.getElementById('categoryFilter').value;

              const status = document.getElementById('statusFilter').value;

              const search = document.getElementById('searchInput').value.trim();

              const params = new URLSearchParams();

              if (search) {
                params.set('search', search);
              }

              if (category !== 'all') {
                params.set('category', category);
              }

              if (status !== 'all') {
                params.set('status', status);
              }

              window.location.href =
                `/admin/products?${params.toString()}`;
            }


            // Confirm Delete Product Modal Handlers
            function deleteProductRow(btn, productId) {
              pendingDeleteProductRow = btn.closest('tr');
              pendingDeleteProductId = productId;

              const prodName = pendingDeleteProductRow.querySelector('.product-title-text')?.textContent.trim() || 'Product';
              const prodImg = pendingDeleteProductRow.querySelector('.product-thumb-img');
              const prodImgSrc = prodImg ? prodImg.src : '/images/avatar.jpg';

              document.getElementById('deleteProductName').textContent = `"${prodName}"`;
              document.getElementById('deleteProductCardTitle').textContent = prodName;
              document.getElementById('deleteProductCardSubtext').textContent = 'This product and all its variants will be permanently deleted.';
              document.getElementById('deleteProductImg').src = prodImgSrc;

              const backdrop = document.getElementById('deleteProductModalBackdrop');
              backdrop.classList.remove('hidden');
              document.body.style.overflow = 'hidden';
            }

            function closeDeleteProductModal() {
              const backdrop = document.getElementById('deleteProductModalBackdrop');
              backdrop.classList.add('hidden');
              document.body.style.overflow = '';
              pendingDeleteProductRow = null;
              pendingDeleteProductId = null;
            }

            function handleDeleteProductBackdropClick(event) {
              if (event.target === document.getElementById('deleteProductModalBackdrop')) {
                closeDeleteProductModal();
              }
            }

            async function makePendingProductInactive() {
              if (!pendingDeleteProductId) return;

              const productId = pendingDeleteProductId;

              const row = pendingDeleteProductRow;

              const checkbox = row?.querySelector('.toggle-switch input');

              if (!checkbox) return;

              closeDeleteProductModal();

              // The checkbox is currently ON.
              // toggleProductStatus will turn the product OFF.

              await toggleProductStatus(productId, checkbox);
            }

