<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Inventory Management · Voltiq Admin Portal' %></title>
  <link rel="stylesheet" href="/css/admin/inventory.css">
  <link rel="stylesheet" href="/css/admin/add-product-modal.css">
  <link rel="stylesheet" href="/css/admin/delete-category-modal.css">
  <link rel="stylesheet" href="/css/admin/inactive-category-modal.css">
</head>
<body>

  <div class="admin-layout">

    <!-- ================= SIDEBAR ================= -->
    <aside class="admin-sidebar">
      <a href="/admin/dashboard" class="brand-wrapper">
        <div class="brand-logo-text">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          voltiq
        </div>
        <span class="brand-subtitle">Admin Portal</span>
      </a>

      <nav class="sidebar-nav">
        <!-- Dashboard -->
        <a href="/admin/dashboard" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </span>
            Dashboard
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>

        <!-- Sub Nav Items -->
        <div class="sub-nav">
          <a href="/admin/overview" class="sub-nav-item">Overview</a>
          <a href="/admin/sales" class="sub-nav-item">Sales Performance</a>
        </div>

        <!-- Inventory (ACTIVE) -->
        <a href="/admin/inventory" class="nav-item active">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </span>
            Inventory
          </div>
        </a>

        <!-- Categories -->
        <a href="/admin/categories" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
              </svg>
            </span>
            Categories
          </div>
        </a>

        <!-- Orders -->
        <a href="/admin/orders" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </span>
            Orders
          </div>
        </a>

        <!-- Customers -->
        <a href="/admin/customers" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            Customers
          </div>
        </a>

        <!-- Promotions -->
        <a href="/admin/promotions" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </span>
            Promotions
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>

        <!-- Brand Management -->
        <a href="/admin/brands" class="nav-item">
          <div class="nav-item-content">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            Brand Management
          </div>
        </a>
      </nav>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="admin-main">
      
      <!-- TOP HEADER BAR (SEARCH BAR MATCHING CATEGORIES PAGE) -->
      <header class="top-header">
        <h2 class="header-title-text">Inventory</h2>

        <div class="header-search">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="searchInput" class="search-input" placeholder="Search products, SKUs, or categories..." onkeyup="filterInventoryTable()">
        </div>

        <div class="header-right-actions">
          <button class="icon-button" aria-label="Notifications">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
          </button>

          <button class="icon-button" aria-label="User Account">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </button>
        </div>
      </header>

      <!-- PAGE CONTENT -->
      <main class="page-content">
        
        <!-- Page Heading Bar -->
        <div class="page-heading-bar">
          <div class="heading-title-group">
            <h1>Product Catalog</h1>
            <p>Manage your global inventory and stock levels across regions.</p>
          </div>

          <div class="heading-actions-group">
            <button type="button" class="btn-export-csv" onclick="exportCSV()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Export CSV
            </button>

            <button type="button" class="btn-add-product" onclick="openAddProductModal()">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Add New Product
            </button>
          </div>
        </div>

        <!-- Metrics Cards Grid (4 Stat Cards) -->
        <div class="metrics-grid-4">
          
          <!-- Card 1: Total Products -->
          <div class="stat-card">
            <div class="stat-header">
              <div class="stat-icon-wrapper purple">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                </svg>
              </div>
              <span class="stat-badge-green">+2.4%</span>
            </div>
            <div class="stat-body">
              <span class="stat-label">Total Products</span>
              <span class="stat-value">1,240</span>
            </div>
          </div>

          <!-- Card 2: Categories -->
          <div class="stat-card">
            <div class="stat-header">
              <div class="stat-icon-wrapper gray">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
                </svg>
              </div>
            </div>
            <div class="stat-body">
              <span class="stat-label">Categories</span>
              <span class="stat-value">12</span>
            </div>
          </div>

          <!-- Card 3: Low Stock Items -->
          <div class="stat-card">
            <div class="stat-header">
              <div class="stat-icon-wrapper orange">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                  <line x1="12" y1="9" x2="12" y2="13"></line>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
              </div>
            </div>
            <div class="stat-body">
              <span class="stat-label">Low Stock Items</span>
              <span class="stat-value orange">45</span>
            </div>
          </div>

          <!-- Card 4: Out of Stock -->
          <div class="stat-card">
            <div class="stat-header">
              <div class="stat-icon-wrapper red">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
              </div>
            </div>
            <div class="stat-body">
              <span class="stat-label">Out of Stock</span>
              <span class="stat-value red">8</span>
            </div>
          </div>

        </div>

        <!-- Product Table Card -->
        <div class="table-card">
          
          <!-- Table Controls Toolbar -->
          <div class="filter-toolbar">
            <div class="filter-left-controls">
              <select class="filter-select" id="categoryFilter" onchange="filterInventoryTable()">
                <option value="all" selected>All Categories</option>
                <option value="Smartphones">Smartphones</option>
                <option value="Laptops">Laptops</option>
                <option value="Wearables">Wearables</option>
                <option value="Cameras">Cameras</option>
              </select>

              <select class="filter-select" id="statusFilter" onchange="filterInventoryTable()">
                <option value="all" selected>All Status</option>
                <option value="In Stock">In Stock</option>
                <option value="Low Stock">Low Stock</option>
                <option value="Out of Stock">Out of Stock</option>
              </select>

              <button type="button" class="btn-filter-more">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                </svg>
                More Filters
              </button>
            </div>

            <span class="showing-count-label" id="showingCountLabel">SHOWING 5 OF 1,240 ITEMS</span>
          </div>

          <!-- Table Responsive Container -->
          <div class="table-responsive">
            <table class="inventory-table" id="inventoryTable">
              <thead>
                <tr>
                  <th>Product Name</th>
                  <th>SKU</th>
                  <th>Category</th>
                  <th>Stock</th>
                  <th>Price</th>
                  <th>Status</th>
                  <th>Visibility</th>
                  <th class="text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="inventoryTableBody">
                
                <!-- Row 1: iPhone 17 Pro Max -->
                <tr data-category="Smartphones" data-status="In Stock">
                  <td>
                    <div class="product-cell">
                      <div class="product-thumb-box">
                        <img src="/images/avatar.jpg" alt="iPhone 17 Pro Max" class="product-thumb-img">
                      </div>
                      <div>
                        <span class="product-title-text">iPhone 17 Pro Max</span>
                        <span class="product-sub-text">Titanium Silver, 256GB</span>
                      </div>
                    </div>
                  </td>
                  <td><span class="sku-text">IPH-17PM-SLV</span></td>
                  <td><span class="category-pill">Smartphones</span></td>
                  <td>
                    <div class="stock-cell">
                      <span class="stock-text">420 <span style="font-weight: 500; color: #718096;">84% Left</span></span>
                      <div class="stock-progress-bg">
                        <div class="stock-progress-fill purple" style="width: 84%;"></div>
                      </div>
                    </div>
                  </td>
                  <td><span class="price-text">₹1,59,900</span></td>
                  <td>
                    <span class="status-badge-pill in-stock">
                      <span class="status-dot"></span> In Stock
                    </span>
                  </td>
                  <td>
                    <label class="toggle-switch">
                      <input type="checkbox" checked onchange="handleVisibilityToggleProduct(this, 'iPhone 17 Pro Max')">
                      <span class="slider"></span>
                    </label>
                  </td>
                  <td class="text-right">
                    <div class="actions-cell">
                      <button type="button" class="action-icon-btn edit" title="Edit Product" onclick="openEditProductModal(this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                      </button>
                      <button type="button" class="action-icon-btn delete" title="Delete Product" onclick="deleteProductRow(this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- Row 2: MacBook Air M5 -->
                <tr data-category="Laptops" data-status="Low Stock">
                  <td>
                    <div class="product-cell">
                      <div class="product-thumb-box">
                        <img src="/images/avatar.jpg" alt="MacBook Air M5" class="product-thumb-img">
                      </div>
                      <div>
                        <span class="product-title-text">MacBook Air M5</span>
                        <span class="product-sub-text">Midnight, 16GB RAM</span>
                      </div>
                    </div>
                  </td>
                  <td><span class="sku-text">MBA-M5-MID</span></td>
                  <td><span class="category-pill">Laptops</span></td>
                  <td>
                    <div class="stock-cell">
                      <span class="stock-text">12 <span style="font-weight: 500; color: #718096;">15% Left</span></span>
                      <div class="stock-progress-bg">
                        <div class="stock-progress-fill orange" style="width: 15%;"></div>
                      </div>
                    </div>
                  </td>
                  <td><span class="price-text">₹1,24,900</span></td>
                  <td>
                    <span class="status-badge-pill low-stock">
                      <span class="status-dot"></span> Low Stock
                    </span>
                  </td>
                  <td>
                    <label class="toggle-switch">
                      <input type="checkbox" checked onchange="handleVisibilityToggleProduct(this, 'MacBook Air M5')">
                      <span class="slider"></span>
                    </label>
                  </td>
                  <td class="text-right">
                    <div class="actions-cell">
                      <button type="button" class="action-icon-btn edit" title="Edit Product" onclick="openEditProductModal(this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                      </button>
                      <button type="button" class="action-icon-btn delete" title="Delete Product" onclick="deleteProductRow(this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- Row 3: Apple Watch Ultra 2 -->
                <tr data-category="Wearables" data-status="Out of Stock">
                  <td>
                    <div class="product-cell">
                      <div class="product-thumb-box">
                        <img src="/images/avatar.jpg" alt="Apple Watch Ultra 2" class="product-thumb-img">
                      </div>
                      <div>
                        <span class="product-title-text">Apple Watch Ultra 2</span>
                        <span class="product-sub-text">Titanium, Ocean Band</span>
                      </div>
                    </div>
                  </td>
                  <td><span class="sku-text">AWU-2-TIT</span></td>
                  <td><span class="category-pill">Wearables</span></td>
                  <td>
                    <div class="stock-cell">
                      <span class="stock-text">0 <span style="font-weight: 500; color: #718096;">0% Left</span></span>
                      <div class="stock-progress-bg">
                        <div class="stock-progress-fill red" style="width: 0%;"></div>
                      </div>
                    </div>
                  </td>
                  <td><span class="price-text">₹89,900</span></td>
                  <td>
                    <span class="status-badge-pill out-stock">
                      <span class="status-dot"></span> Out of Stock
                    </span>
                  </td>
                  <td>
                    <label class="toggle-switch">
                      <input type="checkbox" onchange="handleVisibilityToggleProduct(this, 'Apple Watch Ultra 2')">
                      <span class="slider"></span>
                    </label>
                  </td>
                  <td class="text-right">
                    <div class="actions-cell">
                      <button type="button" class="action-icon-btn edit" title="Edit Product" onclick="openEditProductModal(this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                      </button>
                      <button type="button" class="action-icon-btn delete" title="Delete Product" onclick="deleteProductRow(this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- Row 4: iPad Pro M4 -->
                <tr data-category="Laptops" data-status="In Stock">
                  <td>
                    <div class="product-cell">
                      <div class="product-thumb-box">
                        <img src="/images/avatar.jpg" alt="iPad Pro M4" class="product-thumb-img">
                      </div>
                      <div>
                        <span class="product-title-text">iPad Pro M4</span>
                        <span class="product-sub-text">13-inch, Space Black</span>
                      </div>
                    </div>
                  </td>
                  <td><span class="sku-text">IPAD-M4-13</span></td>
                  <td><span class="category-pill">Laptops</span></td>
                  <td>
                    <div class="stock-cell">
                      <span class="stock-text">156 <span style="font-weight: 500; color: #718096;">60% Left</span></span>
                      <div class="stock-progress-bg">
                        <div class="stock-progress-fill purple" style="width: 60%;"></div>
                      </div>
                    </div>
                  </td>
                  <td><span class="price-text">₹1,29,900</span></td>
                  <td>
                    <span class="status-badge-pill in-stock">
                      <span class="status-dot"></span> In Stock
                    </span>
                  </td>
                  <td>
                    <label class="toggle-switch">
                      <input type="checkbox" checked>
                      <span class="slider"></span>
                    </label>
                  </td>
                  <td class="text-right">
                    <div class="actions-cell">
                      <button type="button" class="action-icon-btn edit" title="Edit Product" onclick="openEditProductModal(this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                      </button>
                      <button type="button" class="action-icon-btn delete" title="Delete Product" onclick="deleteProductRow(this)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                      </button>
                    </div>
                  </td>
                </tr>

                <!-- Row 5: Sony A7R V -->
                <tr data-category="Cameras" data-status="Low Stock">
                  <td>
                    <div class="product-cell">
                      <div class="product-thumb-box">
                        <img src="/images/avatar.jpg" alt="Sony A7R V" class="product-thumb-img">
                      </div>
                      <div>
                        <span class="product-title-text">Sony A7R V</span>
                        <span class="product-sub-text">Body Only, 61MP</span>
                      </div>
                    </div>
                  </td>
                  <td><span class="sku-text">SONY-A7RV</span></td>
                  <td><span class="category-pill">Cameras</span></td>
                  <td>
                    <div class="stock-cell">
                      <span class="stock-text">4 <span style="font-weight: 500; color: #718096;">5% Left</span></span>
