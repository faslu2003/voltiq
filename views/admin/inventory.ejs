            }

            function setCropRatio(ratio, btn) {
              if (!cropperInstance) return;
              cropperInstance.setAspectRatio(ratio);
              document.querySelectorAll('.cropper-toolbar .tool-btn').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
            }

            function rotateCropper(degree) {
              if (cropperInstance) cropperInstance.rotate(degree);
            }

            function zoomCropper(ratio) {
              if (cropperInstance) cropperInstance.zoom(ratio);
            }

            function applyCroppedImage() {
              if (!cropperInstance || !activeCroppingImgElem) return;

              const targetW = parseInt(document.getElementById('cropWidthInput').value) || 800;
              const targetH = parseInt(document.getElementById('cropHeightInput').value) || 800;

              const canvas = cropperInstance.getCroppedCanvas({
                width: targetW,
                height: targetH,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high'
              });

              if (!canvas) return;

              canvas.toBlob((blob) => {
                if (!blob) {
                  return;
                }

                // Create a new File from the cropped image
                const croppedFile = new File(
                  [blob],
                  `cropped-${Date.now()}.jpg`,
                  {
                    type: 'image/jpeg',
                    lastModified: Date.now()
                  }
                );

                if (activeCroppingInput) {
                  // Replace the original file in the input
                  const dataTransfer = new DataTransfer();
                  const files = Array.from(activeCroppingInput.files);
                  files[activeCroppingFileIndex] = croppedFile;
                  files.forEach(file => {
                    dataTransfer.items.add(file);
                  });

                  activeCroppingInput.files = dataTransfer.files;
                }
                else if (activeCroppingExistingUrl) {

                  const replacementInput =
                    document.getElementById('replacedProductImagesInput');

                  const dataTransfer = new DataTransfer();

                  // Keep previously cropped existing images
                  Array.from(replacementInput.files).forEach(file => {
                    dataTransfer.items.add(file);
                  });

                  // Add the newly cropped existing image
                  dataTransfer.items.add(croppedFile);

                  replacementInput.files = dataTransfer.files;

                  // Store information about which existing image this replaces
                  const replacementInfoInput =
                    document.getElementById('replacedProductImages');

                  const replacements =
                    replacementInfoInput.value
                      ? JSON.parse(replacementInfoInput.value)
                      : [];

                  replacements.push({
                    oldUrl: activeCroppingExistingUrl,
                    fileIndex: replacementInput.files.length - 1
                  });

                  replacementInfoInput.value =
                    JSON.stringify(replacements);

                  console.log("Replacement added:", {
                    oldUrl: activeCroppingExistingUrl,
                    croppedFile
                  });
                }

                // Update preview
                activeCroppingImgElem.src = URL.createObjectURL(croppedFile);
                closeCropModal();
              }, 'image/jpeg', 0.92);
            }

