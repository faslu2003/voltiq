                document.getElementById("editVariantsContainer");

              variantsContainer.innerHTML = "";

              editVariantCardCount = 0;

              if (Array.isArray(formData.variants)) {

                formData.variants.forEach((variant) => {

                  addEditVariantRow({
                    _id: variant.variantId || "",
                    color: variant.color || "",
                    storage: variant.storage || "",
                    stock: variant.stock ?? "",
                    price: variant.price ?? "",
                    imgUrls: []
                  });

                });
              }


              // -------------------------
              // Open modal
              // -------------------------

              const backdrop =
                document.getElementById("editProductModalBackdrop");

              backdrop.classList.remove("hidden");

              document.body.style.overflow = "hidden";
            }


            function removeExistingVariantImage(button, imageUrl, variantId) {

              // Remove the preview from the screen
              button.closest('.variant-thumb-card').remove();

              // Get the hidden input
              const removedInput =
                document.getElementById('removedVariantImages');

              // Get existing removed images
              const removedImages =
                removedInput.value
                  ? JSON.parse(removedInput.value)
                  : [];

              const alreadyRemoved = removedImages.some(item =>
                item.variantId === variantId &&
                item.imageUrl === imageUrl
              );

              if (!alreadyRemoved) {
                removedImages.push({
                  variantId: variantId,
                  imageUrl: imageUrl
                });
              }

              // Store it in the hidden input
              removedInput.value =
                JSON.stringify(removedImages);
            }


            function closeEditProductModal() {
              const backdrop = document.getElementById('editProductModalBackdrop');
              backdrop.classList.add('hidden');
              document.body.style.overflow = '';
              window._editingProductRow = null;
            }

            function handleEditProductBackdropClick(event) {
              if (event.target === document.getElementById('editProductModalBackdrop')) {
                closeEditProductModal();
              }
            }

            function toggleEditProductVisibilityLabel(checkbox) {
              const textElem = document.getElementById('editProductVisibilityText');
              if (checkbox.checked) {
                textElem.textContent = 'Show this product on the public storefront';
                textElem.style.color = '#6B7280';
              } else {
                textElem.textContent = 'Inactive (Hidden from public storefront)';
                textElem.style.color = '#D97706';
              }
            }

            // Image Upload Handlers (Edit modal)
            function handleEditProductFilesSelect(event) {
              const files = event.target.files;
              if (files && files.length > 0) displayEditProductPreviews(files);
            }

            function handleEditProductDragOver(event) {
              event.preventDefault();
              event.stopPropagation();
              document.getElementById('editProductDropzone').classList.add('dragover');
            }

            function handleEditProductDragLeave(event) {
              event.preventDefault();
              event.stopPropagation();
              document.getElementById('editProductDropzone').classList.remove('dragover');
            }

            function handleEditProductFileDrop(event) {
              event.preventDefault();
              event.stopPropagation();
              document.getElementById('editProductDropzone').classList.remove('dragover');

              const files = event.dataTransfer.files;
              if (files && files.length > 0) {
                document.getElementById('editProductImagesInput').files = files;
                displayEditProductPreviews(files);
              }
            }

            let editVariantCardCount = 0;

            function displayEditProductPreviews(files) {
              const grid = document.getElementById('editProductPreviewGrid');

              Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (e) {
                  const card = document.createElement('div');
                  card.className = 'preview-thumb-card';

                  card.dataset.fileIndex = index;

                  card.innerHTML = `
                    <img src="${e.target.result}" alt="Main Gallery Image">
                    <div class="thumb-action-overlay">
                      <button type="button" class="thumb-crop-btn" onclick="event.stopPropagation(); openCropModal(this.closest('.preview-thumb-card').querySelector('img'))">✂️ Crop</button>
                      <button type="button" class="thumb-remove-btn" onclick="event.stopPropagation(); this.closest('.preview-thumb-card').remove(); checkEmptyEditPreviews();">✕</button>
                    </div>
                  `;
                  grid.appendChild(card);
                };
                reader.readAsDataURL(file);
              });

              grid.classList.remove('hidden');
            }

            function checkEmptyEditPreviews() {
              const grid = document.getElementById('editProductPreviewGrid');
              if (grid.children.length === 0) {
                grid.classList.add('hidden');
              }
            }

            // Dynamic Variant Rows (Edit modal)
            function addEditVariantRow(data = {}) {
              const vIdx = editVariantCardCount;
              editVariantCardCount++;
              const container = document.getElementById('editVariantsContainer');
              const card = document.createElement('div');
              card.className = 'variant-card-box';
              card.id = `editVariantBox_${vIdx}`;

              const color = data.color || '';
              const storage = data.storage || '';
              const stock = (data.stock !== undefined && data.stock !== null) ? data.stock : '';
              const price = data.price || 0;
              const variantImages = data.variantImages || data.imgUrls || (data.imgUrl ? [data.imgUrl] : []);

              card.innerHTML = `
                <!-- 5-Column Inputs Grid (Color, Storage, Stock [Readonly], Price, Remove) -->
                <input type="hidden" name="variants[${vIdx}][variantId]" value="${data._id || ''}">
                <div class="variant-inputs-grid">
                  <div class="form-field-group">
                    <label class="field-label-sm">Color</label>
                    <input type="text" name="variants[${vIdx}][color]" class="field-input-sm" value="${color}" placeholder="Lavender">
                  </div>
                  <div class="form-field-group">
                    <label class="field-label-sm">Storage</label>
                    <input type="text" name="variants[${vIdx}][storage]" class="field-input-sm" value="${storage}" placeholder="256GB">
                  </div>
                  <div class="form-field-group">
                    <label class="field-label-sm">Stock Quantity</label>
                    <input type="number" name="variants[${vIdx}][stock]" class="field-input-sm stock-input" value="${stock}" placeholder="50">
                  </div>
                  <div class="form-field-group">
                    <label class="field-label-sm">Price (₹)</label>
                    <input type="number" name="variants[${vIdx}][price]" class="field-input-sm" value="${price}" placeholder="0.00" step="1">
                  </div>
                  <button type="button" class="btn-remove-variant" title="Remove Variant" onclick="removeEditVariantCard(${vIdx})">✕</button>
                </div>

                <!-- Variant Multiple Images Gallery Upload Box -->
                <div class="variant-image-section">
                  <div class="variant-image-header">
                    <span class="variant-image-label">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                      Variant Gallery Images
                    </span>
                    <label for="editVariantFileInput_${vIdx}" class="btn-upload-variant-imgs">
                      📷 + Add Variant Images
                    </label>
                    <input type="file" id="editVariantFileInput_${vIdx}" name="variantImages_${vIdx}[]" accept="image/*" multiple class="hidden-file-input" onchange="handleEditVariantFilesSelect(this, ${vIdx})">
                  </div>
                  <div class="variant-preview-grid ${variantImages.length === 0 ? 'hidden' : ''}" id="editVariantPreviewGrid_${vIdx}"></div>
                </div>
              `;
              container.appendChild(card);

              if (variantImages && variantImages.length > 0) {
                const grid = document.getElementById(`editVariantPreviewGrid_${vIdx}`);
                variantImages.forEach(imgSrc => {
                  const thumbCard = document.createElement('div');
                  thumbCard.className = 'variant-thumb-card';
                  thumbCard.innerHTML = `
                    <img src="${imgSrc}" alt="Variant Image">
                    <div class="thumb-action-overlay">
                      <button type="button" class="thumb-crop-btn"
    onclick="openCropModal(
        this.closest('.variant-thumb-card').querySelector('img'),
        document.getElementById('editVariantFileInput_${vIdx}'),
        null,
        '${imgSrc}',
        '${data._id}'
    )"
    title="Crop & Resize">
    ✂️
</button>
                      <button type="button" class="thumb-remove-btn" onclick="removeExistingVariantImage(this, '${imgSrc}', '${data._id}'); checkEmptyEditVariantGrid(${vIdx});" title="Remove"> ✕ </button>                    </div>
                  `;
                  grid.appendChild(thumbCard);
                });
              }
            }

            function removeEditVariantCard(vIdx) {
              const card = document.getElementById(`editVariantBox_${vIdx}`);
              if (card) card.remove();
            }

            function handleEditVariantFilesSelect(fileInput, vIdx) {
              const newFiles = Array.from(fileInput.files);

              if (newFiles.length === 0) return;

              const existingFiles = fileInput._selectedFiles || [];
              const allFiles = [...existingFiles, ...newFiles];
              fileInput._selectedFiles = allFiles;
              const dataTransfer = new DataTransfer();

              allFiles.forEach(file => {
                dataTransfer.items.add(file);
              });

              fileInput.files = dataTransfer.files;
              const grid = document.getElementById(
                `editVariantPreviewGrid_${vIdx}`
              );

              newFiles.forEach((file, fileIndex) => {

                const actualFileIndex =
                  existingFiles.length + fileIndex;
                const reader = new FileReader();
                reader.onload = function (e) {

                  const thumbCard =
                    document.createElement('div');
                  thumbCard.className =
                    'variant-thumb-card';
                  thumbCard.dataset.fileIndex =
                    actualFileIndex;
                  thumbCard.innerHTML = `
                <img
                    src="${e.target.result}"
                    alt="Variant Image">
                <div class="thumb-action-overlay">
                    <button
                        type="button"
                        class="thumb-crop-btn"
                        onclick="
                            openCropModal(
                                this.closest('.variant-thumb-card').querySelector('img'),
                                document.getElementById('${fileInput.id}'),
                                ${actualFileIndex}
                            )
                        "
                        title="Crop & Resize">
                        ✂️
                    </button>
                    <button
                        type="button"
                        class="thumb-remove-btn"
                        onclick="removeEditVariantFile(this, ${vIdx})"
                        title="Remove">
                        ✕
                    </button>
                </div>
            `;
                  grid.appendChild(thumbCard);
                };
                reader.readAsDataURL(file);
              });

              grid.classList.remove('hidden');
            }


            function removeEditVariantFile(button, vIdx) {

              const thumbCard = button.closest('.variant-thumb-card');

              const fileIndex =
                Number(thumbCard.dataset.fileIndex);

              const fileInput =
                document.getElementById(`editVariantFileInput_${vIdx}`);

              fileInput._selectedFiles.splice(fileIndex, 1);

              const dataTransfer = new DataTransfer();

              fileInput._selectedFiles.forEach(file => {
                dataTransfer.items.add(file);
              });

              fileInput.files = dataTransfer.files;

              thumbCard.remove();

              const remainingCards = document.querySelectorAll(
                `#editVariantPreviewGrid_${vIdx} .variant-thumb-card`
              );

              remainingCards.forEach((card, index) => {
                card.dataset.fileIndex = index;
              });

              checkEmptyEditVariantGrid(vIdx);
            }


            function checkEmptyEditVariantGrid(vIdx) {
              const grid = document.getElementById(`editVariantPreviewGrid_${vIdx}`);
              if (grid && grid.children.length === 0) {
                grid.classList.add('hidden');
              }
            }

            // Dynamic Highlight Bullet Rows (Edit modal)
            function addEditHighlightRow() {
              const container = document.getElementById('editHighlightsContainer');
              const row = document.createElement('div');
              row.className = 'highlight-row-input';
              row.innerHTML = `
        <span class="highlight-bullet">•</span>
        <input type="text" name="highlights[]" class="field-input" placeholder="e.g. All-day battery life with fast charging support">
        <button type="button" class="btn-remove-highlight" onclick="removeEditHighlightRow(this)">✕</button>
      `;
              container.appendChild(row);
            }

            function removeEditHighlightRow(btn) {
              const rows = document.querySelectorAll('#editHighlightsContainer .highlight-row-input');
              if (rows.length > 1) {
                btn.closest('.highlight-row-input').remove();
              } else {
                btn.closest('.highlight-row-input').querySelector('input').value = '';
              }
            }

          </script>

          <script>
            const formData = <%- JSON.stringify(formData || null) %>;
            const formType = <%- JSON.stringify(formType || null) %>;
          </script>

          <!-- Cropper.js Script CDN -->
          <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
</body>

</html>