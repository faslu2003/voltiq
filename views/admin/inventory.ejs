              }
            }

            // Image Upload Handlers (Edit modal)
            function handleEditProductFilesSelect(event) {
              const files = event.target.files;
              if (files && files.length > 0) displayEditProductPreviews(files);
            }

            function handleEditProductDragOver(event) {
              event.preventDefault();
              event.stopPropagation();
              document.getElementById('editProductDropzone').classList.add('dragover');
            }

            function handleEditProductDragLeave(event) {
              event.preventDefault();
              event.stopPropagation();
              document.getElementById('editProductDropzone').classList.remove('dragover');
            }

            function handleEditProductFileDrop(event) {
              event.preventDefault();
              event.stopPropagation();
              document.getElementById('editProductDropzone').classList.remove('dragover');

              const files = event.dataTransfer.files;
              if (files && files.length > 0) {
                document.getElementById('editProductImagesInput').files = files;
                displayEditProductPreviews(files);
              }
            }

            let editVariantCardCount = 0;

            function displayEditProductPreviews(files) {
              const grid = document.getElementById('editProductPreviewGrid');

              Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (e) {
                  const card = document.createElement('div');
                  card.className = 'preview-thumb-card';

                  card.dataset.fileIndex = index;

                  card.innerHTML = `
                    <img src="${e.target.result}" alt="Main Gallery Image">
                    <div class="thumb-action-overlay">
                      <button type="button" class="thumb-crop-btn" onclick="event.stopPropagation(); openCropModal(this.closest('.preview-thumb-card').querySelector('img'))">✂️ Crop</button>
                      <button type="button" class="thumb-remove-btn" onclick="event.stopPropagation(); this.closest('.preview-thumb-card').remove(); checkEmptyEditPreviews();">✕</button>
                    </div>
                  `;
                  grid.appendChild(card);
                };
                reader.readAsDataURL(file);
              });

              grid.classList.remove('hidden');
            }

            function checkEmptyEditPreviews() {
              const grid = document.getElementById('editProductPreviewGrid');
              if (grid.children.length === 0) {
                grid.classList.add('hidden');
              }
            }

            // Dynamic Variant Rows (Edit modal)
            function addEditVariantRow(data = {}) {
              editVariantCardCount++;
              const vIdx = editVariantCardCount;
              const container = document.getElementById('editVariantsContainer');
              const card = document.createElement('div');
              card.className = 'variant-card-box';
              card.id = `editVariantBox_${vIdx}`;

              const color = data.color || '';
              const storage = data.storage || '256GB';
              const stock = (data.stock !== undefined && data.stock !== null) ? data.stock : 50;
              const additionalPrice = data.additionalPrice || 0;
              const variantImages = data.variantImages || data.imgUrls || (data.imgUrl ? [data.imgUrl] : []);

              card.innerHTML = `voltiq> db.products.find()
[
  {
    _id: ObjectId('6aa537c6a2a170216f8376ce'),
    name: 'iPhone 17',
    description: 'iPhone 17_description',
    imgUrls: [ '/uploads/2931b6f7-18f0-4f44-998b-26fa54eab5b8-17-1.webp' ],
    basePrice: 79900,
    highlights: [ 'highlight1', 'highlight2', 'highlight3' ],
    isActive: false,
    categoryId: ObjectId('6a9fb4a614359025028735ce'),
    variants: [
      {
        color: 'Purple',
        storage: '256GB',
        additionalPrice: 0,
        stock: 70,
        imgUrls: [
          '/uploads/13718d7a-df4d-4dd3-8630-ca7564e71403-17-2.webp',
          '/uploads/4fd93ef7-a422-4578-9b90-47e5851bb24d-17-3.webp'
        ],
        _id: ObjectId('6aa537c6a2a170216f8376cf')
      }
    ],
    createdAt: ISODate('2026-09-12T11:30:14.150Z'),
    updatedAt: ISODate('2026-09-15T03:15:36.661Z'),
    __v: 0
  }
]
voltiq> 
                <!-- 5-Column Inputs Grid (Color, Storage, Stock [Readonly], Price, Remove) -->
                <div class="variant-inputs-grid">
                  <div class="form-field-group">
                    <label class="field-label-sm">Color</label>
                    <input type="text" name="color" class="field-input-sm" value="${color}" placeholder="Lilac">
                  </div>
                  <div class="form-field-group">
                    <label class="field-label-sm">Storage</label>
                    <input type="text" name="storage" class="field-input-sm" value="${storage}" placeholder="256GB">
                  </div>
                  <div class="form-field-group">
                    <label class="field-label-sm">Stock Quantity</label>
                    <input type="number" name="stock" class="field-input-sm stock-input readonly-stock" value="${stock}" readonly placeholder="50" min="0">
                  </div>
                  <div class="form-field-group">
                    <label class="field-label-sm">Addl. Price (₹)</label>
                    <input type="number" name="additionalPrice" class="field-input-sm" value="${additionalPrice}" placeholder="0.00" step="0.01">
                  </div>
                  <button type="button" class="btn-remove-variant" title="Remove Variant" onclick="removeEditVariantCard(${vIdx})">✕</button>
                </div>

                <!-- Variant Multiple Images Gallery Upload Box -->
                <div class="variant-image-section">
                  <div class="variant-image-header">
                    <span class="variant-image-label">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                      Variant Gallery Images
                    </span>
                    <label for="editVariantFileInput_${vIdx}" class="btn-upload-variant-imgs">
                      📷 + Add Variant Images
                    </label>
                    <input type="file" id="editVariantFileInput_${vIdx}" name="variantImages" accept="image/*" multiple class="hidden-file-input" onchange="handleEditVariantFilesSelect(this, ${vIdx})">
                  </div>
                  <div class="variant-preview-grid ${variantImages.length === 0 ? 'hidden' : ''}" id="editVariantPreviewGrid_${vIdx}"></div>
                </div>
              `;
              container.appendChild(card);

              if (variantImages && variantImages.length > 0) {
                const grid = document.getElementById(`editVariantPreviewGrid_${vIdx}`);
                variantImages.forEach(imgSrc => {
                  const thumbCard = document.createElement('div');
                  thumbCard.className = 'variant-thumb-card';
                  thumbCard.innerHTML = `
                    <img src="${imgSrc}" alt="Variant Image">
                    <div class="thumb-action-overlay">
                      <button type="button" class="thumb-crop-btn" onclick="openCropModal(this.closest('.variant-thumb-card').querySelector('img'))" title="Crop & Resize">✂️</button>
                      <button type="button" class="thumb-remove-btn" onclick="removeExistingVariantImage(this, '${imgSrc}'); checkEmptyEditVariantGrid(${vIdx});" title="Remove"> ✕ </button>                    </div>
                  `;
                  grid.appendChild(thumbCard);
                });
              }
            }

            function removeEditVariantCard(vIdx) {
              const card = document.getElementById(`editVariantBox_${vIdx}`);
              if (card) card.remove();
            }

            function handleEditVariantFilesSelect(fileInput, vIdx) {
              const files = fileInput.files;
              if (!files || files.length === 0) return;

              const grid = document.getElementById(`editVariantPreviewGrid_${vIdx}`);

              Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (e) {
                  const thumbCard = document.createElement('div');
                  thumbCard.className = 'variant-thumb-card';
                  thumbCard.innerHTML = `
            <img src="${e.target.result}" alt="Variant Image">
            <div class="thumb-action-overlay">
              <button type="button" class="thumb-crop-btn" onclick="openCropModal(this.closest('.variant-thumb-card').querySelector('img'),document.getElementById('${fileInput.id}'),${index})" title="Crop & Resize">✂️</button>
              <button type="button" class="thumb-remove-btn" onclick="this.closest('.variant-thumb-card').remove(); checkEmptyEditVariantGrid(${vIdx});" title="Remove">✕</button>
            </div>
          `;
                  grid.appendChild(thumbCard);
                };
                reader.readAsDataURL(file);
              });

              grid.classList.remove('hidden');
            }

            function checkEmptyEditVariantGrid(vIdx) {
              const grid = document.getElementById(`editVariantPreviewGrid_${vIdx}`);
              if (grid && grid.children.length === 0) {
                grid.classList.add('hidden');
              }
            }

            // Dynamic Highlight Bullet Rows (Edit modal)
            function addEditHighlightRow() {
              const container = document.getElementById('editHighlightsContainer');
              const row = document.createElement('div');
              row.className = 'highlight-row-input';
              row.innerHTML = `
        <span class="highlight-bullet">•</span>
        <input type="text" name="highlights[]" class="field-input" placeholder="e.g. All-day battery life with fast charging support">
        <button type="button" class="btn-remove-highlight" onclick="removeEditHighlightRow(this)">✕</button>
      `;
              container.appendChild(row);
            }

            function removeEditHighlightRow(btn) {
              const rows = document.querySelectorAll('#editHighlightsContainer .highlight-row-input');
              if (rows.length > 1) {
                btn.closest('.highlight-row-input').remove();
              } else {
                btn.closest('.highlight-row-input').querySelector('input').value = '';
              }
            }

          </script>

          <!-- Cropper.js Script CDN -->
          <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
</body>

</html>