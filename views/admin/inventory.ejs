  <!-- ================= REUSABLE INACTIVE PRODUCT MODAL PARTIAL ================= -->
  <%- include('partials/inactive-product-modal.ejs') %>

  <!-- INTERACTIVE CLIENT SCRIPT -->
  <script>
    let pendingDeleteProductRow = null;
    let pendingInactiveProductCheckbox = null;

    function filterInventoryTable() {
      const searchVal = document.getElementById('searchInput').value.toLowerCase();
      const catVal = document.getElementById('categoryFilter').value;
      const statusVal = document.getElementById('statusFilter').value;

      const rows = document.querySelectorAll('#inventoryTableBody tr');
      let visibleCount = 0;

      rows.forEach(row => {
        const title = row.querySelector('.product-title-text').textContent.toLowerCase();
        const sku = row.querySelector('.sku-text').textContent.toLowerCase();
        const cat = row.getAttribute('data-category');
        const status = row.getAttribute('data-status');

        const matchesSearch = title.includes(searchVal) || sku.includes(searchVal);
        const matchesCat = (catVal === 'all' || cat === catVal);
        const matchesStatus = (statusVal === 'all' || status === statusVal);

        if (matchesSearch && matchesCat && matchesStatus) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      document.getElementById('showingCountLabel').textContent = `SHOWING ${visibleCount} OF 1,240 ITEMS`;
    }

    // Confirm Delete Product Modal Handlers
    function deleteProductRow(btn) {
      pendingDeleteProductRow = btn.closest('tr');
      const prodName = pendingDeleteProductRow.querySelector('.product-title-text').textContent.trim();
      const prodSku = pendingDeleteProductRow.querySelector('.sku-text').textContent.trim();
      const prodImgSrc = pendingDeleteProductRow.querySelector('.product-thumb-img').src;

      document.getElementById('deleteProductName').textContent = `"${prodName}"`;
      document.getElementById('deleteProductCardTitle').textContent = prodName;
      document.getElementById('deleteProductCardSubtext').textContent = `SKU: ${prodSku}`;
      document.getElementById('deleteProductImg').src = prodImgSrc;

      const backdrop = document.getElementById('deleteProductModalBackdrop');
      backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeDeleteProductModal() {
      const backdrop = document.getElementById('deleteProductModalBackdrop');
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
      pendingDeleteProductRow = null;
    }

    function handleDeleteProductBackdropClick(event) {
      if (event.target === document.getElementById('deleteProductModalBackdrop')) {
        closeDeleteProductModal();
      }
    }

    function makePendingProductInactive() {
      if (pendingDeleteProductRow) {
        const chk = pendingDeleteProductRow.querySelector('.toggle-switch input');
        if (chk) chk.checked = false;
        closeDeleteProductModal();
        filterInventoryTable();
      }
    }

    function confirmProductDelete() {
      if (pendingDeleteProductRow) {
        pendingDeleteProductRow.style.opacity = '0';
        pendingDeleteProductRow.style.transform = 'translateY(-10px)';
        setTimeout(() => {
          pendingDeleteProductRow.remove();
          filterInventoryTable();
          closeDeleteProductModal();
        }, 150);
      }
    }

    // Confirm Inactive Product Modal Handlers
    function handleVisibilityToggleProduct(checkbox, productName) {
      if (!checkbox.checked) {
        // User turned switch OFF -> Revert switch state temporarily and show confirm inactive modal
        checkbox.checked = true;
        pendingInactiveProductCheckbox = checkbox;

        const row = checkbox.closest('tr');
        const prodSku = row.querySelector('.sku-text').textContent.trim();
        const prodImgSrc = row.querySelector('.product-thumb-img').src;

        document.getElementById('inactiveProductName').textContent = `"${productName}"`;
        document.getElementById('inactiveProductCardTitle').textContent = productName;
        document.getElementById('inactiveProductCardSubtext').textContent = `SKU: ${prodSku}`;
        document.getElementById('inactiveProductImg').src = prodImgSrc;

        const backdrop = document.getElementById('inactiveProductModalBackdrop');
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }

    function cancelProductInactive() {
      const backdrop = document.getElementById('inactiveProductModalBackdrop');
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
      pendingInactiveProductCheckbox = null;
    }

    function handleInactiveProductBackdropClick(event) {
      if (event.target === document.getElementById('inactiveProductModalBackdrop')) {
        cancelProductInactive();
      }
    }

    function confirmProductInactive() {
      if (pendingInactiveProductCheckbox) {
        pendingInactiveProductCheckbox.checked = false;
        cancelProductInactive();
        filterInventoryTable();
      }
    }

    function exportCSV() {
      alert('Exporting inventory product catalog to CSV...');
    }

    // ================= PRODUCT MODAL CONTROLLER =================

    function openAddProductModal() {
      document.getElementById('addProductForm').reset();
      document.getElementById('productPreviewGrid').innerHTML = '';
      document.getElementById('productPreviewGrid').classList.add('hidden');
      document.getElementById('productUploadContent').classList.remove('hidden');
      document.getElementById('productVisibilityText').textContent = 'Show this product on the public storefront';

      const backdrop = document.getElementById('productModalBackdrop');
      backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeProductModal() {
      const backdrop = document.getElementById('productModalBackdrop');
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function handleProductBackdropClick(event) {
      if (event.target === document.getElementById('productModalBackdrop')) {
        closeProductModal();
      }
    }

    function toggleProductVisibilityLabel(checkbox) {
      const textElem = document.getElementById('productVisibilityText');
      if (checkbox.checked) {
        textElem.textContent = 'Show this product on the public storefront';
        textElem.style.color = '#6B7280';
      } else {
        textElem.textContent = 'Inactive (Hidden from public storefront)';
        textElem.style.color = '#D97706';
      }
    }

    // Image Upload Handlers
    function triggerProductFileInput(event) {
      if (event && (event.target.tagName === 'INPUT' || event.target.closest('.thumb-remove-btn'))) return;
      document.getElementById('productImagesInput').click();
    }

    function handleProductFilesSelect(event) {
      const files = event.target.files;
      if (files && files.length > 0) displayProductPreviews(files);
    }

    function handleProductDragOver(event) {
      event.preventDefault();
      event.stopPropagation();
      document.getElementById('productDropzone').classList.add('dragover');
    }

    function handleProductDragLeave(event) {
      event.preventDefault();
      event.stopPropagation();
      document.getElementById('productDropzone').classList.remove('dragover');
    }

    function handleProductFileDrop(event) {
      event.preventDefault();
      event.stopPropagation();
      document.getElementById('productDropzone').classList.remove('dragover');
      
      const files = event.dataTransfer.files;
      if (files && files.length > 0) {
        document.getElementById('productImagesInput').files = files;
        displayProductPreviews(files);
      }
    }

    function displayProductPreviews(files) {
      const grid = document.getElementById('productPreviewGrid');

      Array.from(files).forEach((file, idx) => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const card = document.createElement('div');
          card.className = 'preview-thumb-card';
          card.innerHTML = `
            <img src="${e.target.result}" alt="Preview ${idx + 1}">
            <button type="button" class="thumb-remove-btn" title="Remove" onclick="event.stopPropagation(); this.parentElement.remove(); checkEmptyPreviews();">✕</button>
          `;
          grid.appendChild(card);
        };
        reader.readAsDataURL(file);
      });

      grid.classList.remove('hidden');
    }

    function checkEmptyPreviews() {
      const grid = document.getElementById('productPreviewGrid');
      if (grid.children.length === 0) {
        grid.classList.add('hidden');
      }
    }

    // Dynamic Variant Rows
    function addVariantRow() {
      const container = document.getElementById('variantsContainer');
      const rowCard = document.createElement('div');
      rowCard.className = 'variant-row-card';
      rowCard.innerHTML = `
        <div class="form-field-group">
          <label class="field-label-sm">Variant Name</label>
          <input type="text" name="variantName[]" class="field-input-sm" placeholder="e.g. Space Black, 512GB">
        </div>
        <div class="form-field-group">
          <label class="field-label-sm">Color</label>
          <input type="text" name="variantColor[]" class="field-input-sm" placeholder="Black">
        </div>
        <div class="form-field-group">
          <label class="field-label-sm">Storage</label>
          <input type="text" name="variantStorage[]" class="field-input-sm" placeholder="512GB">
        </div>
        <div class="form-field-group">
          <label class="field-label-sm">Addl. Price</label>
          <input type="number" name="variantAddlPrice[]" class="field-input-sm" placeholder="0.00" step="0.01">
        </div>
        <button type="button" class="variant-cam-btn" title="Remove Variant" onclick="this.closest('.variant-row-card').remove()" style="color: #EF4444; border-color: #FECACA;">
          ✕
        </button>
      `;
      container.appendChild(rowCard);
    }

    // Dynamic Highlight Bullet Rows
    function addHighlightRow() {
      const container = document.getElementById('highlightsContainer');
      const row = document.createElement('div');
      row.className = 'highlight-row-input';
      row.innerHTML = `
        <span class="highlight-bullet">•</span>
        <input type="text" name="highlights[]" class="field-input" placeholder="e.g. All-day battery life with fast charging support">
        <button type="button" class="btn-remove-highlight" onclick="removeHighlightRow(this)">✕</button>
      `;
      container.appendChild(row);
    }

    function removeHighlightRow(btn) {
      const rows = document.querySelectorAll('.highlight-row-input');
      if (rows.length > 1) {
        btn.closest('.highlight-row-input').remove();
      } else {
        btn.closest('.highlight-row-input').querySelector('input').value = '';
      }
    }

    // Handle Form Submit
    function handleProductSubmit(event) {
      event.preventDefault();
      const name = document.getElementById('productName').value.trim();
      const category = document.getElementById('productCategoryId').value;
      const brand = document.getElementById('productBrandId').value;
      const price = document.getElementById('productPrice').value;
      const isActive = document.getElementById('productIsActive').checked;
      
      const firstPreview = document.querySelector('.preview-thumb-card img');
      const previewSrc = firstPreview ? firstPreview.src : '/images/avatar.jpg';

      if (!name || !category || !price) return;

      const formattedPrice = '₹' + parseFloat(price).toLocaleString('en-IN');
      const generatedSku = (brand.substring(0, 3) + '-' + name.replace(/[^a-zA-Z0-9]/g, '').substring(0, 6)).toUpperCase();

      const tbody = document.getElementById('inventoryTableBody');
      const newRowHtml = `
        <tr data-category="${category}" data-status="In Stock">
          <td>
            <div class="product-cell">
              <div class="product-thumb-box">
                <img src="${previewSrc}" alt="${name}" class="product-thumb-img">
              </div>
              <div>
                <span class="product-title-text">${name}</span>
                <span class="product-sub-text">${brand} Official SKU</span>
              </div>
            </div>
          </td>
          <td><span class="sku-text">${generatedSku}</span></td>
          <td><span class="category-pill">${category}</span></td>
          <td>
            <div class="stock-cell">
              <span class="stock-text">100 <span style="font-weight: 500; color: #718096;">100% Left</span></span>
              <div class="stock-progress-bg">
                <div class="stock-progress-fill purple" style="width: 100%;"></div>
              </div>
            </div>
          </td>
          <td><span class="price-text">${formattedPrice}</span></td>
          <td>
            <span class="status-badge-pill in-stock">
              <span class="status-dot"></span> In Stock
            </span>
          </td>
          <td>
            <label class="toggle-switch">
              <input type="checkbox" ${isActive ? 'checked' : ''}>
              <span class="slider"></span>
            </label>
          </td>
          <td class="text-right">
            <div class="actions-cell">
              <button type="button" class="action-icon-btn edit" title="Edit Product">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              </button>
              <button type="button" class="action-icon-btn delete" title="Delete Product" onclick="deleteProductRow(this)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
              </button>
            </div>
          </td>
        </tr>
      `;

      tbody.insertAdjacentHTML('afterbegin', newRowHtml);
      closeProductModal();
      filterInventoryTable();
    }

    // ================= EDIT PRODUCT MODAL CONTROLLER =================

    function openEditProductModal(btn) {
      const row = btn.closest('tr');

      // NOTE: the table row only carries name, SKU, category, price, image
      // & visibility. Brand, description, variants, and highlights aren't
      // part of the row's visible data yet, so those fields start blank
      // below. Once a real backend exists (GET /admin/products/:id),
      // replace this block with a fetch() call that returns the full
      // product record and populates every field from it instead.

      const name = row.querySelector('.product-title-text').textContent.trim();
      const sku = row.querySelector('.sku-text').textContent.trim();
      const category = row.getAttribute('data-category');
      const priceText = row.querySelector('.price-text').textContent.trim();
      const priceNumeric = priceText.replace(/[^0-9.]/g, '');
      const imgSrc = row.querySelector('.product-thumb-img').src;
      const imgAlt = row.querySelector('.product-thumb-img').alt;
      const isActive = row.querySelector('.toggle-switch input').checked;

      document.getElementById('editProductId').value = sku;
      document.getElementById('editProductName').value = name;
      document.getElementById('editProductCategoryId').value = category;
      document.getElementById('editProductBrandId').value = '';
      document.getElementById('editProductPrice').value = priceNumeric;
      document.getElementById('editProductDescription').value = '';

      // Preload the existing image as the current preview
      const grid = document.getElementById('editProductPreviewGrid');
      grid.innerHTML = `
        <div class="preview-thumb-card">
          <img src="${imgSrc}" alt="${imgAlt}">
          <button type="button" class="thumb-remove-btn" title="Remove" onclick="event.stopPropagation(); this.parentElement.remove(); checkEmptyEditPreviews();">✕</button>
        </div>
      `;
      grid.classList.remove('hidden');
      document.getElementById('editProductUploadContent').classList.add('hidden');

      // Reset variants to a single blank row
      document.getElementById('editVariantsContainer').innerHTML = `
        <div class="variant-row-card">
          <div class="form-field-group">
            <label class="field-label-sm">Variant Name</label>
            <input type="text" name="variantName[]" class="field-input-sm" placeholder="e.g. Midnight, 256GB">
          </div>
          <div class="form-field-group">
            <label class="field-label-sm">Color</label>
            <input type="text" name="variantColor[]" class="field-input-sm" placeholder="Lilac">
          </div>
          <div class="form-field-group">
            <label class="field-label-sm">Storage</label>
            <input type="text" name="variantStorage[]" class="field-input-sm" placeholder="256GB">
          </div>
          <div class="form-field-group">
            <label class="field-label-sm">Addl. Price</label>
            <input type="number" name="variantAddlPrice[]" class="field-input-sm" placeholder="0.00" step="0.01">
          </div>
          <label class="variant-cam-btn" title="Attach Variant Image">
            <input type="file" name="variantImage[]" accept="image/*" class="hidden-file-input" onchange="handleVariantImageSelect(this)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </label>
        </div>
      `;

      // Reset highlights to a single blank row
      document.getElementById('editHighlightsContainer').innerHTML = `
        <div class="highlight-row-input">
          <span class="highlight-bullet">•</span>
          <input type="text" name="highlights[]" class="field-input" placeholder="e.g. Ceramic Shield front glass, 4x stronger drop performance" required>
          <button type="button" class="btn-remove-highlight" onclick="removeEditHighlightRow(this)">✕</button>
        </div>
      `;

      document.getElementById('editProductIsActive').checked = isActive;
      toggleEditProductVisibilityLabel(document.getElementById('editProductIsActive'));

      // Remember which row we're editing so submit can update it in place
      window._editingProductRow = row;

      const backdrop = document.getElementById('editProductModalBackdrop');
      backdrop.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeEditProductModal() {
      const backdrop = document.getElementById('editProductModalBackdrop');
      backdrop.classList.add('hidden');
      document.body.style.overflow = '';
      window._editingProductRow = null;
    }

    function handleEditProductBackdropClick(event) {
      if (event.target === document.getElementById('editProductModalBackdrop')) {
        closeEditProductModal();
      }
    }

    function toggleEditProductVisibilityLabel(checkbox) {
      const textElem = document.getElementById('editProductVisibilityText');
      if (checkbox.checked) {
        textElem.textContent = 'Show this product on the public storefront';
        textElem.style.color = '#6B7280';
      } else {
        textElem.textContent = 'Inactive (Hidden from public storefront)';
        textElem.style.color = '#D97706';
      }
    }

    // Image Upload Handlers (Edit modal)
    function handleEditProductFilesSelect(event) {
      const files = event.target.files;
      if (files && files.length > 0) displayEditProductPreviews(files);
    }

    function handleEditProductDragOver(event) {
      event.preventDefault();
      event.stopPropagation();
      document.getElementById('editProductDropzone').classList.add('dragover');
    }

    function handleEditProductDragLeave(event) {
      event.preventDefault();
      event.stopPropagation();
      document.getElementById('editProductDropzone').classList.remove('dragover');
    }

    function handleEditProductFileDrop(event) {
      event.preventDefault();
      event.stopPropagation();
      document.getElementById('editProductDropzone').classList.remove('dragover');

      const files = event.dataTransfer.files;
      if (files && files.length > 0) {
        document.getElementById('editProductImagesInput').files = files;
        displayEditProductPreviews(files);
      }
    }

    function displayEditProductPreviews(files) {
      const grid = document.getElementById('editProductPreviewGrid');

      Array.from(files).forEach((file, idx) => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const card = document.createElement('div');
          card.className = 'preview-thumb-card';
          card.innerHTML = `
            <img src="${e.target.result}" alt="Preview ${idx + 1}">
            <button type="button" class="thumb-remove-btn" title="Remove" onclick="event.stopPropagation(); this.parentElement.remove(); checkEmptyEditPreviews();">✕</button>
          `;
          grid.appendChild(card);
        };
        reader.readAsDataURL(file);
      });

      grid.classList.remove('hidden');
      document.getElementById('editProductUploadContent').classList.add('hidden');
    }

    function checkEmptyEditPreviews() {
      const grid = document.getElementById('editProductPreviewGrid');
      if (grid.children.length === 0) {
        grid.classList.add('hidden');
        document.getElementById('editProductUploadContent').classList.remove('hidden');
      }
    }

    // Dynamic Variant Rows (Edit modal)
    function addEditVariantRow() {
      const container = document.getElementById('editVariantsContainer');
      const rowCard = document.createElement('div');
      rowCard.className = 'variant-row-card';
      rowCard.innerHTML = `
        <div class="form-field-group">
          <label class="field-label-sm">Variant Name</label>
          <input type="text" name="variantName[]" class="field-input-sm" placeholder="e.g. Space Black, 512GB">
        </div>
        <div class="form-field-group">
          <label class="field-label-sm">Color</label>
          <input type="text" name="variantColor[]" class="field-input-sm" placeholder="Black">
        </div>
        <div class="form-field-group">
          <label class="field-label-sm">Storage</label>
          <input type="text" name="variantStorage[]" class="field-input-sm" placeholder="512GB">
        </div>
        <div class="form-field-group">
          <label class="field-label-sm">Addl. Price</label>
          <input type="number" name="variantAddlPrice[]" class="field-input-sm" placeholder="0.00" step="0.01">
        </div>
        <button type="button" class="variant-cam-btn" title="Remove Variant" onclick="this.closest('.variant-row-card').remove()" style="color: #EF4444; border-color: #FECACA;">
          ✕
        </button>
      `;
      container.appendChild(rowCard);
    }

    // Dynamic Highlight Bullet Rows (Edit modal)
    function addEditHighlightRow() {
      const container = document.getElementById('editHighlightsContainer');
      const row = document.createElement('div');
      row.className = 'highlight-row-input';
      row.innerHTML = `
        <span class="highlight-bullet">•</span>
        <input type="text" name="highlights[]" class="field-input" placeholder="e.g. All-day battery life with fast charging support">
        <button type="button" class="btn-remove-highlight" onclick="removeEditHighlightRow(this)">✕</button>
      `;
      container.appendChild(row);
    }

    function removeEditHighlightRow(btn) {
      const rows = document.querySelectorAll('#editHighlightsContainer .highlight-row-input');
      if (rows.length > 1) {
        btn.closest('.highlight-row-input').remove();
      } else {
        btn.closest('.highlight-row-input').querySelector('input').value = '';
      }
    }

    // Handle Edit Form Submit — updates the existing row in place
    function handleEditProductSubmit(event) {
      event.preventDefault();

      const row = window._editingProductRow;
      if (!row) return;

      const name = document.getElementById('editProductName').value.trim();
      const category = document.getElementById('editProductCategoryId').value;
      const brand = document.getElementById('editProductBrandId').value;
      const price = document.getElementById('editProductPrice').value;
      const isActive = document.getElementById('editProductIsActive').checked;

      const firstPreviewImg = document.querySelector('#editProductPreviewGrid .preview-thumb-card img');
      const previewSrc = firstPreviewImg ? firstPreviewImg.src : row.querySelector('.product-thumb-img').src;

      if (!name || !category || !price) return;

      const formattedPrice = '₹' + parseFloat(price).toLocaleString('en-IN');

      row.setAttribute('data-category', category);
      row.querySelector('.product-thumb-img').src = previewSrc;
      row.querySelector('.product-thumb-img').alt = name;
      row.querySelector('.product-title-text').textContent = name;
      if (brand) {
        row.querySelector('.product-sub-text').textContent = brand + ' Official SKU';
      }
      row.querySelector('.category-pill').textContent = category;
      row.querySelector('.price-text').textContent = formattedPrice;
      row.querySelector('.toggle-switch input').checked = isActive;

      closeEditProductModal();
      filterInventoryTable();
    }
  </script>

</body>
</html>
