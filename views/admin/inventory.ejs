            function openCropModal(imgElem, fileInput = null, fileIndex = null, existingUrl = null, variantId = null) {
              activeCroppingImgElem = imgElem;
              activeCroppingInput = fileInput;
              activeCroppingFileIndex = fileIndex;
              activeCroppingExistingUrl = existingUrl;
              activeCroppingVariantId = variantId;

              const targetImg = document.getElementById('cropperTargetImage');
              targetImg.src = imgElem.src;

              const cropBackdrop = document.getElementById('cropModalBackdrop');
              cropBackdrop.classList.remove('hidden');

              if (cropperInstance) cropperInstance.destroy();

              cropperInstance = new Cropper(targetImg, {
                aspectRatio: 1,
                viewMode: 1,
                autoCropArea: 0.9,
                responsive: true,
                background: false
              });
            }

            function closeCropModal() {
              const cropBackdrop = document.getElementById('cropModalBackdrop');
              cropBackdrop.classList.add('hidden');
              if (cropperInstance) {
                cropperInstance.destroy();
                cropperInstance = null;
              }
              activeCroppingImgElem = null;
            }

            function handleCropBackdropClick(event) {
              if (event.target === document.getElementById('cropModalBackdrop')) {
                closeCropModal();
              }
            }

            function setCropRatio(ratio, btn) {
              if (!cropperInstance) return;
              cropperInstance.setAspectRatio(ratio);
              document.querySelectorAll('.cropper-toolbar .tool-btn').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
            }

            function rotateCropper(degree) {
              if (cropperInstance) cropperInstance.rotate(degree);
            }

            function zoomCropper(ratio) {
              if (cropperInstance) cropperInstance.zoom(ratio);
            }

            function applyCroppedImage() {
              if (!cropperInstance || !activeCroppingImgElem) return;

              const targetW = parseInt(document.getElementById('cropWidthInput').value) || 800;
              const targetH = parseInt(document.getElementById('cropHeightInput').value) || 800;

              const canvas = cropperInstance.getCroppedCanvas({
                width: targetW,
                height: targetH,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high'
              });

              if (!canvas) return;

              canvas.toBlob((blob) => {
                if (!blob) {
                  return;
                }

                // Create a new File from the cropped image
                const croppedFile = new File(
                  [blob],
                  `cropped-${Date.now()}.jpg`,
                  {
                    type: 'image/jpeg',
                    lastModified: Date.now()
                  }
                );

                if (activeCroppingInput && activeCroppingFileIndex !== null && activeCroppingFileIndex !== undefined) {

                  const dataTransfer = new DataTransfer();

                  const files = Array.from(activeCroppingInput.files);

                  files[activeCroppingFileIndex] = croppedFile;

                  files.forEach(file => {
                    dataTransfer.items.add(file);
                  });

                  activeCroppingInput.files = dataTransfer.files;
                  activeCroppingInput._selectedFiles = Array.from(dataTransfer.files);
                }
                else if (
                  activeCroppingExistingUrl &&
                  activeCroppingInput &&
                  activeCroppingVariantId
                ) {

                  /*
                   * Remove the old image URL from the DB.
                   */

                  const removedInput = document.getElementById('removedVariantImages');

                  const removedImages =
                    removedInput.value
                      ? JSON.parse(removedInput.value)
                      : [];

                  const alreadyRemoved =
                    removedImages.some(item =>
                      item.variantId === activeCroppingVariantId &&
                      item.imageUrl === activeCroppingExistingUrl
                    );

                  if (!alreadyRemoved) {

                    removedImages.push({
                      variantId: activeCroppingVariantId,
                      imageUrl: activeCroppingExistingUrl
                    });

                    removedInput.value = JSON.stringify(removedImages);
                  }

                  /*
                   * Add the cropped image to the
                   * variant's upload input.
                   */

                  const existingFiles = activeCroppingInput._selectedFiles || [];

                  const allFiles = [...existingFiles, croppedFile];

                  activeCroppingInput._selectedFiles = allFiles;

                  const dataTransfer = new DataTransfer();

                  allFiles.forEach(file => {
                    dataTransfer.items.add(file);
                  });

                  activeCroppingInput.files = dataTransfer.files;
                }

                // Update preview
                activeCroppingImgElem.src = URL.createObjectURL(croppedFile);
                closeCropModal();
              }, 'image/jpeg', 0.92);
            }

