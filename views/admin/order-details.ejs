<% const currentOrderStatus=(typeof order !=='undefined' && order && order.orderStatus) ? order.orderStatus
  : 'Confirmed' ; const statusDefinitions={ 'Confirmed' : { label: 'Confirmed' , cssClass: 'status-badge-confirmed' ,
  next: [ { status: 'Processing' , label: 'Processing' ,
  desc: 'Items are being picked, packaged, and prepared for dispatch.' , badgeClass: 'status-badge-processing' }, {
  status: 'Cancelled' , label: 'Cancelled' , desc: 'Cancel the order before warehouse processing begins.' ,
  badgeClass: 'status-badge-cancelled' } ] }, 'Processing' : { label: 'Processing' , cssClass: 'status-badge-processing'
  , next: [ { status: 'Shipped' , label: 'Shipped' ,
  desc: 'Package has been dispatched and handed over to delivery partner.' , badgeClass: 'status-badge-shipped' }, {
  status: 'Cancelled' , label: 'Cancelled' , desc: 'Cancel the order before it leaves the warehouse facility.' ,
  badgeClass: 'status-badge-cancelled' } ] }, 'Shipped' : { label: 'Shipped' , cssClass: 'status-badge-shipped' , next:
  [ { status: 'Out for Delivery' , label: 'Out for Delivery' ,
  desc: 'Package has reached destination hub and is out with courier agent.' ,
  badgeClass: 'status-badge-out-for-delivery' }, { status: 'Delivered' , label: 'Delivered' ,
  desc: 'Package has been successfully handed over to customer.' , badgeClass: 'status-badge-delivered' } ]
  }, 'Out for Delivery' : { label: 'Out for Delivery' , cssClass: 'status-badge-out-for-delivery' , next: [ {
  status: 'Delivered' , label: 'Delivered' , desc: 'Package has been successfully handed over to customer.' ,
  badgeClass: 'status-badge-delivered' } ] }, 'Delivered' : { label: 'Delivered' , cssClass: 'status-badge-delivered' ,
  next: [] }, 'Cancelled' : { label: 'Cancelled' , cssClass: 'status-badge-cancelled' , next: [] } }; const
  currentStatusMeta=statusDefinitions[currentOrderStatus] || { label: currentOrderStatus,
  cssClass: 'status-badge-confirmed' , next: [] }; const allowedNextStatuses=currentStatusMeta.next || []; %>
  <!DOCTYPE html>
  <html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      <%= typeof title !=='undefined' ? title : `Order #${(typeof order !=='undefined' && order && order.orderId) ?
        order.orderId : 'VQ-90214' } · Voltiq Admin` %>
    </title>
    <link rel="stylesheet" href="/css/admin/order-details.css">
  </head>

  <body>

    <div class="admin-layout">

      <!-- ================= SIDEBAR ================= -->
      <aside class="admin-sidebar">
        <div class="sidebar-top-section">
          <a href="/admin/dashboard" class="brand-wrapper">
            <span class="brand-title">Voltiq Admin</span>
            <span class="brand-subtitle">Management Portal</span>
          </a>

          <nav class="sidebar-nav">
            <!-- Dashboard -->
            <a href="/admin/dashboard" class="nav-item">
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
              </span>
              <span>Dashboard</span>
            </a>

            <!-- Orders (ACTIVE) -->
            <a href="/admin/orders" class="nav-item active">
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
              </span>
              <span>Orders</span>
            </a>

            <!-- Inventory -->
            <a href="/admin/products" class="nav-item">
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path
                    d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                  </path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              </span>
              <span>Inventory</span>
            </a>

            <!-- Customers -->
            <a href="/admin/customers" class="nav-item">
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </span>
              <span>Customers</span>
            </a>

            <!-- Analytics -->
            <a href="/admin/sales" class="nav-item">
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
              </span>
              <span>Analytics</span>
            </a>

            <!-- Settings -->
            <a href="/admin/settings" class="nav-item">
              <span class="nav-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path
                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                  </path>
                </svg>
              </span>
              <span>Settings</span>
            </a>
          </nav>
        </div>

        <!-- Sidebar Bottom Profile / Support -->
        <div class="sidebar-bottom-section">
          <a href="/admin/support" class="sidebar-help-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
            <span>Support</span>
          </a>

          <div class="admin-profile-card">
            <div class="profile-left-info">
              <div class="profile-avatar-badge">VA</div>
              <div class="profile-text-names">
                <span class="admin-name">Admin User</span>
                <span class="signout-label">Sign out</span>
              </div>
            </div>

            <form action="/admin/logout" method="POST" style="margin: 0;">
              <button type="submit" class="signout-icon-btn" aria-label="Sign out">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                  <polyline points="16 17 21 12 16 7"></polyline>
                  <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
              </button>
            </form>
          </div>
        </div>
      </aside>

      <!-- ================= MAIN CONTENT ================= -->
      <div class="admin-main">

        <!-- TOP HEADER BAR WITH TABS -->
        <header class="top-header-bar">

          <div class="header-controls-right">
            <div class="header-search-box">
              <svg class="header-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="text" class="header-search-input" placeholder="Search orders..." aria-label="Search orders">
            </div>

            <button class="header-bell-btn" aria-label="Notifications">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </button>

          </div>
        </header>

        <!-- PAGE CONTENT WRAPPER -->
        <main class="page-content-wrapper">

          <!-- ORDER TITLE & ACTIONS ROW -->
          <div class="order-meta-summary-bar">
            <div class="order-title-group">
              <div class="order-title-row">
                <h1 class="order-code-heading">Order #<%= (typeof order !=='undefined' && order && order.orderId) ?
                    order.orderId : 'VQ-90214' %>
                </h1>
                <span class="order-status-badge <%= currentStatusMeta.cssClass %>">
                  <span class="status-bullet-dot"></span>
                  <span>
                    <%= currentOrderStatus %>
                  </span>
                </span>
                <button class="btn-update-status" type="button" onclick="openUpdateStatusModal()">Update Status</button>
              </div>
              <p class="order-placed-timestamp">
                Placed on <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short' , day: 'numeric' ,
                  year: 'numeric' , hour: 'numeric' , minute: 'numeric' , hour12: true }) %>
              </p>
            </div>

            <div class="order-action-buttons">
              <a href="#" class="btn-order-action">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download Invoice</span>
              </a>

              <a href="#" class="btn-order-action">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                  stroke-linejoin="round">
                  <polyline points="6 9 6 2 18 2 18 9"></polyline>
                  <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                  <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                <span>Print Label</span>
              </a>
            </div>
          </div>

          <!-- TWO COLUMN DETAILS GRID -->
          <div class="order-details-grid">

            <!-- LEFT COLUMN: ORDER ITEMS & TIMELINE -->
            <div class="left-details-column">

              <!-- 1. ORDER ITEMS CARD -->
              <div class="details-section-card">
                <div class="section-card-header">
                  <div class="card-header-left">
                    <svg class="header-icon-purple" viewBox="0 0 24 24" fill="none" stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                      <line x1="3" y1="6" x2="21" y2="6"></line>
                      <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                    <h2 class="card-heading-text">Order Items</h2>
                  </div>
                  <span class="items-count-badge">
                    <%= `${order.orderItems.length} Items` %>
                  </span>
                </div>

                <div class="order-items-stack">
                  <% order.orderItems.forEach(function(item) { %>
                    <div class="order-item-entry">
                      <div class="item-visual-and-info">
                        <div class="item-thumb-wrapper">
                          <img src="<%= item.imgUrl %>" alt="<%= item.productName %>" class="item-thumb-img">
                        </div>
                        <div class="item-text-column">
                          <h3 class="item-product-name">
                            <%= item.productName %>
                          </h3>
                          <span class="item-variant-label">
                            <%= `${item.color || '' }${item.storage ? ', ' + item.storage : '' }` %>
                          </span>
                        </div>
                      </div>

                      <div class="item-price-box">
                        <span class="item-qty-tag">Qty: <%= item.quantity %></span>
                        <span class="item-price-amount">₹<%= (item.orderedPrice * item.quantity).toLocaleString('en-IN')
                            %></span>
                      </div>
                    </div>
                    <% }); %>
                </div>
              </div>

              <div class="lavender-summary-card">
                <span class="widget-title-label">ORDER SUMMARY</span>

                <div class="summary-rows-stack">
                  <div class="summary-data-line">
                    <span class="summary-label">Subtotal</span>
                    <span class="summary-figure">₹<%= order.subtotal.toLocaleString('en-IN') %></span>
                  </div>

                  <div class="summary-data-line">
                    <span class="summary-label">Shipping</span>
                    <span class="summary-figure">
                      <%= order.shippingCharge> 0 ? '₹' + order.shippingCharge.toLocaleString('en-IN') : 'FREE' %>
                    </span>
                  </div>

                  <% if (order.payment.paymentMethod==="COD" ) { %>
                    <div class="summary-data-line">
                      <span class="summary-label">COD Charge</span>
                      <span class="summary-figure">
                        ₹<%= order.codCharge.toLocaleString('en-IN') %>
                      </span>
                    </div>
                    <% } %>

                      <% if (order.discountAmount && order.discountAmount> 0) { %>
                        <div class="summary-data-line">
                          <span class="summary-label">Discount</span>
                          <span class="summary-figure" style="color: #16A34A;">-₹<%=
                              order.discountAmount.toLocaleString('en-IN') %></span>
                        </div>
                        <% } %>
                </div>

                <hr class="summary-card-divider">

                <div class="summary-grand-total">
                  <span class="total-title-text">Total</span>
                  <span class="total-figure-text">₹<%= order.totalPrice.toLocaleString('en-IN') %></span>
                </div>

                <div class="security-seal-row">
                  <!-- <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                  stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <polyline points="9 12 11 14 15 10"></polyline>
                </svg> -->
                </div>
              </div>

              <!-- 2. ORDER TIMELINE CARD -->
              <!-- <div class="details-section-card">
              <div class="section-card-header">
                <div class="card-header-left">
                  <svg class="header-icon-purple" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="18" cy="18" r="3"></circle>
                    <circle cx="6" cy="6" r="3"></circle>
                    <path d="M13 6h3a2 2 0 0 1 2 2v7"></path>
                    <line x1="6" y1="9" x2="6" y2="21"></line>
                  </svg>
                  <h2 class="card-heading-text">Order Timeline</h2>
                </div>
              </div>

              <div class="timeline-track-container"> -->
              <!-- Step 1: Order Placed -->
              <!-- <div class="timeline-step-row">
                  <div class="timeline-node-marker">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <div class="timeline-card-box">
                    <h4 class="timeline-event-name">Order Placed</h4>
                    <span class="timeline-event-meta">October 24, 2023 • 02:45 PM</span>
                  </div>
                </div> -->

              <!-- Step 2: Payment Confirmed -->
              <!-- <div class="timeline-step-row">
                  <div class="timeline-node-marker">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <div class="timeline-card-box">
                    <h4 class="timeline-event-name">Payment Confirmed</h4>
                    <span class="timeline-event-meta">October 24, 2023 • 02:50 PM via UPI</span>
                  </div>
                </div> -->

              <!-- Step 3: Processing -->
              <!-- <div class="timeline-step-row">
                  <div class="timeline-node-marker current-processing">
                    <span class="marker-inner-dot"></span>
                  </div>
                  <div class="timeline-card-box">
                    <h4 class="timeline-event-name purple-title">Processing</h4>
                    <p class="timeline-event-desc">Items are being picked and packed in Warehouse #04.</p>
                    <a href="#" class="timeline-log-link">View Logistics Logs</a>
                  </div>
                </div>
              </div>
            </div> -->

            </div>

            <!-- RIGHT COLUMN: CUSTOMER, ADDRESS, PAYMENT, SUMMARY -->
            <div class="right-details-column">

              <!-- CARD 1: CUSTOMER INFORMATION -->
              <div class="info-widget-card customer-accent-card">
                <span class="widget-title-label">CUSTOMER INFORMATION</span>

                <div class="customer-profile-block">
                  <div class="customer-circle-avatar">
                    <%= order.shippingAddress.fullName.split(' ').map(function(n){return n[0]}).join('').toUpperCase().slice(0, 2) %>
                </div>
                <div class="customer-meta-group">
                  <h3 class="customer-full-name"><%= order.shippingAddress.fullName %></h3>
                </div>
              </div>

              <div class="customer-contact-box">
                <div class="contact-row">
                  <!-- <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg> -->
                  <!-- <span><%= (typeof order !== ' undefined' && order && order.userId && order.userId.email) ?
                      order.userId.email : 'rohan.a@gmail.com' %></span> -->
                  </div>

                  <div class="contact-row">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                      </path>
                    </svg>
                    <span>
                      <%= '+91 ' + order.shippingAddress.phoneNumber %>
                    </span>
                  </div>

                  <!-- <button class="btn-view-profile-history" type="button">View Profile History</button> -->
                </div>
              </div>

              <!-- CARD 2: SHIPPING ADDRESS -->
              <div class="info-widget-card">
                <div class="widget-header-with-edit">
                  <span class="widget-title-label">SHIPPING ADDRESS</span>
                  <button class="btn-edit-pencil" type="button" aria-label="Edit shipping address">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                    </svg>
                  </button>
                </div>

                <div class="shipping-location-row">
                  <svg class="location-marker-icon" viewBox="0 0 24 24" fill="none" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <div class="address-lines-block">
                    <span>
                      <%= order.shippingAddress.houseName %>
                    </span>
                    <span>
                      <%= order.shippingAddress.locality %>
                    </span>
                    <span>
                      <%= `${order.shippingAddress.city}, ${order.shippingAddress.state} -
                        ${order.shippingAddress.pincode}` %>
                    </span>
                  </div>
                </div>
              </div>

              <!-- CARD 3: PAYMENT -->
              <div class="info-widget-card">
                <span class="widget-title-label">PAYMENT</span>

                <div class="payment-info-row">
                  <div class="payment-method-details">
                    <!-- <span class="payment-badge-logo">UPI</span> -->
                    <div class="payment-text-group">
                      <span class="payment-name">
                        <%= `${order.payment.paymentMethod} Payment` %>
                      </span>
                      <span class="payment-account-id">
                        <!-- <%= (typeof order !== 'undefined' && order && order.payment && order.payment.transactionId) ? order.payment.transactionId : 'voltiq@axis' %> -->
                      </span>
                    </div>
                  </div>

                  <span class="payment-status-tag">
                    <%= order.payment.paymentStatus %>
                  </span>
                </div>
              </div>

              <!-- CARD 4: ORDER SUMMARY (LAVENDER CARD) -->

            </div>

          </div>

        </main>

      </div>

    </div>

    <!-- ================= UPDATE STATUS MODAL ================= -->
    <div id="updateStatusModalOverlay" class="status-modal-overlay" onclick="closeUpdateStatusModal()">
      <div class="status-modal-card" onclick="event.stopPropagation()">
        <div class="status-modal-header">
          <div class="status-modal-header-left">
            <h2 class="status-modal-title">Update Order Status</h2>
            <span class="status-modal-order-tag">#<%= (typeof order !=='undefined' && order && order.orderId) ?
                order.orderId : 'VQ-90214' %></span>
          </div>
          <button type="button" class="status-modal-close-btn" onclick="closeUpdateStatusModal()"
            aria-label="Close modal">&times;</button>
        </div>

        <div class="status-modal-body">
          <!-- Current Status Overview -->
          <div class="current-status-preview-box">
            <div class="current-status-meta">
              <span class="current-status-label">Current Status</span>
              <span class="current-status-val-pill">
                <span class="order-status-badge <%= currentStatusMeta.cssClass %>">
                  <span class="status-bullet-dot"></span>
                  <span>
                    <%= currentOrderStatus %>
                  </span>
                </span>
              </span>
            </div>
            <% if (allowedNextStatuses.length> 0) { %>
              <div style="font-size: 13px; color: var(--text-muted); font-weight: 500;">
                <%= allowedNextStatuses.length %>
                  <%= allowedNextStatuses.length===1 ? 'next status available' : 'next statuses available' %>
              </div>
              <% } %>
          </div>

          <% if (allowedNextStatuses.length> 0) { %>
            <!-- Allowed Next Status Options -->
            <div class="status-options-section">
              <span class="status-section-heading">Allowed Next Status</span>
              <div class="status-options-list">
                <% allowedNextStatuses.forEach(function(item, index) { %>
                  <label class="status-choice-card <%= index === 0 ? 'selected' : '' %>"
                    onclick="selectStatusCard(this)">
                    <input type="radio" name="nextOrderStatus" value="<%= item.status %>" class="status-choice-radio"
                      <%=index===0 ? 'checked' : '' %>>
                    <div class="status-choice-info">
                      <div class="status-choice-header">
                        <span class="status-choice-name">
                          <%= item.label %>
                        </span>
                        <span class="order-status-badge <%= item.badgeClass %>"
                          style="padding: 2px 8px; font-size: 11px;">
                          <span class="status-bullet-dot"></span>
                          <span>
                            <%= item.status %>
                          </span>
                        </span>
                      </div>
                      <p class="status-choice-desc">
                        <%= item.desc %>
                      </p>
                    </div>
                  </label>
                  <% }); %>
              </div>
            </div>

            <!-- Optional Status Note -->
            <!-- <div class="status-note-section">
              <label for="statusUpdateNote" class="status-note-label">Status Update Note (Optional)</label>
              <textarea id="statusUpdateNote" class="status-note-textarea"
                placeholder="Add an optional comment or tracking reference..."></textarea>
            </div> -->
            <% } else { %>
              <!-- Terminal Status Notice -->
              <div class="status-terminal-notice">
                <div class="status-terminal-icon">
                  <% if (currentOrderStatus==='Delivered' ) { %>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                      stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <% } else { %>
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="15" y1="9" x2="9" y2="15"></line>
                        <line x1="9" y1="9" x2="15" y2="15"></line>
                      </svg>
                      <% } %>
                </div>
                <h3 class="status-terminal-title">Order is <%= currentOrderStatus %>
                </h3>
                <p class="status-terminal-desc">
                  <% if (currentOrderStatus==='Delivered' ) { %>
                    This order has already been successfully delivered to the customer. No further status transitions
                    are allowed.
                    <% } else if (currentOrderStatus==='Cancelled' ) { %>
                      This order has been cancelled and fulfillment has ceased. No further status transitions are
                      permitted.
                      <% } else { %>
                        No further status transitions are available for this order.
                        <% } %>
                </p>
              </div>
              <% } %>
        </div>

        <div class="status-modal-footer">
          <button type="button" class="btn-modal-cancel-status" onclick="closeUpdateStatusModal()">Cancel</button>
          <% if (allowedNextStatuses.length> 0) { %>
            <button type="button" id="confirmUpdateStatusBtn" class="btn-modal-confirm-status"
              onclick="confirmStatusUpdate()">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Confirm Update</span>
            </button>
            <% } %>
        </div>
      </div>
    </div>

    <div id="statusToast" class="statusToast" style="display: none;"></div>

    <script>

      function openUpdateStatusModal() {
        const modal = document.getElementById('updateStatusModalOverlay');
        if (modal) {
          modal.classList.add('active');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeUpdateStatusModal() {
        const modal = document.getElementById('updateStatusModalOverlay');
        if (modal) {
          modal.classList.remove('active');
          document.body.style.overflow = '';
        }
      }

      function selectStatusCard(cardElement) {
        document.querySelectorAll('.status-choice-card').forEach(function (card) {
          card.classList.remove('selected');
        });
        cardElement.classList.add('selected');
        const radio = cardElement.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
      }

      function showStatusToast(message, type) {
        const elem = document.getElementById('statusToast');

        elem.textContent = message;
        elem.style.display = 'block';
      }

      async function confirmStatusUpdate() {
        const selectedRadio = document.querySelector('input[name="nextOrderStatus"]:checked');
        if (!selectedRadio) {
          showStatusToast('Please select a status to update.', 'error');
          return;
        }

        const nextStatus = selectedRadio.value;
        const orderId = '<%= (typeof order !== "undefined" && order && order.orderId) ? order.orderId : "" %>';

        const confirmBtn = document.getElementById('confirmUpdateStatusBtn');

        const toastElem = document.getElementById('statusToast');
        toastElem.style.display = 'none';

        confirmBtn.disabled = true;
        confirmBtn.innerHTML = '<span>Updating...</span>';

        try {
          const response = await fetch('/admin/orders/update-status', {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              orderId: orderId,
              status: nextStatus
            })
          });

          const data = await response.json();

          if (!response.ok || !data.success) {
            showStatusToast((data.message || 'Unable to update order status.'), 'error');
            return;
          }

          showStatusToast(data.message, 'message');
          window.location.reload();
        } 
        catch (err) {
          console.error('Update status error:', err);
          showStatusToast('Something went wrong. Please try again.', 'error');
        } 
        finally {
          confirmBtn.disabled = false;
          confirmBtn.innerHTML = '<span>Confirm Update</span>';
        }
      }

      // Keyboard support: Escape closes modal
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeUpdateStatusModal();
        }
      });
    </script>

  </body>

  </html>