  <!-- ================= CANCELLATION REVIEW MODAL ================= -->
  <div id="cancelModalOverlay" class="modal-overlay" onclick="closeCancelModal()">
    <div class="modal-content-card" onclick="event.stopPropagation()">
      <div class="modal-header-row">
        <h2 class="modal-title" id="modalCancelHeading">Cancellation Request Review</h2>
        <button type="button" class="modal-close-btn" onclick="closeCancelModal()">&times;</button>
      </div>

      <div class="modal-body-scroll">
        <div class="modal-meta-box">
          <div class="modal-meta-row">
            <span class="modal-meta-label">Cancellation ID:</span>
            <span class="modal-meta-value" id="modalCancelId">#CAN-8041</span>
          </div>
          <div class="modal-meta-row">
            <span class="modal-meta-label">Associated Order:</span>
            <span class="modal-meta-value" id="modalOrderId">#VQ-90214</span>
          </div>
          <div class="modal-meta-row">
            <span class="modal-meta-label">Customer Name:</span>
            <span class="modal-meta-value" id="modalCustomerName">Rohan Agarwal</span>
          </div>
          <div class="modal-meta-row">
            <span class="modal-meta-label">Item to Cancel:</span>
            <span class="modal-meta-value" id="modalProductName">iPhone 17 Pro Max</span>
          </div>
          <div class="modal-meta-row">
            <span class="modal-meta-label">Refund Value:</span>
            <span class="modal-meta-value" style="color: var(--primary-purple);" id="modalOrderAmount">₹1,59,900</span>
          </div>
          <div class="modal-meta-row">
            <span class="modal-meta-label">Payment Method:</span>
            <span class="modal-meta-value" id="modalPaymentMethod">UPI</span>
          </div>
        </div>

        <div class="modal-reason-quote">
          <div class="modal-reason-title" id="modalReasonTag">Reason: Ordered by mistake</div>
          <p id="modalReasonText">Selected incorrect storage variant 256GB instead of 512GB.</p>
        </div>
      </div>

      <div class="modal-footer-actions">
        <button type="button" class="btn-modal-cancel" onclick="closeCancelModal()">Close</button>
        <button type="button" class="btn-modal-reject" onclick="handleDecision('reject')">Reject Cancellation</button>
        <button type="button" class="btn-modal-approve" onclick="handleDecision('approve')">Approve & Refund</button>
      </div>
    </div>
  </div>

  <script>
    function openCancelModal(cancelId, orderId, customerName, productName, reasonTag, reasonText, orderAmount, paymentMethod, status) {
      document.getElementById('modalCancelHeading').textContent = `Cancellation Request #${cancelId}`;
      document.getElementById('modalCancelId').textContent = `#${cancelId}`;
      document.getElementById('modalOrderId').textContent = `#${orderId}`;
      document.getElementById('modalCustomerName').textContent = customerName;
      document.getElementById('modalProductName').textContent = productName;
      document.getElementById('modalReasonTag').textContent = `Reason: ${reasonTag}`;
      document.getElementById('modalReasonText').textContent = `"${reasonText}"`;
      document.getElementById('modalOrderAmount').textContent = `₹${orderAmount}`;
      document.getElementById('modalPaymentMethod').textContent = paymentMethod;

      document.getElementById('cancelModalOverlay').classList.add('active');
    }

    function closeCancelModal() {
      document.getElementById('cancelModalOverlay').classList.remove('active');
    }

    function handleDecision(decision) {
      const cancelId = document.getElementById('modalCancelId').textContent;
      if (decision === 'approve') {
        alert(`Cancellation ${cancelId} has been approved and refund initiated.`);
      } else {
        alert(`Cancellation ${cancelId} has been rejected.`);
      }
      closeCancelModal();
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeCancelModal();
    });
  </script>

</body>

