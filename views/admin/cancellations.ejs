                    <td class="cancel-date-cell">Oct 21, 2024</td>
                    <td>
                      <span class="cancel-status-badge badge-rejected">
                        <span class="status-dot-indicator"></span>
                        <span>Rejected (Shipped)</span>
                      </span>
                    </td>
                    <td class="action-cell">
                      <button type="button" class="btn-review-cancel" onclick="openCancelModal('CAN-8038', 'VQ-90205', 'Vikram Khanna', 'iPad Pro M4 (Space Grey, 11-inch)', 'Shipping delay', 'Cancellation rejected because item was already packed and handed over to courier. Customer advised to initiate return upon delivery.', '89,900', 'Net Banking (HDFC Bank)', 'Rejected (Shipped)')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
