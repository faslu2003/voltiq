<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Cancellation Management · Voltiq Admin' %></title>
  <link rel="stylesheet" href="/css/admin/cancellations.css">
</head>

<body>

  <div class="admin-layout">

    <!-- ================= SIDEBAR ================= -->
    <aside class="admin-sidebar">
      <div class="sidebar-top-section">
        <a href="/admin/dashboard" class="brand-wrapper">
          <svg class="brand-bolt-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" />
          </svg>
          <div class="brand-text-block">
            <span class="brand-title">voltiq</span>
            <span class="brand-subtitle">Management Suite</span>
          </div>
        </a>

        <nav class="sidebar-nav">
          <!-- Dashboard -->
          <a href="/admin/dashboard" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </span>
            <span>Dashboard</span>
          </a>

          <!-- Inventory -->
          <a href="/admin/products" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </span>
            <span>Inventory</span>
          </a>

          <!-- Categories -->
          <a href="/admin/categories" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
              </svg>
            </span>
            <span>Categories</span>
          </a>

          <!-- Brands -->
          <a href="/admin/brands" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </span>
            <span>Brands</span>
          </a>

          <!-- Orders (Active Group) -->
          <div class="nav-item active">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </span>
            <span>Orders</span>
          </div>

          <!-- Orders Sub-nav (Cancellation Requests Active) -->
          <div class="sub-nav">
            <a href="/admin/orders" class="sub-nav-item">
              <span>Order Management</span>
            </a>
            <a href="/admin/returns" class="sub-nav-item">
              <span>Return Requests</span>
            </a>
            <a href="/admin/cancellations" class="sub-nav-item active">
              <span>Cancellation Requests</span>
            </a>
          </div>

          <!-- Promotions -->
          <a href="/admin/promotions" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </span>
            <span>Promotions</span>
          </a>

          <!-- Customers -->
          <a href="/admin/customers" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            <span>Customers</span>
          </a>
        </nav>
      </div>

      <!-- Sidebar Bottom Profile / Support -->
      <div class="sidebar-bottom-section">
        <a href="/admin/support" class="sidebar-help-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span>Support</span>
        </a>

        <div class="admin-profile-card">
          <div class="profile-left-info">
            <div class="profile-avatar-badge">VA</div>
            <div class="profile-text-names">
              <span class="admin-name">Admin User</span>
              <span class="signout-label">Sign out</span>
            </div>
          </div>

          <form action="/admin/logout" method="POST" style="margin: 0;">
            <button type="submit" class="signout-icon-btn" aria-label="Sign out">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="admin-main">

      <!-- TOP HEADER BAR -->
      <header class="top-header-bar">
        <div class="header-search-wrapper">
          <svg class="header-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" class="header-search-input" placeholder="Search cancellation ID, order ID, or customer..." aria-label="Search cancellations">
        </div>

        <div class="header-right-actions">
          <button class="header-icon-btn" aria-label="Notifications">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span class="header-badge-dot"></span>
          </button>

          <div class="user-avatar-pill">A</div>
        </div>
      </header>

      <!-- PAGE CONTENT WRAPPER -->
      <main class="page-content-wrapper">

        <!-- TITLE BAR & ACTIONS -->
        <div class="cancellations-header-row">
          <div class="header-headings-group">
            <h1 class="page-title">Cancellation Management</h1>
            <p class="page-subtitle">
              Review and process customer order cancellations.
              <span class="highlight-count">Total Requests: <%= typeof totalCancellations !== 'undefined' ? totalCancellations.toLocaleString() : '92' %></span>
            </p>
          </div>

          <a href="#" class="btn-export-cancellations">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Export Cancellations</span>
          </a>
        </div>

        <!-- 4 STAT METRIC CARDS -->
        <div class="stat-cards-grid">
          <!-- Card 1: Total Requests -->
          <div class="stat-card">
            <div class="stat-card-top">
              <div class="stat-icon-wrapper icon-box-purple">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="15" y1="9" x2="9" y2="15"></line>
                  <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
              </div>
            </div>
            <span class="stat-card-label">Total Cancel Requests</span>
            <span class="stat-card-value"><%= typeof stats !== 'undefined' && stats.total ? stats.total.toLocaleString() : '92' %></span>
          </div>

          <!-- Card 2: Pending Review -->
          <div class="stat-card">
            <div class="stat-card-top">
              <div class="stat-icon-wrapper icon-box-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
              </div>
              <span class="stat-badge-pill">Action Required</span>
            </div>
            <span class="stat-card-label">Pending Review</span>
            <span class="stat-card-value"><%= typeof stats !== 'undefined' && stats.pending ? stats.pending.toLocaleString() : '14' %></span>
          </div>

          <!-- Card 3: Approved & Cancelled -->
          <div class="stat-card">
            <div class="stat-card-top">
              <div class="stat-icon-wrapper icon-box-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
            </div>
            <span class="stat-card-label">Approved & Cancelled</span>
            <span class="stat-card-value"><%= typeof stats !== 'undefined' && stats.approved ? stats.approved.toLocaleString() : '68' %></span>
          </div>

          <!-- Card 4: Rejected / Dispatched -->
          <div class="stat-card">
            <div class="stat-card-top">
              <div class="stat-icon-wrapper icon-box-rose">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
              </div>
            </div>
            <span class="stat-card-label">Rejected / Dispatched</span>
            <span class="stat-card-value"><%= typeof stats !== 'undefined' && stats.rejected ? stats.rejected.toLocaleString() : '10' %></span>
          </div>
        </div>

        <!-- SEARCH & FILTERS ROW -->
        <div class="filters-toolbar-row">
          <div class="filters-left-group">
            <div class="table-search-box">
              <svg class="table-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="text" class="table-search-input" placeholder="Search Cancel ID, Order ID..." value="<%= typeof search !== 'undefined' ? search : '' %>">
            </div>

            <select class="filter-select" aria-label="Filter by cancellation status">
              <option value="all" <%= typeof status !== 'undefined' && status === 'all' ? 'selected' : '' %>>All Statuses</option>
              <option value="Pending" <%= typeof status !== 'undefined' && status === 'Pending' ? 'selected' : '' %>>Pending Review</option>
              <option value="Approved" <%= typeof status !== 'undefined' && status === 'Approved' ? 'selected' : '' %>>Approved & Cancelled</option>
              <option value="Rejected" <%= typeof status !== 'undefined' && status === 'Rejected' ? 'selected' : '' %>>Rejected</option>
              <option value="Refunded" <%= typeof status !== 'undefined' && status === 'Refunded' ? 'selected' : '' %>>Refund Processed</option>
            </select>

            <select class="filter-select" aria-label="Filter by cancellation reason">
              <option value="all">All Reasons</option>
              <option value="mistake">Ordered by mistake</option>
              <option value="price">Found better price</option>
              <option value="delay">Shipping delay</option>
              <option value="address">Incorrect address</option>
              <option value="mind">Changed mind</option>
            </select>
          </div>

          <div class="filters-right-group">
            <button class="date-range-badge-btn" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Date Range: Oct 18 - Oct 25</span>
            </button>
          </div>
        </div>

        <!-- CANCELLATIONS DATA TABLE -->
        <div class="cancellations-table-card">
          <div class="table-responsive-container">
            <table class="cancellations-data-table">
              <thead>
                <tr>
                  <th>Cancel ID & Order</th>
                  <th>Customer</th>
                  <th>Items in Order</th>
                  <th>Cancellation Reason</th>
                  <th>Order Value & Refund</th>
                  <th>Requested Date</th>
                  <th>Status</th>
                  <th style="text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (typeof cancellations !== 'undefined' && cancellations.length > 0) { %>
                  <% cancellations.forEach(function(cancel) { %>
                    <tr>
                      <td>
                        <div class="cancel-id-cell">
                          <span class="cancel-id-code">#<%= cancel.cancelId %></span>
                          <a href="/admin/orders/<%= cancel.orderId %>" class="related-order-link">Order #<%= cancel.orderId %></a>
                        </div>
                      </td>
                      <td>
                        <div class="customer-cell-block">
                          <span class="customer-full-name"><%= cancel.customerName || (cancel.user ? cancel.user.name : 'Customer') %></span>
                          <span class="customer-member-id">ID: <%= cancel.customerId || (cancel.user && cancel.user._id ? cancel.user._id.toString().slice(-6) : '') %></span>
                        </div>
                      </td>
                      <td>
                        <div class="product-item-cell">
                          <div class="product-cell-thumb">
                            <img src="<%= cancel.productImage || '/images/admin/iphone-17-pro-max.png' %>" alt="<%= cancel.productName %>">
                          </div>
                          <div class="product-cell-meta">
                            <span class="product-name-txt"><%= cancel.productName %></span>
                            <span class="product-specs-txt"><%= cancel.productSpecs || '' %></span>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="reason-cell-block">
                          <span class="reason-tag"><%= cancel.reasonTag || 'Changed mind' %></span>
                          <span class="reason-snippet" title="<%= cancel.reasonText %>"><%= cancel.reasonText %></span>
                        </div>
                      </td>
                      <td>
                        <div class="refund-amount-cell">
                          <span class="refund-val-bold">₹<%= (cancel.orderAmount || 0).toLocaleString('en-IN') %></span>
                          <span class="refund-method-sub"><%= cancel.paymentMethod || 'Paid via UPI' %></span>
                        </div>
                      </td>
                      <td class="cancel-date-cell">
                        <%= new Date(cancel.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                      </td>
                      <td>
                        <span class="cancel-status-badge badge-<%= (cancel.status || 'pending').toLowerCase() %>">
                          <span class="status-dot-indicator"></span>
                          <span><%= cancel.status || 'Pending Review' %></span>
                        </span>
                      </td>
                      <td class="action-cell">
                        <button type="button" class="btn-review-cancel" onclick="openCancelModal('<%= cancel.cancelId %>', '<%= cancel.orderId %>', '<%= cancel.customerName %>', '<%= cancel.productName %>', '<%= cancel.reasonTag %>', '<%= cancel.reasonText %>', '<%= cancel.orderAmount %>', '<%= cancel.paymentMethod %>', '<%= cancel.status %>')">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                          </svg>
                          <span>Review</span>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <!-- Mock Data matching Voltiq Cancel Flow -->
                  <!-- Row 1: Pending Review -->
                  <tr>
                    <td>
                      <div class="cancel-id-cell">
                        <span class="cancel-id-code">#CAN-8041</span>
                        <a href="/admin/orders/VQ-90214" class="related-order-link">Order #VQ-90214</a>
                      </div>
                    </td>
                    <td>
                      <div class="customer-cell-block">
                        <span class="customer-full-name">Rohan Agarwal</span>
                        <span class="customer-member-id">ID: 882041</span>
                      </div>
                    </td>
                    <td>
                      <div class="product-item-cell">
                        <div class="product-cell-thumb">
                          <img src="/images/admin/iphone-17-pro-max.png" alt="iPhone 17 Pro Max">
                        </div>
                        <div class="product-cell-meta">
                          <span class="product-name-txt">iPhone 17 Pro Max</span>
                          <span class="product-specs-txt">Titanium Black, 256GB</span>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="reason-cell-block">
                        <span class="reason-tag">Ordered by mistake</span>
                        <span class="reason-snippet" title="Selected incorrect storage variant 256GB instead of 512GB">Selected incorrect storage variant</span>
                      </div>
                    </td>
                    <td>
                      <div class="refund-amount-cell">
                        <span class="refund-val-bold">₹1,59,900</span>
                        <span class="refund-method-sub">Paid via UPI</span>
                      </div>
                    </td>
                    <td class="cancel-date-cell">Oct 24, 2024</td>
                    <td>
                      <span class="cancel-status-badge badge-pending">
                        <span class="status-dot-indicator"></span>
                        <span>Pending Review</span>
                      </span>
                    </td>
                    <td class="action-cell">
                      <button type="button" class="btn-review-cancel" onclick="openCancelModal('CAN-8041', 'VQ-90214', 'Rohan Agarwal', 'iPhone 17 Pro Max (Titanium Black, 256GB)', 'Ordered by mistake', 'Selected incorrect storage variant 256GB instead of 512GB, want to re-order 512GB variant.', '1,59,900', 'Paid via UPI (voltiq@axis)', 'Pending Review')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                          <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <span>Review</span>
                      </button>
                    </td>
                  </tr>

                  <!-- Row 2: Approved -->
                  <tr>
                    <td>
                      <div class="cancel-id-cell">
                        <span class="cancel-id-code">#CAN-8040</span>
                        <a href="/admin/orders/VQ-90211" class="related-order-link">Order #VQ-90211</a>
                      </div>
                    </td>
                    <td>
                      <div class="customer-cell-block">
                        <span class="customer-full-name">Priya Kapur</span>
                        <span class="customer-member-id">ID: 191941</span>
                      </div>
                    </td>
                    <td>
                      <div class="product-item-cell">
                        <div class="product-cell-thumb">
                          <img src="/images/order-item-iphone.png" alt="iPhone 17">
                        </div>
                        <div class="product-cell-meta">
                          <span class="product-name-txt">iPhone 17</span>
                          <span class="product-specs-txt">Deep Lavender, 256GB</span>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="reason-cell-block">
                        <span class="reason-tag">Incorrect address</span>
                        <span class="reason-snippet" title="Forgot to update apartment number in checkout">Forgot to update apartment number</span>
                      </div>
                    </td>
                    <td>
                      <div class="refund-amount-cell">
                        <span class="refund-val-bold">₹68,200</span>
                        <span class="refund-method-sub">Pending Payment</span>
                      </div>
                    </td>
                    <td class="cancel-date-cell">Oct 23, 2024</td>
                    <td>
                      <span class="cancel-status-badge badge-approved">
                        <span class="status-dot-indicator"></span>
                        <span>Approved & Cancelled</span>
                      </span>
                    </td>
                    <td class="action-cell">
                      <button type="button" class="btn-review-cancel" onclick="openCancelModal('CAN-8040', 'VQ-90211', 'Priya Kapur', 'iPhone 17 (Deep Lavender, 256GB)', 'Incorrect address', 'Forgot to update apartment number in delivery address, cancelled before dispatch.', '68,200', 'Cash on Delivery', 'Approved & Cancelled')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                          <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                        <span>Review</span>
                      </button>
                    </td>
                  </tr>

                  <!-- Row 3: Refunded -->
                  <tr>
                    <td>
                      <div class="cancel-id-cell">
                        <span class="cancel-id-code">#CAN-8039</span>
                        <a href="/admin/orders/VQ-90209" class="related-order-link">Order #VQ-90209</a>
                      </div>
                    </td>
                    <td>
                      <div class="customer-cell-block">
                        <span class="customer-full-name">Sanya Malhotra</span>
                        <span class="customer-member-id">ID: 110925</span>
                      </div>
                    </td>
                    <td>
                      <div class="product-item-cell">
                        <div class="product-cell-thumb">
                          <img src="/images/admin/airpods-max.png" alt="AirPods Max">
                        </div>
                        <div class="product-cell-meta">
                          <span class="product-name-txt">AirPods Max</span>
                          <span class="product-specs-txt">Space Grey</span>
                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="reason-cell-block">
                        <span class="reason-tag">Found better price</span>
                        <span class="reason-snippet" title="Purchased alternative during festival sale">Purchased alternative during sale</span>
                      </div>
                    </td>
                    <td>
                      <div class="refund-amount-cell">
                        <span class="refund-val-bold">₹59,900</span>
                        <span class="refund-method-sub">Refund to Visa **4242</span>
                      </div>
                    </td>
