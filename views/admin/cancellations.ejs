                  </tr>

                  <!-- Row 4: Rejected / Dispatched -->
                  <tr>
                    <td>
                      <div class="cancel-id-cell">
                        <span class="cancel-id-code">#CAN-8038</span>
                        <a href="/admin/orders/VQ-90205" class="related-order-link">Order #VQ-90205</a>
                      </div>
                    </td>
                    <td>
                      <div class="customer-cell-block">
                        <span class="customer-full-name">Vikram Khanna</span>
                        <span class="customer-member-id">ID: 440212</span>
                      </div>
                    </td>
                    <td>
                      <div class="product-item-cell">
                        <div class="product-cell-thumb">
                          <img src="/images/order-item-ipad.png" alt="iPad Pro M4">
