<%# // ---- Data (would normally be passed in from the route as `locals`) ---- const
  totalCustomers=locals.totalCustomers || 12482; const stats=locals.stats || [ { label: 'ACTIVE THIS MONTH' ,
  value: '8,210' , delta: '+12%' , icon: 'trending-up' , tone: 'violet' }, { label: 'AVG. SPEND' , value: '₹14,500' ,
  delta: '+4%' , icon: 'briefcase' , tone: 'gray' }, { label: 'PREMIUM MEMBERS' , value: '1,402' , delta: null,
  icon: 'badge-check' , tone: 'gray' }, { label: 'BLOCKED ACCOUNTS' , value: '24' , delta: null, icon: 'ban' ,
  tone: 'red' } ]; const pagination=locals.pagination || { from: 1, to: 10, total: 12482, currentPage: 1, lastPage: 1248
  }; %>
  <!DOCTYPE html>
  <html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Management · Voltiq Admin</title>
    <link rel="stylesheet" href="/css/admin/customers.css">
  </head>

  <body>
    <div class="app">

      <!-- ============ SIDEBAR ============ -->
      <aside class="sidebar">
        <div class="brand">
          <svg class="bolt" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" />
          </svg>
          <div class="brand-text">
            <span class="brand-name">voltiq</span>
            <span class="brand-sub">ADMIN PORTAL</span>
          </div>
        </div>

        <nav class="navlist">
          <div class="nav-item">
            <div class="left">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
              </svg>
              <span>Dashboard</span>
            </div>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </div>
          <div class="nav-children">
            <div class="nav-item">
              <div class="left">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7" rx="1" />
                  <rect x="14" y="3" width="7" height="7" rx="1" />
                  <rect x="3" y="14" width="7" height="7" rx="1" />
                  <rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
                <span>Overview</span>
              </div>
            </div>
            <div class="nav-item">
              <div class="left">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v18h18" />
                  <rect x="7" y="12" width="3" height="6" />
                  <rect x="12.5" y="8" width="3" height="10" />
                  <rect x="18" y="5" width="3" height="13" />
                </svg>
                <span>Sales Performance</span>
              </div>
            </div>
          </div>

          <div class="nav-item">
            <div class="left">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 7H4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1Z" />
                <path d="M5 12v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7" />
                <path d="M10 16h4" />
              </svg>
              <span>Inventory</span>
            </div>
          </div>

          <div class="nav-item">
            <div class="left">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 3" />
              </svg>
              <span>Categories</span>
            </div>
          </div>

          <div class="nav-item">
            <div class="left">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1" />
                <circle cx="19" cy="21" r="1" />
                <path d="M2.5 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 8H6" />
              </svg>
              <span>Orders</span>
            </div>
          </div>

          <div class="nav-item active">
            <div class="left">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
              <span>Customers</span>
            </div>
          </div>

          <div class="nav-item">
            <div class="left">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6" />
                <path d="M8.7 13.7 7 22l5-3 5 3-1.7-8.3" />
              </svg>
              <span>Brand Management</span>
            </div>
          </div>

          <div class="nav-item">
            <div class="left">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 11v3a1 1 0 0 0 1 1h3l5 4V6l-5 4H4a1 1 0 0 0-1 1Z" />
                <path d="M16 8a5 5 0 0 1 0 8" />
                <path d="M19.5 5.5a9 9 0 0 1 0 13" />
              </svg>
              <span>Promotions</span>
            </div>
            <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </div>
        </nav>
      </aside>

      <!-- ============ MAIN ============ -->
      <main class="main">

        <div class="topbar">
          <div class="search">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <span>Search orders, customers, or products...</span>
          </div>
          <div class="topbar-icons">
            <div class="icon-btn">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
              </svg>
              <span class="dot"></span>
            </div>
            <div class="icon-btn">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <path d="M9.1 9a3 3 0 0 1 5.82 1c0 2-3 2-3 5" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
              </svg>
            </div>
            <div class="divider-v"></div>
            <div class="avatar-btn">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </div>
          </div>
        </div>

        <div class="page-head">
          <div>
            <h1 class="page-title">Customer Management</h1>
            <p class="page-sub">Manage and track your customer base. Total: <span class="count">
                <%= totalCustomers.toLocaleString('en-IN') %>
              </span> members.</p>
          </div>
        </div>

        <!-- ============ STAT CARDS ============ -->
        <div class="stats-grid">
          <% stats.forEach(function(s){ %>
            <div class="stat-card">
              <div class="stat-top">
                <div class="stat-icon <%= s.tone %>">
                  <% if (s.icon==='trending-up' ) { %>
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                      <polyline points="17 6 23 6 23 12" />
                    </svg>
                    <% } else if (s.icon==='briefcase' ) { %>
                      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" />
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                      </svg>
                      <% } else if (s.icon==='badge-check' ) { %>
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round">
                          <path
                            d="M12 2l2.2 2.2 3-.6.6 3L20 8l-1.2 2.8L20 14l-2.2 1.4-.6 3-3-.6L12 20l-2.2-2.2-3 .6-.6-3L4 14l1.2-2.8L4 8l2.2-1.4.6-3 3 .6z" />
                          <path d="m9 12 2 2 4-4" />
                        </svg>
                        <% } else if (s.icon==='ban' ) { %>
                          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="4.9" y1="4.9" x2="19.1" y2="19.1" />
                          </svg>
                          <% } %>
                </div>
                <% if (s.delta) { %><span class="stat-delta">
                    <%= s.delta %>
                  </span>
                  <% } %>
              </div>
              <div class="stat-label">
                <%= s.label %>
              </div>
              <div class="stat-value">
                <%= s.value %>
              </div>
            </div>
            <% }); %>
        </div>

        <!-- ============ TABLE PANEL ============ -->
        <div class="table-panel">
          <div class="table-toolbar">
            <div class="filter-search">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.3-4.3" />
              </svg>
              <span>Filter by name, email, or ID...</span>
            </div>
            <div class="select-btn">
              <span>Status: All</span>
              <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </div>
            <div class="select-btn">
              <span>Group: All</span>
              <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </div>
            <div class="toolbar-spacer"></div>
            <button class="btn-outline">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="6" x2="20" y2="6" />
                <line x1="7" y1="12" x2="17" y2="12" />
                <line x1="10" y1="18" x2="14" y2="18" />
              </svg>
              Filters
            </button>
            <button class="btn-outline">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              Export
            </button>
          </div>

          <table>
            <thead>
              <tr>
                <th class="sortable">
                  CUSTOMER
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="m7 15 5 5 5-5" />
                    <path d="m7 9 5-5 5 5" />
                  </svg>
                </th>
                <th>EMAIL ADDRESS</th>
                <th>ORDERS</th>
                <th>TOTAL SPEND</th>
                <th>STATUS</th>
                <th>LAST ACTIVE</th>
              </tr>
            </thead>
            <tbody>
              <% customers.forEach(function(customer){ %>
                <tr>
                  <td>
                    <div class="cust-cell">
                      <img class="avatar" src="<%= customer.profileImgUrl || '/images/pngtree-avatar-icon-profile-icon-member-login-vector-isolated-png-image_1978396.jpg' %>" alt="<%= customer.fullName %>">
                      <div>
                        <div class="cust-name">
                          <%= customer.fullName %>
                        </div>
                        <!-- <div class="cust-id">ID: <%= customer._id %></div> -->
                      </div>
                    </div>
                  </td>
                  <td class="email-cell">
                    <%= customer.email %>
                  </td>
                  <td class="num">
                    <%= customer.orders %>
                  </td>
                  <td class="spend-cell">
                    <%= customer.spend %>
                  </td>
                  <td>
                    <form action="/admin/customers/<%= customer._id %>/status" method="POST">
                      <select name="isBlocked" class="status-pill <%= customer.isBlocked ? 'blocked' : 'unblocked' %>"
                        onchange="this.form.submit()">
                        <option value="false" <%=!customer.isBlocked ? 'selected' : '' %>>
                          Unblocked
                        </option>
                        <option value="true" <%=customer.isBlocked ? 'selected' : '' %>>
                          Blocked
                        </option>
                      </select>
                    </form>
                  </td>
                  <td class="last-active">
                    <%= customer.lastActive %>
                  </td>
                </tr>
                <% }); %>
            </tbody>
          </table>

          <div class="table-footer">
            <div class="showing-text">Showing <%= pagination.from %>-<%= pagination.to %> of <%=
                    pagination.total.toLocaleString('en-IN') %> customers</div>
            <div class="pagination">
              <% for(let i=1; i <=pagination.lastPage; i++) { %>
                <a href="/admin/customers?page=<%= i %>"
                  class="page-btn <%= i === pagination.currentPage ? 'active' : '' %>">
                  <%= i %>
                </a>
                <% } %>
            </div>
          </div>
        </div>

      </main>
    </div>
  </body>

  </html>