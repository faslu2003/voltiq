<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Return Request Approval · Voltiq Admin' %>
  </title>
  <link rel="stylesheet" href="/css/admin/return-request.css">
</head>

<body>

  <div class="admin-layout">

    <!-- ================= SIDEBAR ================= -->
    <aside class="admin-sidebar">
      <div class="sidebar-top-section">
        <a href="/admin/dashboard" class="brand-wrapper">
          <svg class="brand-bolt-icon" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z" />
          </svg>
          <div class="brand-text-block">
            <span class="brand-title">voltiq</span>
            <span class="brand-subtitle">Management Suite</span>
          </div>
        </a>

        <nav class="sidebar-nav">
          <!-- Dashboard -->
          <a href="/admin/dashboard" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </span>
            <span>Dashboard</span>
          </a>

          <!-- Inventory -->
          <a href="/admin/products" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z">
                </path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </span>
            <span>Inventory</span>
          </a>

          <!-- Categories -->
          <a href="/admin/categories" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
              </svg>
            </span>
            <span>Categories</span>
          </a>

          <!-- Brands -->
          <a href="/admin/brands" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </span>
            <span>Brands</span>
          </a>

          <!-- Orders (Active Menu) -->
          <div class="nav-item active">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </span>
            <span>Orders</span>
          </div>

          <!-- Orders Sub-nav (Return Requests Active) -->
          <div class="sub-nav">
            <a href="/admin/orders" class="sub-nav-item">
              <span>Order Management</span>
            </a>
            <a href="/admin/returns" class="sub-nav-item active">
              <span>Return Requests</span>
            </a>
          </div>

          <!-- Promotions -->
          <a href="/admin/promotions" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
              </svg>
            </span>
            <span>Promotions</span>
          </a>

          <!-- Customers -->
          <a href="/admin/customers" class="nav-item">
            <span class="nav-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            <span>Customers</span>
          </a>
        </nav>
      </div>

      <!-- Sidebar Bottom Profile / Support -->
      <div class="sidebar-bottom-section">
        <a href="/admin/support" class="sidebar-help-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span>Support</span>
        </a>

        <div class="admin-profile-card">
          <div class="profile-left-info">
            <div class="profile-avatar-badge">VA</div>
            <div class="profile-text-names">
              <span class="admin-name">Admin User</span>
              <span class="signout-label">Sign out</span>
            </div>
          </div>

          <form action="/admin/logout" method="POST" style="margin: 0;">
            <button type="submit" class="signout-icon-btn" aria-label="Sign out">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->
    <div class="admin-main">

      <!-- SIMPLIFIED CLEAN HEADER -->
      <header class="top-header-bar">
        <div class="header-breadcrumbs">
          <a href="/admin/orders" class="breadcrumb-link">Orders</a>
          <span class="breadcrumb-sep">/</span>
          <a href="/admin/orders/<%= typeof order !== 'undefined' && order && order.orderId ? order.orderId : 'VQ-90214' %>"
            class="breadcrumb-link">
            #<%= order.orderId %>
          </a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-current">Return Request</span>
        </div>

        <div class="header-controls-right">
          <div class="header-search-box">
            <svg class="header-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" class="header-search-input" placeholder="Search orders..." aria-label="Search orders">
          </div>

          <button class="header-icon-btn" aria-label="Notifications">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
          </button>
        </div>
      </header>

      <!-- PAGE CONTENT WRAPPER -->
      <main class="page-content-wrapper">

        <!-- TITLE BAR -->
        <div class="page-title-row">
          <h1 class="page-main-heading">Return Request Approval</h1>
        </div>

        <!-- TWO COLUMN CONTENT GRID -->
        <div class="return-content-grid">

          <!-- LEFT COLUMN: RETURN OVERVIEW & EVIDENCE -->
          <div class="review-main-column">

            <!-- 1. RETURN ITEM & ORDER CARD -->
            <div class="review-card">
              <div class="order-overview-header">
                <div class="order-code-block">
                  <span class="order-code-title">Order #<%= order.orderId %></span>
                  <span class="order-timestamp">Placed on <%= new Date(order.createdAt).toLocaleDateString('en-US', {
                      month: 'short' , day: 'numeric' , year: 'numeric' , hour: 'numeric' , minute: 'numeric' , hour12:
                      true }) %></span>
                </div>

                <% if (orderItem.returnDetails.returnStatus==="Requested" ) { %>
                  <span class="status-badge-pending">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                      stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>Pending Approval</span>
                  </span>
                  <% } %>
              </div>

              <% const item=orderItem %>

                <!-- Item Being Returned -->
                <div class="returned-item-row">
                  <div class="item-left-block">
                    <div class="item-thumb-container">
                      <img src="<%= item.imgUrl %>" alt="Product" class="item-thumb-img">
                    </div>
                    <div class="item-text-details">
                      <h3 class="item-title-name">
                        <%= item.productName %>
                      </h3>
                      <span class="item-specs-text">
                        <%= `${item.color || '' } ${item.storage ? ', ' + item.storage : '' }` %>
                      </span>
                    </div>
                  </div>

                  <div class="item-right-price-block">
                    <span class="item-qty-label">Qty: <%= item.quantity %></span>
                    <span class="item-price-val">₹<%= ((item.orderedPrice * item.quantity) -
                        item.discountAllocated).toLocaleString('en-IN') %></span>
                  </div>
                </div>

                <!-- Reason for Return -->
                <div class="reason-quote-box">
                  <div class="reason-header-row">
                    <span class="reason-title-label">Reason for Return</span>
                    <span class="reason-tag-pill">
                      <%= item.returnDetails.reason %>
                    </span>
                  </div>
                  <% if (item.returnDetails.additionalDetails) { %>
                    <p class="reason-quote-text">
                      "<%= item.returnDetails.additionalDetails %>"
                    </p>
                    <% } %>
                </div>
            </div>

            <!-- POTENTIAL REFUND (LAVENDER CARD) -->
            <div class="potential-refund-card">
              <span class="card-top-label">POTENTIAL REFUND</span>

              <div class="refund-rows-stack">
                <div class="refund-calc-line">
                  <span class="refund-label">Item Value</span>
                  <span class="refund-val">₹<%= (item.orderedPrice * item.quantity).toLocaleString('en-IN') %></span>
                </div>

                <div class="refund-calc-line">
                  <span class="refund-label">Discount Allocated</span>
                  <span class="refund-val">- ₹<%= item.discountAllocated.toLocaleString('en-IN') %></span>
                </div>

                <div class="refund-calc-line">
                  <span class="refund-label">Return Fee</span>
                  <span class="refund-val free-fee">FREE</span>
                </div>
              </div>

              <hr class="refund-divider">

              <% const totalRefund=(item.orderedPrice * item.quantity) - item.discountAllocated; %>

                <div class="refund-total-line">
                  <span class="total-refund-title">Total Refund</span>
                  <span class="total-refund-amount">₹<%= totalRefund.toLocaleString('en-IN') %></span>
                </div>

                <p class="payout-security-notice">
                  Refund will be credited to the <%= item.returnDetails.refundMethod %> within 5-7 business days after
                    product inspection.
                </p>
            </div>

          </div>

          <!-- RIGHT COLUMN: DECISION & DETAILS -->
          <div class="decision-side-column">

            <!-- 1. DECISION CENTER (PRIMARY ACTIONS) -->

              <div class="decision-center-card">
                <span class="card-top-label">DECISION CENTER</span>
                <% if (item.returnDetails.returnStatus==="Requested" ) { %>
                <div class="decision-buttons-stack">
                  <button type="button" class="btn-decision btn-approve" onclick="updateReturnStatus('Approved')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                      stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Approve Return</span>
                  </button>

                  <button type="button" class="btn-decision btn-reject" onclick="updateReturnStatus('Rejected')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"
                      stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="15" y1="9" x2="9" y2="15"></line>
                      <line x1="9" y1="9" x2="15" y2="15"></line>
                    </svg>
                    <span>Reject Return</span>
                  </button>
                </div>

                <% } else if (orderItem.returnDetails.returnStatus==="Approved" ) { %>

                  <div class="return-status-display approved">

                    <div class="return-status-icon">
                      ✓
                    </div>

                    <div class="return-status-info">
                      <h3>Return Approved</h3>
                      <p>This return request has been approved.</p>
                    </div>

                  </div>

                  <% } else if (orderItem.returnDetails.returnStatus==="Rejected" ) { %>

                    <div class="return-status-display rejected">

                      <div class="return-status-icon">
                        ✕
                      </div>

                      <div class="return-status-info">
                        <h3>Return Rejected</h3>
                        <p>This return request has been rejected.</p>
                      </div>

                    </div>

                    <% } %>
              </div>

              <!-- 2. CUSTOMER & PICKUP DETAILS -->
              <div class="decision-center-card">
                <span class="card-top-label">CUSTOMER & PICKUP</span>
                <div class="info-section-group">
                  <!-- Customer Meta -->
                  <div class="customer-info-box">
                    <div class="customer-avatar-circle">
                      <%= order.userId.fullName.split(' ').map(function(n){return n[0]}).join('').toUpperCase().slice(0, 2) %>
                  </div>
                  <div class="customer-names-column">
                    <h3 class="customer-name-heading">
                      <%= order.userId.fullName %>
                    </h3>
                  </div>
                </div>

                <!-- Contact Details -->
                <div class="contact-details-list">
                  <div class="contact-item-row">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                      <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                    <span>
                      <%= order.userId.email %>
                    </span>
                  </div>

                  <div class="contact-item-row">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <path
                        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                      </path>
                    </svg>
                    <span>
                      +91 <%= order.userId.phoneNumber %>
                    </span>
                  </div>
                </div>

                <!-- Pickup Address -->
                <div class="pickup-address-block">
                  <svg class="pickup-pin-icon" viewBox="0 0 24 24" fill="none" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <span> <%=`${order.shippingAddress.houseName}, ${order.shippingAddress.locality}, ${order.shippingAddress.city}, ${order.shippingAddress.state} - ${order.shippingAddress.pincode}` %></span>
                </div>

                <div class="pickup-meta-pills">
                  <div>
                    <span class="pickup-meta-label">Method: </span>
                    <span class="pickup-meta-val">Doorstep Pickup</span>
                  </div>
                  <div>
                    <span class="pickup-meta-label">Time: </span>
                    <span class="pickup-meta-val">Morning (9am - 6pm)</span>
                  </div>
                </div>
              </div>
            </div>

          </div>

        </div>

        <div id="returnStatusMessage" style="display: none;"></div>

      </main>

    </div>

  </div>

  <!-- EVIDENCE LIGHTBOX MODAL -->
  <div id="evidenceLightbox" class="lightbox-modal" onclick="closeLightbox()">
    <button class="lightbox-close-btn" onclick="closeLightbox()">&times;</button>
    <img id="lightboxImg" src="" alt="Evidence Enlarged" class="lightbox-img-full" onclick="event.stopPropagation()">
  </div>

  <script>
    function openLightbox(src) {
      document.getElementById(' lightboxImg').src = src;
      document.getElementById('evidenceLightbox').classList.add('active');
    } function closeLightbox() { document.getElementById('evidenceLightbox').classList.remove('active'); }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLightbox(); });
  </script>

                        <script>
                          async function updateReturnStatus(status) {
                            const itemId = '<%= orderItem._id %>';
                            const messageElement = document.getElementById('returnStatusMessage');

                            try {
                              const response = await fetch('/admin/returns/update-status', {
                                method: 'PATCH',
                                headers: {
                                  'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                  itemId,
                                  status
                                })
                              });

                              const data = await response.json().catch(() => null);

                              if (!response.ok || !data?.success) {
                                messageElement.textContent =
                                  data?.message || 'Unable to update return status.';
                                messageElement.style.display = 'block';
                                return;
                              }

                              messageElement.textContent = data.message;
                              messageElement.style.display = 'block';

                              window.location.reload();

                            } catch (err) {
                              console.error('Return status update error:', err);

                              messageElement.textContent = 'Something went wrong. Please try again.';
                              messageElement.style.display = 'block';
                            }
                          }
                        </script>

</body>

</html>