<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'iPhone 17 · Voltiq' %></title>
  <link rel="stylesheet" href="/css/user/product-details.css">
</head>
<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <div class="header-left">
      <a href="/" class="brand-logo">voltiq</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/support" class="nav-link">Support</a>
      </nav>
    </div>

    <div class="header-search">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" class="search-input" placeholder="Search..." aria-label="Search products">
    </div>

    <div class="header-actions">
      <a href="/account" class="icon-btn" aria-label="User Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </a>
      <a href="/cart" class="icon-btn" aria-label="Shopping Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </a>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="main-container">
    
    <!-- BREADCRUMBS BAR (INCLUDED AS REQUESTED) -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="/" class="breadcrumb-link">Home</a>
      <span class="breadcrumb-separator">/</span>
      <a href="/shop/smartphones" class="breadcrumb-link">Smartphones</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-current">iPhone 17</span>
    </nav>

    <!-- PRODUCT MAIN GRID (GALLERY + DETAILS) -->
    <section class="product-main-grid">
      
      <!-- GALLERY COLUMN -->
      <div class="gallery-column">
        <div class="main-image-card">
          <img src="/images/avatar.jpg" alt="iPhone 17 Lavender" id="mainProductImg">
        </div>

        <div class="thumbnails-row">
          <div class="thumb-card active" onclick="switchMainImage('/images/avatar.jpg', this)">
            <img src="/images/avatar.jpg" alt="iPhone 17 Front & Back">
          </div>
          <div class="thumb-card" onclick="switchMainImage('/images/avatar.jpg', this)">
            <img src="/images/avatar.jpg" alt="iPhone 17 Camera Lens Close-up">
          </div>
          <div class="thumb-card" onclick="switchMainImage('/images/avatar.jpg', this)">
            <div class="thumb-text-overlay">
              <div>Brighter display with ProMotion up to 120Hz.</div>
              <div style="opacity: 0.7;">Durable Ceramic Shield 2.</div>
            </div>
          </div>
        </div>
      </div>

      <!-- DETAILS COLUMN -->
      <div class="details-column">
        <span class="badge-new-arrival">New Arrival</span>

        <h1 class="product-name-heading">iPhone 17</h1>

        <!-- PRICE & DISCOUNTS / COUPONS (INCLUDED AS REQUESTED) -->
        <div class="price-block">
          <div class="price-row">
            <span class="current-price">₹79,900</span>
            <span class="original-price">₹89,900</span>
            <span class="discount-badge">11% OFF</span>
          </div>

          <!-- COUPON PROMO BADGE -->
          <div class="coupon-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            <span>Use coupon <span class="coupon-code">VOLTIQ5000</span> for extra ₹5,000 OFF at checkout</span>
          </div>
        </div>

        <p class="product-description-text">
          Experience the perfect balance of power and elegance. The iPhone 17 features a stunning edge-to-edge display, a revolutionary camera system, and the fastest chip ever in a smartphone.
        </p>

        <!-- COLOR SELECTOR -->
        <div class="selector-group">
          <span class="selector-label">Color</span>
          <div class="color-swatches-row">
            <button type="button" class="color-swatch-btn swatch-purple active" title="Lavender Purple" onclick="selectColor(this)"></button>
            <button type="button" class="color-swatch-btn swatch-blue" title="Soft Blue" onclick="selectColor(this)"></button>
            <button type="button" class="color-swatch-btn swatch-sage" title="Sage Green" onclick="selectColor(this)"></button>
            <button type="button" class="color-swatch-btn swatch-white" title="Starlight White" onclick="selectColor(this)"></button>
            <button type="button" class="color-swatch-btn swatch-black" title="Midnight Black" onclick="selectColor(this)"></button>
          </div>
        </div>

        <!-- STORAGE SELECTOR -->
        <div class="selector-group">
          <span class="selector-label">Storage</span>
          <div class="storage-options-row">
            <button type="button" class="storage-btn active" onclick="selectStorage(this)">256GB</button>
            <button type="button" class="storage-btn" onclick="selectStorage(this)">512GB</button>
          </div>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="actions-group">
          <button type="button" class="btn-add-to-cart" onclick="addToCart()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add to Cart
          </button>

          <button type="button" class="btn-add-to-wishlist" onclick="addToWishlist()">Add to Wishlist</button>
        </div>

        <!-- TRUST BADGES -->
        <div class="trust-badges-row">
          <div class="trust-badge-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            Free Shipping
          </div>

          <div class="trust-badge-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            1 Year Warranty
          </div>
        </div>

      </div>

    </section>

    <!-- UNMATCHED PERFORMANCE SECTION -->
    <section class="feature-section">
      <h2 class="section-heading-title">Unmatched Performance</h2>

      <div class="features-grid">
        <!-- Feature 1: 48MP Main Camera -->
        <div class="feature-card">
          <div class="feature-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
              <circle cx="12" cy="13" r="4"></circle>
            </svg>
          </div>
          <h3>48MP Main Camera</h3>
          <p>Capture every detail with life-like precision. Enhanced low-light performance and cinematic video stability.</p>
        </div>

        <!-- Feature 2: A19 Bionic Chip -->
        <div class="feature-card">
          <div class="feature-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
              <rect x="9" y="9" width="6" height="6"></rect>
              <line x1="9" y1="1" x2="9" y2="4"></line>
              <line x1="15" y1="1" x2="15" y2="4"></line>
              <line x1="9" y1="20" x2="9" y2="23"></line>
              <line x1="15" y1="20" x2="15" y2="23"></line>
              <line x1="20" y1="9" x2="23" y2="9"></line>
              <line x1="20" y1="15" x2="23" y2="15"></line>
              <line x1="1" y1="9" x2="4" y2="9"></line>
              <line x1="1" y1="15" x2="4" y2="15"></line>
            </svg>
          </div>
          <h3>A19 Bionic Chip</h3>
          <p>The fastest chip in a smartphone. Unparalleled efficiency for pro-level gaming and multitasking.</p>
        </div>

        <!-- Feature 3: All-day Battery -->
        <div class="feature-card">
          <div class="feature-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="6" width="18" height="12" rx="2" ry="2"></rect>
              <line x1="23" y1="11" x2="23" y2="13"></line>
            </svg>
          </div>
          <h3>All-day Battery</h3>
          <p>Engineered for the long haul. Power that keeps up with your busiest days without breaking a sweat.</p>
        </div>
      </div>

      <!-- CERAMIC SHIELD BANNER -->
      <div class="banner-card">
        <div class="banner-content">
          <h3>Ceramic Shield</h3>
          <p>Toughest glass on any smartphone. Drop performance is 4x better, ensuring your iPhone stays pristine.</p>
        </div>
        <svg class="banner-shield-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      </div>

    </section>

    <!-- COMPLETE YOUR ECOSYSTEM SECTION -->
    <section class="feature-section">
      <h2 class="section-heading-title">Complete Your Ecosystem</h2>

      <div class="ecosystem-grid">
        <!-- iPad Pro M4 -->
        <a href="/product/ipad-pro-m4" class="ecosystem-card">
          <div class="ecosystem-thumb-box">
            <img src="/images/avatar.jpg" alt="iPad Pro M4">
          </div>
          <div class="ecosystem-info">
            <h3 class="ecosystem-title">iPad Pro M4</h3>
            <span class="ecosystem-price">From ₹99,900</span>
            <span class="ecosystem-link-text">Explore →</span>
          </div>
        </a>

        <!-- Apple Watch Ultra 2 -->
        <a href="/product/apple-watch-ultra-2" class="ecosystem-card">
          <div class="ecosystem-thumb-box">
            <img src="/images/avatar.jpg" alt="Apple Watch Ultra 2">
          </div>
          <div class="ecosystem-info">
            <h3 class="ecosystem-title">Apple Watch Ultra 2</h3>
            <span class="ecosystem-price">From ₹89,900</span>
            <span class="ecosystem-link-text">Explore →</span>
          </div>
        </a>
      </div>
    </section>

  </main>

  <!-- SITE FOOTER -->
  <footer class="site-footer">
    <div class="footer-left">
      <div class="footer-logo">voltiq</div>
      <div class="copyright">© <%= new Date().getFullYear() %> voltiq. Atmospheric Precision in Technology.</div>
    </div>
    <div class="footer-links">
      <a href="/privacy" class="footer-link">Privacy Policy</a>
      <a href="/terms" class="footer-link">Terms of Service</a>
      <a href="/shipping" class="footer-link">Shipping</a>
      <a href="/support" class="footer-link">Support</a>
    </div>
  </footer>

  <!-- CLIENT INTERACTION SCRIPT -->
  <script>
    function switchMainImage(src, card) {
      document.getElementById('mainProductImg').src = src;
      document.querySelectorAll('.thumb-card').forEach(el => el.classList.remove('active'));
      card.classList.add('active');
    }

    function selectColor(btn) {
      document.querySelectorAll('.color-swatch-btn').forEach(el => el.classList.remove('active'));
      btn.classList.add('active');
    }

    function selectStorage(btn) {
      document.querySelectorAll('.storage-btn').forEach(el => el.classList.remove('active'));
      btn.classList.add('active');
    }

    function addToCart() {
      alert('iPhone 17 added to your cart!');
    }

    function addToWishlist() {
      alert('iPhone 17 added to your wishlist!');
    }
  </script>

</body>
</html>
