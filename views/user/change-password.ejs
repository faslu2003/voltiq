<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Change Password | voltiq' %></title>
  <link rel="stylesheet" href="/css/user/change-password.css">
</head>
<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <a href="/" class="brand-logo">voltiq</a>

    <div class="header-actions">
      <button class="icon-btn" aria-label="User Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </button>
      <button class="icon-btn" aria-label="Notifications">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
      </button>
      <img src="/images/avatar.jpg" alt="User Profile" class="avatar-badge">
    </div>
  </header>

  <!-- MAIN WRAPPER -->
  <main class="main-wrapper">
    <div class="profile-container">
      
      <!-- SIDEBAR -->
      <aside class="profile-sidebar">
        <div class="user-profile-summary">
          <h3 class="user-name"><%= typeof user !== 'undefined' && user.name ? user.name : 'Arjun Malhotra' %></h3>
          <p class="user-role"><%= typeof user !== 'undefined' && user.tier ? user.tier : 'Premium Member' %></p>
        </div>

        <nav class="sidebar-nav">
          <a href="/account" class="sidebar-nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Account Overview
          </a>

          <a href="/account/personal" class="sidebar-nav-item active">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Personal Information
          </a>

          <a href="/orders" class="sidebar-nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Order History
          </a>

          <a href="/account/addresses" class="sidebar-nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Saved Addresses
          </a>

          <a href="/security" class="sidebar-nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Security
          </a>
        </nav>
      </aside>

      <!-- BACKGROUND CONTENT -->
      <section class="content-area">
        <h1 class="page-title">Personal Information</h1>
        <p class="page-subtitle">Manage your account details and security settings.</p>
      </section>

    </div>
  </main>

  <!-- ================= CHANGE PASSWORD MODAL DIALOG ================= -->
  <div class="modal-backdrop" id="changePasswordModal">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      
      <!-- CLOSE BUTTON -->
      <button class="modal-close-btn" aria-label="Close modal" onclick="closeModal()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- MODAL HEADER -->
      <div class="modal-header">
        <h2 class="modal-title" id="modalTitle">Change Password</h2>
        <p class="modal-subtitle">Ensure your account stays secure.</p>
      </div>

      <% if (error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
        <% } %>

      <!-- MODAL FORM -->
      <form action="/change-password" method="POST" class="modal-form" id="passwordForm">
        
        <!-- CURRENT PASSWORD -->
        <div class="form-group">
          <label for="currentPassword" class="form-label">Current Password</label>
          <div class="input-password-wrapper">
            <input type="password" id="currentPassword" name="currentPassword" class="form-input" placeholder="Enter your current password" required>
            <button type="button" class="toggle-eye-btn" onclick="togglePasswordVisibility('currentPassword', this)" aria-label="Toggle password visibility">
              <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <!-- NEW PASSWORD -->
        <div class="form-group">
          <label for="newPassword" class="form-label">New Password</label>
          <div class="input-password-wrapper">
            <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="Min. 8 characters" oninput="validatePassword()" required>
            <button type="button" class="toggle-eye-btn" onclick="togglePasswordVisibility('newPassword', this)" aria-label="Toggle password visibility">
              <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <!-- CONFIRM NEW PASSWORD -->
        <div class="form-group">
          <label for="confirmPassword" class="form-label">Confirm New Password</label>
          <div class="input-password-wrapper">
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="Confirm your password" required>
            <button type="button" class="toggle-eye-btn" onclick="togglePasswordVisibility('confirmPassword', this)" aria-label="Toggle password visibility">
              <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <!-- PASSWORD REQUIREMENTS BADGES -->
        <div class="requirements-row">
          <span class="req-badge" id="badgeLength">
            <svg class="check-ic" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            8+ Characters
          </span>
          <span class="req-badge" id="badgeSymbol">
            <span class="req-dot"></span>
            1 Symbol
          </span>
          <span class="req-badge" id="badgeNumber">
            <span class="req-dot"></span>
            1 Number
          </span>
        </div>

        <!-- ACTION BUTTONS -->
        <div class="modal-actions">
          <button type="submit" class="btn-update-password">Update Password</button>
          <button type="button" class="btn-cancel-modal" onclick="closeModal()">Cancel</button>
        </div>

      </form>
    </div>
  </div>

  <script>
    function closeModal() {
      document.getElementById('changePasswordModal').classList.add('hidden');
    }

    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      if (input.type === 'password') {
        input.type = 'text';
        btn.style.color = '#6B46C1';
      } else {
        input.type = 'password';
        btn.style.color = '#718096';
      }
    }

    function validatePassword() {
      const val = document.getElementById('newPassword').value;
      
      const badgeLength = document.getElementById('badgeLength');
      const badgeSymbol = document.getElementById('badgeSymbol');
      const badgeNumber = document.getElementById('badgeNumber');

      // 8+ Characters
      if (val.length >= 8) {
        badgeLength.classList.add('valid');
      } else {
        badgeLength.classList.remove('valid');
      }

      // 1 Symbol
      if (/[!@#$%^&*(),.?":{}|<>]/.test(val)) {
        badgeSymbol.classList.add('valid');
      } else {
        badgeSymbol.classList.remove('valid');
      }

      // 1 Number
      if (/\d/.test(val)) {
        badgeNumber.classList.add('valid');
      } else {
        badgeNumber.classList.remove('valid');
      }
    }
  </script>

</body>
</html>
