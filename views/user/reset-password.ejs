<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/user/reset-password.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&family=Kalnia:wght@100..700&display=swap"
        rel="stylesheet">
    <title>Reset Password</title>
</head>

<body>

    <div id="wrapper">

        <form action="/signin/reset-password" method="post" novalidate>

            <p id="heading">Reset Password</p>
            <p id="text">Enter your email and we'll send you a
                link to reset your password.</p>

            <% if (message) { %>
                <div class="alert alert-message">
                    <%= message %>
                </div>
                <% } %>

            <% if (error) { %>
                <div class="alert alert-error">
                    <%= error %>
                </div>
            <% } %>

                    <div id="input-box">
                        <label for="">Email Address</label>
                        <input type="email" placeholder="name@example.com" name="email">
                    </div>

                    <div>
                        <button id="btn">Send Reset Link</button>
                    </div>

                    <p id="signin">Back to <a href="/signin">Sign In</a></p>

        </form>

    </div>

</body>

</html>