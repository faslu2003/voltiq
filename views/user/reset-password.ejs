<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Reset Password · Voltiq' %></title>
  <link rel="stylesheet" href="/css/user/reset-password.css">
</head>
<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <a href="/" class="brand-logo">voltiq</a>
    <a href="/support" class="header-support-link">Need help?</a>
  </header>

  <!-- MAIN AUTH CONTAINER -->
  <main class="auth-main-container">
    <div class="reset-card">
      
      <!-- ================= FORM INITIAL STATE ================= -->
      <div id="resetFormState" class="form-state">
        
        <!-- Lock Icon Badge -->
        <div class="icon-badge">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>

        <h1 class="reset-title">Set New Password</h1>
        <p class="reset-subtitle">Your new password must be at least 8 characters and different from previously used passwords.</p>

        <!-- Error Notification Banner -->
        <div id="errorAlert" class="alert-banner error hidden">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span id="errorAlertText">Passwords do not match. Please verify and try again.</span>
        </div>

        <!-- Reset Password Form -->
        <form action="/signin/password/reset/<%= token %>" method="POST" class="reset-form" id="resetPasswordForm">
          <input type="hidden" name="token" id="resetToken" value="<%= typeof token !== 'undefined' ? token : '' %>">

          <% if (error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
        <% } %>

          <!-- New Password Field -->
          <div class="form-group">
            <label for="newPassword" class="form-label">New Password</label>
            <div class="password-input-wrapper">
              <input type="password" id="newPassword" name="newPassword" class="form-input" placeholder="Enter new password" required autocomplete="new-password" oninput="validatePasswordRules()">
              <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('newPassword', this)" aria-label="Toggle password visibility">
                <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </button>
            </div>
          </div>

          <!-- Confirm New Password Field -->
          <div class="form-group">
            <label for="confirmPassword" class="form-label">Confirm New Password</label>
            <div class="password-input-wrapper">
              <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" placeholder="Re-enter new password" required autocomplete="new-password" oninput="validatePasswordRules()">
              <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('confirmPassword', this)" aria-label="Toggle password visibility">
                <svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              </button>
            </div>
          </div>

          <!-- Password Live Requirements Checklist -->
          <div class="password-checklist">
            <div class="check-item" id="ruleLength">
              <span class="check-icon">✓</span>
              <span>At least 8 characters long</span>
            </div>
            <div class="check-item" id="ruleUpper">
              <span class="check-icon">✓</span>
              <span>Contains at least 1 uppercase letter</span>
            </div>
            <div class="check-item" id="ruleMatch">
              <span class="check-icon">✓</span>
              <span>New passwords match</span>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn-reset-submit" id="btnResetSubmit">
            Reset Password
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </form>

        <a href="/signin" class="back-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back to Sign In
        </a>

      </div>

      <!-- ================= SUCCESS CONFIRMATION STATE ================= -->
      <div id="successState" class="success-state hidden">
        <div class="success-icon-badge">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>

        <h1 class="reset-title">Password Reset!</h1>
        <p class="reset-subtitle">Your password has been successfully updated. You can now sign into your Voltiq account with your new password.</p>

        <a href="/signin" class="btn-reset-submit" style="text-decoration: none;">
          Proceed to Sign In
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <span class="footer-logo">voltiq</span>
    <span class="copyright">© <%= new Date().getFullYear() %> Voltiq Electronics. All rights reserved.</span>
  </footer>

  <!-- CLIENT JAVASCRIPT -->
  <script>
    function togglePasswordVisibility(inputId, btn) {
      const input = document.getElementById(inputId);
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';

      btn.innerHTML = isPassword
        ? `<svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`
        : `<svg class="eye-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
    }

    function validatePasswordRules() {
      const newPass = document.getElementById('newPassword').value;
      const confirmPass = document.getElementById('confirmPassword').value;

      const ruleLen = document.getElementById('ruleLength');
      const ruleUpper = document.getElementById('ruleUpper');
      const ruleMatch = document.getElementById('ruleMatch');
      const errorAlert = document.getElementById('errorAlert');

      // Hide error alert on typing
      errorAlert.classList.add('hidden');

      // Rule 1: Length >= 8
      if (newPass.length >= 8) {
        ruleLen.classList.add('valid');
      } else {
        ruleLen.classList.remove('valid');
      }

      // Rule 2: At least 1 uppercase
      if (/[A-Z]/.test(newPass)) {
        ruleUpper.classList.add('valid');
      } else {
        ruleUpper.classList.remove('valid');
      }

      // Rule 3: Passwords match
      if (confirmPass.length > 0 && newPass === confirmPass) {
        ruleMatch.classList.add('valid');
      } else {
        ruleMatch.classList.remove('valid');
      }
    }

  </script>

</body>
</html>
