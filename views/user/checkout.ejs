<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Secure Checkout</title>
  <link rel="stylesheet" href="/css/user/checkout.css">
</head>

<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <a href="/home" class="brand-logo">voltiq</a>

    <nav class="main-nav">
      <a href="/home" class="nav-link">Home</a>
      <a href="/products" class="nav-link">Products</a>
      <a href="/products" class="nav-link">Collections</a>
      <a href="/support" class="nav-link">Sustainability</a>
    </nav>

    <div class="header-actions">
      <a href="/profile" class="icon-btn" aria-label="User Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
          </path>
        </svg>
      </a>

      <a href="/cart" class="icon-btn" aria-label="Shopping Cart">
        <div class="cart-icon-wrapper">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="cart-count-badge" id="headerCartCount">
            <%= typeof cartItems !=='undefined' && cartItems.length ? cartItems.length : 2 %>
          </span>
        </div>
      </a>
    </div>
  </header>

  <!-- MAIN CHECKOUT CONTAINER -->
  <main class="checkout-main-wrapper">
    <div class="checkout-grid">

      <!-- LEFT COLUMN: CHECKOUT STEPS -->
      <div class="checkout-steps-column">

        <!-- Title & Subtitle -->
        <div class="checkout-header-group">
          <h1 class="checkout-title">Secure Checkout</h1>
          <p class="checkout-subtitle">Complete your order with atmospheric precision.</p>
        </div>

        <!-- STEP 1: SHIPPING INFORMATION -->
        <section class="checkout-section-card" id="stepShippingAddress">
          <div class="section-header">
            <span class="section-icon">
              <!-- Delivery Truck Icon -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
            </span>
            <h2 class="section-title">1. Shipping Information</h2>
          </div>

          <!-- Saved Address List -->
          <div class="address-options-list" id="addressListContainer">

              <% addresses.forEach((addr, idx)=> { %>
                <div class="address-option-card <%= addr.isDefault ? 'selected' : '' %>"
                  data-address-id="<%= addr._id %>" onclick="selectAddress(this)">
                  <div class="address-card-main">
                    <div class="custom-radio">
                      <span class="custom-radio-dot"></span>
                    </div>
                    <div class="address-text-group">
                      <div class="address-type-title">
                        <span>
                          <%= addr.addressType || 'Home' %>
                        </span>
                        <% if (addr.isDefault) { %>
                          <span class="badge-default">DEFAULT</span>
                          <% } %>
                      </div>
                      <span class="address-detail-text">
                        <%= addr.houseName %>, <%= addr.locality %>, <%= addr.city %>, <%= addr.state %> - <%=
                                  addr.pincode %>
                      </span>
                    </div>
                  </div>

                  <!-- EDIT OPTION FOR EACH ADDRESS -->
                  <div class="address-card-actions" onclick="event.stopPropagation();">
                    <a href="/address/edit/<%= addr._id %>?redirect=checkout" class="btn-edit-address"
                      title="Edit this address">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                      </svg>
                      Edit
                    </a>
                  </div>
                </div>
              <% }) %>

          </div>

          <!-- Add New Address Button -->
          <a href="/address/add?redirect=checkout" class="btn-add-address-dashed">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add New Address
          </a>
        </section>

        <!-- STEP 2: SHIPPING METHOD -->
        <section class="checkout-section-card" id="stepShippingMethod">
          <div class="section-header">
            <span class="section-icon">
              <!-- Speed/Parcel Shipping Icon -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4"></path>
                <path d="m4.93 4.93 2.83 2.83"></path>
                <path d="M2 12h4"></path>
                <path d="M14 12a2 2 0 1 0-4 0 2 2 0 0 0 4 0Z"></path>
                <path d="m16.24 7.76 2.83-2.83"></path>
                <path d="M12 18v4"></path>
                <path d="m4.93 19.07 2.83-2.83"></path>
                <path d="m19.07 19.07-2.83-2.83"></path>
              </svg>
            </span>
            <h2 class="section-title">2. Shipping Method</h2>
          </div>

          <div class="shipping-options-list">
            <!-- Standard Shipping (Free) -->
            <div class="shipping-option-card selected" id="shipStandard" data-cost="0"
              onclick="selectShippingMethod(this, 0, 'Free')">
              <div class="shipping-card-main">
                <div class="custom-radio">
                  <span class="custom-radio-dot"></span>
                </div>
                <div class="shipping-text-group">
                  <span class="shipping-title">Standard Shipping</span>
                  <span class="shipping-subtitle">3-5 business days</span>
                </div>
              </div>
              <span class="shipping-price-tag">Free</span>
            </div>

            <!-- Express Delivery (₹2,000) -->
            <div class="shipping-option-card" id="shipExpress" data-cost="2000"
              onclick="selectShippingMethod(this, 200, '₹200')">
              <div class="shipping-card-main">
                <div class="custom-radio">
                  <span class="custom-radio-dot"></span>
                </div>
                <div class="shipping-text-group">
                  <span class="shipping-title">Express Delivery</span>
                  <span class="shipping-subtitle">Next day delivery</span>
                </div>
              </div>
              <span class="shipping-price-tag fee">₹200</span>
            </div>
          </div>
        </section>

        <!-- STEP 3: PAYMENT METHOD -->
        <section class="checkout-section-card" id="stepPaymentMethod">
          <div class="section-header">
            <span class="section-icon">
              <!-- Payment Card Icon -->
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
            </span>
            <h2 class="section-title">3. Payment Method</h2>
          </div>

          <!-- 4 Payment Pills Grid (UPI, Net Banking, COD, Wallet) -->
          <div class="payment-methods-grid">
            <div class="payment-method-pill" data-method="upi" onclick="selectPaymentPill(this)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>UPI</span>
            </div>

            <div class="payment-method-pill" data-method="netbanking" onclick="selectPaymentPill(this)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <polygon points="3 8 12 3 21 8"></polygon>
                <line x1="5" y1="8" x2="5" y2="19"></line>
                <line x1="10" y1="8" x2="10" y2="19"></line>
                <line x1="14" y1="8" x2="14" y2="19"></line>
                <line x1="19" y1="8" x2="19" y2="19"></line>
                <line x1="2" y1="19" x2="22" y2="19"></line>
              </svg>
              <span>Net Banking</span>
            </div>

            <div class="payment-method-pill" data-method="cod" onclick="selectPaymentPill(this)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                <circle cx="12" cy="12" r="2"></circle>
                <path d="M6 12h.01M18 12h.01"></path>
              </svg>
              <span>Cash on Delivery (COD)</span>
            </div>

            <div class="payment-method-pill" data-method="wallet" onclick="selectPaymentPill(this)">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
                <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
                <path d="M18 12a2 2 0 0 0 0 4h4v-4Z"></path>
              </svg>
              <span>Wallet</span>
            </div>
          </div>

          <!-- Divider: OR PAY VIA CARD -->
          <div class="payment-divider">
            <span class="payment-divider-text">OR PAY VIA CARD</span>
          </div>

          <!-- Card Form Inputs -->
          <div class="card-details-group" id="cardDetailsGroup">
            <!-- Card Number -->
            <div class="form-group-item">
              <label for="cardNumber" class="form-field-label">Card Number</label>
              <div class="input-with-icon">
                <span class="input-icon-left">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                  </svg>
                </span>
                <input type="text" id="cardNumber" class="checkout-input has-icon" placeholder="0000 0000 0000 0000"
                  maxlength="19" oninput="formatCardNumber(this)">
              </div>
            </div>

            <!-- Expiry & CVV 2-Column Row -->
            <div class="card-split-row">
              <div class="form-group-item">
                <label for="cardExpiry" class="form-field-label">Expiry Date</label>
                <input type="text" id="cardExpiry" class="checkout-input" placeholder="MM / YY" maxlength="7"
                  oninput="formatExpiry(this)">
              </div>
              <div class="form-group-item">
                <label for="cardCvv" class="form-field-label">CVV</label>
                <input type="password" id="cardCvv" class="checkout-input" placeholder="123" maxlength="4">
              </div>
            </div>
          </div>

          <!-- Notice when non-card payment pill is active -->
          <div class="alt-payment-notice hidden" id="altPaymentNotice">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <span id="altPaymentNoticeText">You will be securely redirected to complete your payment upon
              checkout.</span>
          </div>
        </section>

      </div>

      <!-- RIGHT COLUMN: ORDER SUMMARY + COUPONS + OFFERS -->
      <aside class="checkout-summary-column">

        <!-- ORDER SUMMARY CARD -->
        <div class="order-summary-card">
          <h3 class="summary-card-title">Order Summary</h3>

          <!-- Products List (with product quantity) -->
          <div class="summary-items-list" id="summaryItemsList">

            <% if (typeof cartItems !=='undefined' && cartItems.length> 0) { %>
              <% cartItems.forEach((item)=> { %>
                <div class="summary-product-item" data-price="<%= item.variant.price %>"
                  data-qty="<%= item.quantity %>">
                  <div class="product-thumb-box">
                    <img
                      src="<%= (item.variant.imgUrls && item.variant.imgUrls.length) ? item.variant.imgUrls[0] : '/images/avatar.jpg' %>"
                      alt="<%= item.product.name %>" class="product-thumb-img">
                  </div>
                  <div class="product-meta-group">
                    <span class="product-name-text">
                      <%= item.product.name %>
                    </span>
                    <div class="product-spec-row">
                      <span>
                        <%= `${item.variant.color || '' } · ${item.variant.storage || '' }` %>
                      </span>
                      <!-- SHOW PRODUCT QUANTITY -->
                      <span class="product-qty-tag">Qty: <%= item.quantity %></span>
                    </div>
                  </div>
                  <span class="product-price-text">₹<%= (item.variant.price * item.quantity).toLocaleString('en-IN') %>
                  </span>
                </div>
                <% }) %>
                  <% } else { %>
                    <!-- Mock Fallback matching screenshot exactly -->
                    <div class="summary-product-item" data-price="89900" data-qty="1">
                      <div class="product-thumb-box">
                        <img src="/images/avatar.jpg" alt="iPhone 17" class="product-thumb-img">
                      </div>
                      <div class="product-meta-group">
                        <span class="product-name-text">iPhone 17</span>
                        <div class="product-spec-row">
                          <span>Stellar Gray · 256GB</span>
                          <span class="product-qty-tag">Qty: 1</span>
                        </div>
                      </div>
                      <span class="product-price-text">₹89,900</span>
                    </div>

                    <div class="summary-product-item" data-price="119900" data-qty="1">
                      <div class="product-thumb-box">
                        <img src="/images/avatar.jpg" alt="iPad Pro M4" class="product-thumb-img">
                      </div>
                      <div class="product-meta-group">
                        <span class="product-name-text">iPad Pro M4</span>
                        <div class="product-spec-row">
                          <span>Silver · 13-inch</span>
                          <span class="product-qty-tag">Qty: 1</span>
                        </div>
                      </div>
                      <span class="product-price-text">₹1,19,900</span>
                    </div>
                    <% } %>

          </div>

          <!-- Price Calculations -->
          <div class="summary-calc-group">
            <!-- Subtotal -->
            <div class="summary-calc-row">
              <span>Subtotal</span>
              <span class="calc-val" id="summarySubtotalText">
                ₹<%= typeof subtotal !=='undefined' ? subtotal.toLocaleString('en-IN') : '2,09,800' %>
              </span>
            </div>

            <!-- Shipping -->
            <div class="summary-calc-row">
              <span>Shipping</span>
              <span class="calc-val free" id="summaryShippingText">Free</span>
            </div>

            <!-- DISCOUNTS (IF ANY) - Dynamic Row -->
            <div class="summary-calc-row discount-row hidden" id="summaryDiscountRow">
              <div class="discount-label-group">
                <span>Discount (<span id="summaryDiscountCode">VOLTIQ5000</span>)</span>
                <button type="button" class="btn-remove-coupon-tag" onclick="removeCoupon()"
                  title="Remove coupon">✕</button>
              </div>
              <span class="calc-val discount-val" id="summaryDiscountText">-₹0</span>
            </div>

          <!-- Total Row -->
          <div class="summary-total-row">
            <span class="total-label">Total</span>
            <span class="total-amount-val" id="summaryTotalText">
              ₹<%= typeof total !=='undefined' ? total.toLocaleString('en-IN') : '2,47,564' %>
            </span>
          </div>

          <!-- Complete Purchase Button -->
          <button type="button" class="btn-complete-purchase" id="btnCompletePurchase"
            onclick="handleCompletePurchase()">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Complete Purchase</span>
          </button>

          <!-- SSL Encryption Subtext -->
          <div class="secure-ssl-subtext">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Secure SSL Encryption</span>
          </div>
        </div>

        <!-- AVAILABLE COUPONS CARD (Click opens Coupon Modal) -->
        <div class="action-info-card" id="cardAvailableCoupons" onclick="openCouponModal()">
          <div class="info-card-left">
            <div class="info-card-icon-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z">
                </path>
                <path d="M13 5v2"></path>
                <path d="M13 17v2"></path>
                <path d="M13 11v2"></path>
              </svg>
            </div>
            <div class="info-card-text">
              <span class="info-card-title">Available Coupons</span>
              <span class="info-card-sub" id="couponCardSub"><%= coupons.length %> Coupons available</span>
            </div>
          </div>
          <div class="info-card-right">
            <span id="couponCardRightText">View All</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </div>

        <!-- AVAILABLE OFFERS CARD (Click opens Offers Modal) -->
        <div class="action-info-card" id="cardAvailableOffers" onclick="openOffersModal()">
          <div class="info-card-left">
            <div class="info-card-icon-box">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path
                  d="m19 14 1.41-1.41a2 2 0 0 0 0-2.83l-6.17-6.17A2 2 0 0 0 12.83 3H5a2 2 0 0 0-2 2v7.83a2 2 0 0 0 .59 1.41l6.17 6.17a2 2 0 0 0 2.83 0L14 19">
                </path>
                <circle cx="8" cy="8" r="1.5"></circle>
              </svg>
            </div>
            <div class="info-card-text">
              <span class="info-card-title">Available Offers</span>
              <!-- <span class="info-card-sub">Bank & Card Offers</span> -->
            </div>
          </div>
          <div class="info-card-right">
            <span>View All</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        </div>

      </aside>

    </div>
  </main>

  <!-- SITE FOOTER -->
  <footer class="checkout-footer">
    <div class="footer-left">
      <a href="/home" class="brand-logo">voltiq</a>
    </div>

    <div class="footer-nav-links">
      <a href="/privacy" class="footer-link">Privacy Policy</a>
      <a href="/terms" class="footer-link">Terms of Service</a>
      <a href="/shipping" class="footer-link">Shipping & Returns</a>
      <a href="/contact" class="footer-link">Contact</a>
    </div>

    <div class="footer-copyright">
      <span>© <%= new Date().getFullYear() %> voltiq. all rights reserved.</span>
    </div>
  </footer>

  <!-- ================= COUPONS MODAL DIALOG ================= -->
  <div class="modal-overlay" id="couponModal" onclick="handleCouponOverlayClick(event)">
    <div class="modal-dialog">
      <div class="modal-header">
        <div class="modal-title-group">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary-purple)" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path
              d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z">
            </path>
          </svg>
          <h3 class="modal-title">Apply Coupon</h3>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeCouponModal()">✕</button>
      </div>

      <div class="modal-body">
        <!-- Input code field -->
        <div class="coupon-input-box">
          <input type="text" id="customCouponInput" class="coupon-text-input" placeholder="Enter coupon code"
            autocomplete="off">
          <button type="button" class="btn-apply-code" onclick="applyCustomCoupon()">Apply</button>
        </div>

        <!-- Available Coupons List -->
        <div class="coupons-list" id="couponsListWrapper">

          <% coupons.forEach((coupon)=> { %>
            <div class="coupon-item-card" id="coupon-card">
              <div class="coupon-item-header">
                <span class="coupon-code-badge">
                  <%= coupon.couponCode.toUpperCase() %>
                </span>
                <button type="button" class="btn-coupon-action" data-coupon-id="<%= coupon._id %>"
                  onclick="applyCouponDirect('<%= coupon._id %>', '<%= coupon.couponCode %>', <%= coupon.discountValue %>, <%= coupon.minimumPurchase %>, <%= coupon.discountType === 'percentage' ? true : false %>, <%= coupon.maximumDiscount || null %>)">Apply</button>
              </div>
              <p class="coupon-item-desc">
                <%= coupon.description %>
              </p>
              <span class="coupon-item-min">Minimum order: ₹<%= coupon.minimumPurchase.toLocaleString('en-IN') %></span>
            </div>
            <% }) %>

        </div>
      </div>
    </div>
  </div>

  <!-- ================= OFFERS MODAL ================= -->
  <div class="modal-overlay" id="offersModal" onclick="handleOffersOverlayClick(event)">
    <div class="modal-dialog">
      <div class="modal-header">
        <div class="modal-title-group">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary-purple)" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path
              d="m19 14 1.41-1.41a2 2 0 0 0 0-2.83l-6.17-6.17A2 2 0 0 0 12.83 3H5a2 2 0 0 0-2 2v7.83a2 2 0 0 0 .59 1.41l6.17 6.17a2 2 0 0 0 2.83 0L14 19">
            </path>
            <circle cx="8" cy="8" r="1.5"></circle>
          </svg>
          <h3 class="modal-title">Available Offers</h3>
        </div>
        <button type="button" class="modal-close-btn" onclick="closeOffersModal()">✕</button>
      </div>

      <div class="modal-body">
        <div class="offers-list">

          <% offers.forEach((offer)=> { %>

            <div class="offer-item-card">
              <div class="offer-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                </svg>
              </div>
              <div class="offer-text-group">
                <h4 class="offer-item-title">
                  <%= offer.offerName %>
                </h4>
                <p class="offer-item-desc">
                  <%= offer.description %>
                </p>
              </div>
            </div>

            <% }) %>

        </div>
      </div>
    </div>
  </div>

  <!-- TOAST FEEDBACK NOTIFICATION -->
  <div class="checkout-toast" id="checkoutToast"></div>

  <!-- INTERACTIVE CLIENT-SIDE CONTROLLER SCRIPT -->
  <script>

    const code = <%- JSON.stringify(couponCode) || null %>;
    const discountAmount = <%- JSON.stringify(discountAmount) || null %>;

    // Global Checkout State
    let checkoutState = {
      selectedAddressId: null,
      shippingCost: 0,
      appliedCoupon: {
        code,
        discountAmount
      },
      selectedPaymentMethod: 'card' // 'card', 'upi', 'netbanking', 'cod', 'wallet'
    };

    let couponId = null;

    // Calculate initial subtotal from rendered items
    function getSubtotal() {
      const items = document.querySelectorAll('.summary-product-item');
      let sub = 0;
      items.forEach(item => {
        const p = parseFloat(item.dataset.price) || 0;
        const q = parseInt(item.dataset.qty) || 1;
        sub += (p * q);
      });
      return sub;
    }

    // Recalculate and update the Order Summary amounts
    function recalculateSummary() {
      const subtotal = getSubtotal();
      const shipping = checkoutState.shippingCost;
      let discount = 0;

      if (checkoutState.appliedCoupon) {
        discount = checkoutState.appliedCoupon.discountAmount;
      }

      const total = Math.max(0, subtotal - discount) + shipping;

      // Update Subtotal text
      document.getElementById('summarySubtotalText').textContent = '₹' + subtotal.toLocaleString('en-IN');

      // Update Shipping text
      const shipElem = document.getElementById('summaryShippingText');
      if (shipping === 0) {
        shipElem.textContent = 'Free';
        shipElem.className = 'calc-val free';
      } else {
        shipElem.textContent = '₹' + shipping.toLocaleString('en-IN');
        shipElem.className = 'calc-val';
      }

      // Update Discount row
      const discountRow = document.getElementById('summaryDiscountRow');
      if (discount > 0 && checkoutState.appliedCoupon) {
        discountRow.classList.remove('hidden');
        document.getElementById('summaryDiscountCode').textContent = checkoutState.appliedCoupon.code.toUpperCase();
        document.getElementById('summaryDiscountText').textContent = '-₹' + discount.toLocaleString('en-IN');
      } else {
        discountRow.classList.add('hidden');
      }

      // Update Total
      document.getElementById('summaryTotalText').textContent = '₹' + total.toLocaleString('en-IN');
    }

    // 1. Shipping Address Selection
    function selectAddress(cardElem) {
      document.querySelectorAll('.address-option-card').forEach(card => card.classList.remove('selected'));
      cardElem.classList.add('selected');
      checkoutState.selectedAddressId = cardElem.dataset.addressId;
    }

    // 2. Shipping Method Selection
    function selectShippingMethod(cardElem, cost, labelText) {
      document.querySelectorAll('.shipping-option-card').forEach(card => card.classList.remove('selected'));
      cardElem.classList.add('selected');
      checkoutState.shippingCost = cost;
      recalculateSummary();
    }

    // 3. Payment Method Selection
    function selectPaymentPill(pillElem) {
      const isAlreadyActive = pillElem.classList.contains('active');
      const method = pillElem.dataset.method;

      document.querySelectorAll('.payment-method-pill').forEach(p => p.classList.remove('active'));

      const cardGroup = document.getElementById('cardDetailsGroup');
      const altNotice = document.getElementById('altPaymentNotice');
      const altNoticeText = document.getElementById('altPaymentNoticeText');

      if (!isAlreadyActive) {
        pillElem.classList.add('active');
        checkoutState.selectedPaymentMethod = method;
        cardGroup.style.opacity = '0.4';
        altNotice.classList.remove('hidden');

        if (method === 'upi') {
          altNoticeText.textContent = 'You will be prompted to enter your UPI ID or scan QR at the next step.';
        } else if (method === 'netbanking') {
          altNoticeText.textContent = 'Select your preferred bank on the secure payment gateway next.';
        } else if (method === 'cod') {
          altNoticeText.textContent = 'Cash on Delivery selected. Please keep exact change ready upon delivery.';
        } else if (method === 'wallet') {
          altNoticeText.textContent = 'Pay using your Voltiq Wallet balance or linked digital wallets.';
        }
      } else {
        // Deselect, return to Card payment
        checkoutState.selectedPaymentMethod = 'card';
        cardGroup.style.opacity = '1';
        altNotice.classList.add('hidden');
      }
    }

    // Card Input Formatters
    function formatCardNumber(input) {
      let val = input.value.replace(/\D/g, '');
      let formatted = val.match(/.{1,4}/g)?.join(' ') || val;
      input.value = formatted.substring(0, 19);
    }

    function formatExpiry(input) {
      let val = input.value.replace(/\D/g, '');
      if (val.length > 2) {
        input.value = val.substring(0, 2) + ' / ' + val.substring(2, 4);
      } else {
        input.value = val;
      }
    }

    // ================= COUPONS INTERACTIVITY =================
    function openCouponModal() {
      document.getElementById('couponModal').classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeCouponModal() {
      document.getElementById('couponModal').classList.remove('show');
      document.body.style.overflow = '';
    }

    function handleCouponOverlayClick(e) {
      if (e.target === document.getElementById('couponModal')) {
        closeCouponModal();
      }
    }

    function openOffersModal() {
      document.getElementById('offersModal').classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closeOffersModal() {
      document.getElementById('offersModal').classList.remove('show');
      document.body.style.overflow = '';
    }

    function handleOffersOverlayClick(e) {
      if (e.target === document.getElementById('offersModal')) {
        closeOffersModal();
      }
    }

    function showToast(message, type = 'success') {
      const toast = document.getElementById('checkoutToast');
      toast.textContent = message;
      toast.className = `checkout-toast show ${type}`;
      setTimeout(() => {
        toast.className = 'checkout-toast';
      }, 3500);
    }

    // Apply Coupon directly from list
    async function applyCouponDirect(id, code, value, minOrder, isPercent, maxCap) {

      try {
        const subtotal = getSubtotal();

        if (minOrder && subtotal < minOrder) {
          showToast(`This coupon requires a minimum cart value of ₹${minOrder.toLocaleString('en-IN')}`, 'error');
          return;
        }

        const data = await fetch('/coupon/apply', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            couponId: id
          })
        });

        const result = await data.json();

        if (!result.success) {
          showToast(result.message, 'error');

          return;
        }

        const discountAmount = result.discountAmount;
        const code = result.couponCode;

        couponId = id;

        // Save applied coupon state
        checkoutState.appliedCoupon = { code, discountAmount };

        // Update UI cards
        updateCouponModalUI();
        recalculateSummary();
        closeCouponModal();

        // Update Available Coupons card on sidebar
        document.getElementById('couponCardSub').textContent = `Coupon ${code.toUpperCase()} applied (-₹${discountAmount.toLocaleString('en-IN')})`;
        document.getElementById('couponCardSub').style.color = '#10B981';
        document.getElementById('couponCardSub').style.fontWeight = '700';

        showToast(`Coupon ${code} applied successfully! You saved ₹${discountAmount.toLocaleString('en-IN')}`, 'success');
      }
      catch (err) { }
    }

    const coupons = <%- JSON.stringify(coupons) %>;

    // Apply custom coupon entered in text input
    function applyCustomCoupon() {
      const input = document.getElementById('customCouponInput');
      const code = input.value.trim().toUpperCase();

      if (!code) {
        showToast('Please enter a valid coupon code.', 'error');
        return;
      }

      const match = coupons.find(c => c.couponCode === code);
      if (!match) {
        showToast(`Coupon "${code}" is invalid or expired.`, 'error');
        return;
      }

      const isPercent = match.discountType === 'percent';
      applyCouponDirect(match._id, match.couponCode, match.discountValue, match.mininumPurchase, isPercent, match.maximumDiscount);
      input.value = '';
    }

    // Remove active coupon
    async function removeCoupon() {

      try {
        if (!checkoutState.appliedCoupon) return;
        const code = checkoutState.appliedCoupon.code;

        const data = await fetch('/coupon/remove', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const result = await data.json();

        if (!result.success) {
          showToast(result.message, 'error');
          return;
        }

        checkoutState.appliedCoupon = null;

        updateCouponModalUI();
        recalculateSummary();

        document.getElementById('couponCardSub').textContent = '2 Coupons available';
        document.getElementById('couponCardSub').style.color = '';
        document.getElementById('couponCardSub').style.fontWeight = '';

        showToast(`Coupon ${code} has been removed.`, 'success');
      }
      catch (err) {
        showToast("Something went wrong. Please try again", 'error');
      }
    }

    // Synchronize modal buttons
    function updateCouponModalUI() {
      document.querySelectorAll('.coupon-item-card').forEach(card => {
        card.classList.remove('applied');
        const btn = card.querySelector('.btn-coupon-action');
        if (btn) {
          btn.textContent = 'Apply';
          btn.classList.remove('remove-btn');
        }
      });

      if (checkoutState.appliedCoupon) {
        const activeCard = document.getElementById(`coupon-card-${checkoutState.appliedCoupon.code}`);
        if (activeCard) {
          activeCard.classList.add('applied');
          const btn = activeCard.querySelector('.btn-coupon-action');
          if (btn) {
            btn.textContent = 'Remove';
            btn.classList.add('remove-btn');
            btn.onclick = removeCoupon;
          }
        }
      }
    }

    // Complete Purchase Action
    async function handleCompletePurchase() {
      const selectedAddr = document.querySelector('.address-option-card.selected');
      if (!selectedAddr) {
        showToast('Please select or add a shipping address to proceed.', 'error');
        document.getElementById('stepShippingAddress').scrollIntoView({ behavior: 'smooth' });
        return;
      }

      const btn = document.getElementById('btnCompletePurchase');
      btn.disabled = true;
      btn.innerHTML = `
        <svg class="spinner" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
          <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path>
        </svg>
        <span>Processing Order...</span>
      `;

      const addressId = selectedAddr.dataset.addressId;

      const shippingMethod = checkoutState.shippingCost === 200 ? "express" : "standard";
      const paymentMethod = checkoutState.selectedPaymentMethod === "cod" ? "COD" : "Razorpay";

      const response = await fetch('/checkout/place-order', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          addressId,
          shippingMethod,
          paymentMethod
        })
      });

      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message);
      }

      window.location.href = result.redirectUrl;
    }

    // Initialize on DOM load
    document.addEventListener('DOMContentLoaded', () => {
      // Pick first address as default selected if none selected
      const firstAddr = document.querySelector('.address-option-card.selected') || document.querySelector('.address-option-card');
      if (firstAddr) {
        selectAddress(firstAddr);
      }
      recalculateSummary();
    });
  </script>

</body>

</html>