<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Smartphones · Voltiq' %></title>
  <link rel="stylesheet" href="/css/user/products.css">
</head>
<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <div class="header-left">
      <a href="/" class="brand-logo">voltiq</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/support" class="nav-link">Support</a>
      </nav>
    </div>

    <div class="header-search">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" class="search-input" placeholder="Search..." aria-label="Search products">
    </div>

    <div class="header-actions">
      <a href="/account" class="icon-btn" aria-label="User Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </a>
      <a href="/cart" class="icon-btn" aria-label="Shopping Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </a>
    </div>
  </header>

  <!-- MAIN WRAPPER -->
  <main class="main-wrapper">
    <div class="shop-container">
      
      <!-- SIDEBAR FILTERS -->
      <aside class="shop-sidebar">
        
        <!-- Category Header -->
        <div class="sidebar-header">
          <h2>Categories</h2>
          <p>Browse High-End Gear</p>
        </div>

        <!-- Category Nav Links -->
        <nav class="category-nav">
          <a href="/shop/smartphones" class="category-nav-item active">
            <span class="cat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                <line x1="12" y1="18" x2="12.01" y2="18"></line>
              </svg>
            </span>
            Smartphones
          </a>

          <a href="/shop/laptops" class="category-nav-item">
            <span class="cat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="12" rx="2" ry="2"></rect>
                <line x1="2" y1="20" x2="22" y2="20"></line>
              </svg>
            </span>
            Laptops
          </a>

          <a href="/shop/audio" class="category-nav-item">
            <span class="cat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              </svg>
            </span>
            Audio
          </a>

          <a href="/shop/accessories" class="category-nav-item">
            <span class="cat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            </span>
            Accessories
          </a>

          <a href="#" class="see-more-link">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            See More
          </a>
        </nav>

        <!-- Price Range Filter -->
        <div class="filter-section">
          <span class="filter-title">PRICE RANGE</span>
          <div class="price-slider-box">
            <input type="range" class="range-slider" min="20000" max="200000" value="140000">
            <div class="price-range-labels">
              <span>₹20k</span>
              <span>₹2L+</span>
            </div>
          </div>
        </div>

        <!-- Brand Checkboxes Filter -->
        <div class="filter-section">
          <span class="filter-title">BRAND</span>
          <div class="checkbox-list">
            <label class="checkbox-label">
              <input type="checkbox" checked>
              <span class="custom-checkbox"></span>
              Apple
            </label>
            <label class="checkbox-label">
              <input type="checkbox">
              <span class="custom-checkbox"></span>
              Samsung
            </label>
            <label class="checkbox-label">
              <input type="checkbox">
              <span class="custom-checkbox"></span>
              Google
            </label>
            <label class="checkbox-label">
              <input type="checkbox">
              <span class="custom-checkbox"></span>
              OnePlus
            </label>
            <label class="checkbox-label">
              <input type="checkbox">
              <span class="custom-checkbox"></span>
              Xiaomi
            </label>
            <label class="checkbox-label">
              <input type="checkbox">
              <span class="custom-checkbox"></span>
              Vivo
            </label>
          </div>
        </div>

        <!-- Sort By Dropdown Filter -->
        <div class="filter-section">
          <span class="filter-title">SORT BY</span>
          <select class="sort-select">
            <option value="newest" selected>Newest Arrivals</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="popular">Most Popular</option>
          </select>
        </div>

      </aside>

      <!-- MAIN PRODUCTS AREA -->
      <section class="products-content-area">
        
        <!-- Category Heading Group -->
        <div class="category-heading-group">
          <h1>Smartphones</h1>
          <p>Discover the pinnacle of mobile engineering. Precision-crafted devices designed for those who demand uncompromising performance and atmospheric aesthetics.</p>
        </div>

        <!-- Products Grid (3 Columns) -->
        <div class="products-grid">
          
          <!-- Card 1: iPhone 17 Pro Max -->
          <a href="/product/iphone-17-pro-max" class="product-card">
            <div class="product-image-box">
              <span class="product-badge bestseller">Best Seller</span>
              <img src="/images/avatar.jpg" alt="iPhone 17 Pro Max" class="product-image">
            </div>
            <div class="product-details">
              <h3 class="product-title">iPhone 17 Pro Max</h3>
              <div class="product-footer">
                <span class="product-price">₹1,39,900</span>
                <div class="color-swatches">
                  <span class="swatch-dot black"></span>
                  <span class="swatch-dot purple"></span>
                </div>
              </div>
            </div>
          </a>

          <!-- Card 2: Galaxy S24 Ultra -->
          <a href="/product/galaxy-s24-ultra" class="product-card">
            <div class="product-image-box">
              <span class="product-badge new">New Arrival</span>
              <img src="/images/avatar.jpg" alt="Galaxy S24 Ultra" class="product-image">
            </div>
            <div class="product-details">
              <h3 class="product-title">Galaxy S24 Ultra</h3>
              <div class="product-footer">
                <span class="product-price">₹1,29,999</span>
                <div class="color-swatches">
                  <span class="swatch-dot black"></span>
                  <span class="swatch-dot lavender"></span>
                </div>
              </div>
            </div>
          </a>

          <!-- Card 3: iPhone 17 Pro -->
          <a href="/product/iphone-17-pro" class="product-card">
            <div class="product-image-box">
              <img src="/images/avatar.jpg" alt="iPhone 17 Pro" class="product-image">
            </div>
            <div class="product-details">
              <h3 class="product-title">iPhone 17 Pro</h3>
              <div class="product-footer">
                <span class="product-price">₹1,19,900</span>
                <div class="color-swatches">
                  <span class="swatch-dot lavender"></span>
                </div>
              </div>
            </div>
          </a>

          <!-- Card 4: iPhone 17 -->
          <a href="/product/iphone-17" class="product-card">
            <div class="product-image-box">
              <img src="/images/avatar.jpg" alt="iPhone 17" class="product-image">
            </div>
            <div class="product-details">
              <h3 class="product-title">iPhone 17</h3>
              <div class="product-footer">
                <span class="product-price">₹79,900</span>
              </div>
            </div>
          </a>

          <!-- Card 5: Pixel 9 Pro -->
          <a href="/product/pixel-9-pro" class="product-card">
            <div class="product-image-box">
              <img src="/images/avatar.jpg" alt="Pixel 9 Pro" class="product-image">
            </div>
            <div class="product-details">
              <h3 class="product-title">Pixel 9 Pro</h3>
              <div class="product-footer">
                <span class="product-price">₹1,09,900</span>
                <div class="color-swatches">
                  <span class="swatch-dot mint"></span>
                </div>
              </div>
            </div>
          </a>

          <!-- Card 6: OnePlus 12 -->
          <a href="/product/oneplus-12" class="product-card">
            <div class="product-image-box">
              <img src="/images/avatar.jpg" alt="OnePlus 12" class="product-image">
            </div>
            <div class="product-details">
              <h3 class="product-title">OnePlus 12</h3>
              <div class="product-footer">
                <span class="product-price">₹64,999</span>
              </div>
            </div>
          </a>

        </div>

        <!-- Pagination Controls Wrapper -->
        <div class="pagination-wrapper">
          <a href="#" class="page-btn disabled">&lt;</a>
          <a href="#" class="page-btn active">1</a>
          <a href="#" class="page-btn">2</a>
          <a href="#" class="page-btn">3</a>
          <span style="font-size: 13px; color: #718096; padding: 0 4px;">...</span>
          <a href="#" class="page-btn">10</a>
          <a href="#" class="page-btn">&gt;</a>
        </div>

      </section>

    </div>
  </main>

  <!-- SITE FOOTER -->
  <footer class="site-footer">
    <div class="footer-left">
      <div class="footer-logo">voltiq</div>
      <div class="copyright">© <%= new Date().getFullYear() %> voltiq. Atmospheric Precision in Technology.</div>
    </div>
    <div class="footer-links">
      <a href="/privacy" class="footer-link">Privacy Policy</a>
      <a href="/terms" class="footer-link">Terms of Service</a>
      <a href="/shipping" class="footer-link">Shipping</a>
      <a href="/support" class="footer-link">Support</a>
    </div>
  </footer>

</body>
</html>
