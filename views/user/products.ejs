<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Smartphones · Voltiq' %>
  </title>
  <link rel="stylesheet" href="/css/user/products.css">
</head>

<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <div class="header-left">
      <a href="/" class="brand-logo">voltiq</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/support" class="nav-link">Support</a>
      </nav>
    </div>

    <div class="header-search">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>

      <input type="text" class="search-input" id="productSearch" placeholder="Search..." aria-label="Search products"
        value="<%= search || '' %>">

      <button type="button" class="search-clear" id="searchClear" aria-label="Clear search">
        ×
      </button>
    </div>

    <div class="header-actions">
      <a href="/account" class="icon-btn" aria-label="User Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
          </path>
        </svg>
      </a>
      <a href="/cart" class="icon-btn" aria-label="Shopping Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </a>
    </div>
  </header>

  <!-- MAIN WRAPPER -->
  <main class="main-wrapper">
    <div class="shop-container">

      <!-- SIDEBAR FILTERS -->
      <aside class="shop-sidebar">

        <!-- Category Header -->
        <div class="sidebar-header">
          <h2>Categories</h2>
          <p>Browse High-End Gear</p>
        </div>

        <!-- Category Nav Links -->
        <nav class="category-nav">

          <% categories.forEach((category, index)=> { %>

            <a href="/products/<%= category._id %>" class="category-nav-item <%= index >= 5 ? 'extra-category' : '' %> <%= selectedCategoryId === category._id.toString() ? 'active' : '' %>">

              <span class="cat-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                  <line x1="12" y1="18" x2="12.01" y2="18"></line>
                </svg>
              </span>

              <%= category.categoryName %>

            </a>

            <% }) %>


              <% if (categories.length> 5) { %>

                <a href="javascript:void(0)" class="see-more-link" id="seeMoreBtn">

                  <span>See More</span>

                </a>

                <% } %>

        </nav>

        <!-- Price Range Filter -->
        <div class="filter-section">
          <span class="filter-title">PRICE RANGE</span>
          <div class="price-slider-box">
            <input type="range" class="range-slider" id="priceSlider" min="10000" max="500000" step="10000"
              value="<%= maxPrice || 500000 %>">
            <div class="price-range-labels">
              <span>₹10k</span>
              <span id="maxPriceLabel">₹<%= Number(maxPrice || 500000).toLocaleString('en-IN') %></span>
            </div>
          </div>
        </div>

        <!-- Brand Checkboxes Filter -->
        <div class="filter-section">
          <span class="filter-title">BRAND</span>
          <div class="checkbox-list">
            <% brands.forEach(brand=> { %>
              <label class="checkbox-label">
                <input type="checkbox" class="brand-checkbox" value="<%= brand._id %>" <%=selectedBrands &&
                  selectedBrands.includes(brand._id.toString()) ? 'checked' : '' %>>
                <span class="custom-checkbox"></span>
                <%= brand.name %>
              </label>
              <% }) %>
          </div>
        </div>

        <!-- Sort By Dropdown Filter -->
        <div class="filter-section">
          <span class="filter-title">SORT BY</span>
          <select class="sort-select" id="sortSelect">
            <option value="newest" <%=sort==='newest' ? 'selected' : '' %>>Newest Arrivals</option>
            <option value="price-low" <%=sort==='price-low' ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price-high" <%=sort==='price-high' ? 'selected' : '' %>>Price: High to Low</option>
            <option value="a-z" <%=sort==='a-z' ? 'selected' : '' %>>A - Z</option>
            <option value="z-a" <%=sort==='z-a' ? 'selected' : '' %>>Z - A</option>
          </select>
        </div>

      </aside>

      <!-- MAIN PRODUCTS AREA -->
      <section class="products-content-area">

        <!-- Category Heading Group -->
        <div class="category-heading-group">
          <h1>Smartphones</h1>
          <p>Discover the pinnacle of mobile engineering. Precision-crafted devices designed for those who demand
            uncompromising performance and atmospheric aesthetics.</p>
        </div>

        <% const colorMap={ black: '#1F2937' , obsidian: '#474545' , white: '#FFFFFF' , purple: '#A78BFA' ,
          lavender: '#D8B4FE' , blue: '#3B82F6' , indigo: '#69778a' , blush: '#f4e6f5' , red: '#EF4444' ,
          green: '#22C55E' , sage: '#A9B689' , pistachio: '#98a36a' , mint: '#99F6E4' , yellow: '#FACC15' ,
          orange: '#F97316' , pink: '#F472B6' , silver: '#C0C0C0' , gray: '#6B7280' , grey: '#6B7280' , gold: '#D4AF37'
          , brown: '#92400E' }; %>

          <!-- Products Grid (3 Columns) -->
          <div class="products-grid">

            <% products.forEach((product)=> { %>

              <% const displayVariant=product.displayVariant; %>

                <!-- Card 1: iPhone 17 Pro Max -->
                <a href="/products/<%= product._id %>" class="product-card">
                  <div class="product-image-box">
                    <!-- <span class="product-badge bestseller">Best Seller</span> -->
                    <img src="<%= displayVariant.imgUrls[0] %>" alt="<%= product.name %>" class="product-image">
                  </div>
                  <div class="product-details">
                    <h3 class="product-title">
                      <%= product.name %>
                    </h3>
                    <div class="product-footer">
                      <span class="product-price">₹<%= displayVariant.price.toLocaleString('en-IN') %></span>
                      <div class="color-swatches">

                        <% const displayedColors=new Set(); product.variants.forEach((variant)=> {

                          const colorName = variant.color.trim().toLowerCase();

                          if (displayedColors.has(colorName)) return;
                          displayedColors.add(colorName);

                          const colorValue = colorMap[colorName] || '#CBD5E1';
                          %>

                          <span class="swatch-dot" style="background-color: <%= colorValue %>;"
                            title="<%= variant.color %>"></span>

                          <% }) %>

                      </div>
                    </div>
                  </div>
                </a>
                <% }) %>
          </div>


          <% const paginationParams=new URLSearchParams(); if (search) { paginationParams.set('search', search); } if
            (sort) { paginationParams.set('sort', sort); } if (maxPrice) { paginationParams.set('maxPrice', maxPrice); }
            selectedBrands.forEach(brandId=> {
            paginationParams.append('brands', brandId);
            });
            %>
            <div class="pagination-wrapper">
              <% if (currentPage> 1) { %>
                <a href="?page=<%= currentPage - 1 %>" class="page-btn">
                  &lt;
                </a>
                <% } else { %>
                  <span class="page-btn disabled">
                    &lt;
                  </span>
                  <% } %>
                    <% for (let i=1; i <=totalPages; i++) { %>
                      <a href="?page=<%= i %>" class="page-btn <%= currentPage === i ? 'active' : '' %>">
                        <%= i %>
                      </a>
                      <% } %>

                        <% if (currentPage < totalPages) { %>
                          <a href="?page=<%= currentPage + 1 %>" class="page-btn">
                            &gt;
                          </a>
                          <% } else { %>
                            <span class="page-btn disabled">
                              &gt;
                            </span>
                            <% } %>
            </div>

      </section>

    </div>
  </main>

  <!-- SITE FOOTER -->
  <footer class="site-footer">
    <div class="footer-left">
      <div class="footer-logo">voltiq</div>
      <div class="copyright">© <%= new Date().getFullYear() %> voltiq. Atmospheric Precision in Technology.</div>
    </div>
    <div class="footer-links">
      <a href="/privacy" class="footer-link">Privacy Policy</a>
      <a href="/terms" class="footer-link">Terms of Service</a>
      <a href="/shipping" class="footer-link">Shipping</a>
      <a href="/support" class="footer-link">Support</a>
    </div>
  </footer>

  <script>
    const searchInput = document.getElementById('productSearch');
    const searchClear = document.getElementById('searchClear');

    function updateClearButton() {
      searchClear.style.display =
        searchInput.value.trim() ? 'block' : 'none';
    }

    searchInput.addEventListener('input', updateClearButton);

    searchInput.addEventListener('keydown', (event) => {

      if (event.key === 'Enter') {

        const search = searchInput.value.trim();

        const url = new URL(window.location.href);

        if (search) {
          url.searchParams.set('search', search);
        } else {
          url.searchParams.delete('search');
        }

        window.location.href = url.toString();
      }
    });

    searchClear.addEventListener('click', () => {

      searchInput.value = '';

      const url = new URL(window.location.href);
      url.searchParams.delete('search');

      window.location.href = url.toString();
    });

    updateClearButton();
  </script>

  <script>
    const seeMoreBtn = document.getElementById('seeMoreBtn');
    const extraCategories = document.querySelectorAll('.extra-category');

    function showExtraCategories() {
      extraCategories.forEach(category => {
        category.classList.remove('hidden');
      });

      if (seeMoreBtn) {
        seeMoreBtn.querySelector('span').textContent = 'See Less';
      }
    }

    function hideExtraCategories() {
      extraCategories.forEach(category => {
        category.classList.add('hidden');
      });

      if (seeMoreBtn) {
        seeMoreBtn.querySelector('span').textContent = 'See More';
      }
    }

    // Restore the state after page reload/navigation
    if (sessionStorage.getItem('categoryNavExpanded') === 'true') {
      showExtraCategories();
    } else {
      hideExtraCategories();
    }

    // See More / See Less
    if (seeMoreBtn) {
      seeMoreBtn.addEventListener('click', function () {

        const isExpanded =
          sessionStorage.getItem('categoryNavExpanded') === 'true';

        if (isExpanded) {
          sessionStorage.removeItem('categoryNavExpanded');
          hideExtraCategories();
        } else {
          sessionStorage.setItem('categoryNavExpanded', 'true');
          showExtraCategories();
        }

      });
    }
  </script>

  <script>
    const sortSelect = document.getElementById('sortSelect');

    sortSelect.addEventListener('change', () => {

      const sort = sortSelect.value;

      const url = new URL(window.location.href);

      url.searchParams.set('sort', sort);

      window.location.href = url.toString();
    });
  </script>

  <script>
    const priceSlider = document.getElementById('priceSlider');
    const maxPriceLabel = document.getElementById('maxPriceLabel');

    priceSlider.addEventListener('input', () => {

      const value = Number(priceSlider.value);

      maxPriceLabel.textContent =
        `₹${value.toLocaleString('en-IN')}`;
    });

    priceSlider.addEventListener('change', () => {

      const url = new URL(window.location.href);

      url.searchParams.set('maxPrice', priceSlider.value);

      window.location.href = url.toString();
    });
  </script>

  <script>
    const brandCheckboxes =
      document.querySelectorAll('.brand-checkbox');

    brandCheckboxes.forEach(checkbox => {

      checkbox.addEventListener('change', () => {

        const url = new URL(window.location.href);

        // Remove existing brand filters
        url.searchParams.delete('brands');

        // Get currently selected brands
        const selectedBrands = Array.from(
          document.querySelectorAll('.brand-checkbox:checked')
        ).map(checkbox => checkbox.value);

        // Add selected brands
        selectedBrands.forEach(brandId => {
          url.searchParams.append('brands', brandId);
        });

        window.location.href = url.toString();
      });

    });
  </script>

</body>

</html>