<%
// ---- Data (passed in from the route as `locals`) ----
// Use locals.xxx (not `typeof xxx !== 'undefined' ? xxx : ...`) to avoid
// EJS's `with(locals)` temporal-dead-zone ReferenceError on self-reference.
const user = locals.user || {
  name: 'Faslul Farisa',
  tier: 'Premium Member',
  avatar: 'https://i.pravatar.cc/80?img=68'
};
const personalInfo = locals.personalInfo || {
  fullName: 'Arjun Malhotra',
  email: 'arjun.m@voltiq.com',
  phone: '9876543210',
  avatar: 'https://i.pravatar.cc/160?img=68'
};
const error = locals.error || null;
const success = locals.success || null;
%><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Personal Info · Voltiq</title>
<link rel="stylesheet" href="/css/user/edit-profile.css">
</head>
<body>

<!-- ============ TOP NAV ============ -->
<header class="topnav">
  <div class="topnav-inner">
    <a href="/" class="brand">voltiq</a>
    <nav class="main-links">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/support">Support</a>
    </nav>
    <div class="search">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <span>Search premium electronics...</span>
    </div>
    <div class="topnav-icons">
      <a href="/account" class="icon-btn">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="/wishlist" class="icon-btn">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
      </a>
      <a href="/cart" class="icon-btn">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.5 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 8H6"/></svg>
      </a>
    </div>
  </div>
</header>

<div class="layout">

  <!-- ============ SIDEBAR ============ -->
  <aside class="sidebar">
    <div class="profile-card">
      <img class="profile-avatar" src="<%= user.avatar %>" alt="<%= user.name %>">
      <div class="profile-text">
        <span class="profile-name"><%= user.name %></span>
        <span class="profile-tier"><%= user.tier %></span>
      </div>
    </div>

    <form action="/logout" method="POST">
      <button type="submit" class="logout-btn">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Logout
      </button>
    </form>

    <nav class="account-nav">
      <a href="/account" class="account-nav-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        Account Overview
      </a>
      <a href="/account/personal" class="account-nav-item active">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Personal Info
      </a>
      <a href="/account/orders" class="account-nav-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        Order History
      </a>
      <a href="/account/addresses" class="account-nav-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        Saved Addresses
      </a>
      <a href="/account/wallet" class="account-nav-item">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M17 15h.01"/></svg>
        Wallet
      </a>
    </nav>
  </aside>

  <!-- ============ MAIN ============ -->
  <main class="main">

    <a href="/account/personal" class="back-link">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Back to Personal Info
    </a>

    <section class="panel">
      <div class="panel-head">
        <div>
          <h1 class="panel-title">Edit Personal Information</h1>
          <p class="panel-sub">update your account details below.</p>
        </div>
      </div>

      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="edit-form">

        <div class="form-grid">

          <div class="field">
            <label for="fullName">FULL NAME</label>
            <div class="input-wrap">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <input type="text" id="fullName" name="fullName" value="<%= personalInfo.fullName %>" placeholder="Enter your full name" required>
            </div>
          </div>

          <div class="field">
            <label for="email">EMAIL ADDRESS</label>
            <div class="input-wrap">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
              <input type="email" id="email" name="email" value="<%= personalInfo.email %>" placeholder="Enter your email" required>
            </div>
          </div>

          <div class="field">
            <label for="phone">PHONE NUMBER</label>
            <div class="input-wrap">
              <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.4 2.1L8.1 9.7a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.9 2.2Z"/></svg>
              <input type="tel" id="phone" name="phoneNumber" value="<%= personalInfo.phone %>" placeholder="Enter your phone number" required>
            </div>
          </div>

          <div class="field">
            <label>PROFILE PICTURE</label>
            <div class="avatar-input-wrap" id="avatarFieldWrap" tabindex="0" role="button" aria-label="Change profile picture">
              <img id="avatarPreview" class="avatar-thumb" src="<%= personalInfo.avatar %>" alt="">
              <span class="avatar-input-text" id="avatarFileName">Change Photo</span>
              <svg class="avatar-camera-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2Z"/><circle cx="12" cy="13" r="4"/></svg>
              <input type="file" id="avatarInput" name="avatar" accept="image/png, image/jpeg, image/gif" hidden>
            </div>
          </div>

        </div>

        <div class="form-actions">
          <a href="/account/personal" class="btn-cancel">Cancel</a>
          <button type="submit" class="btn-save">
            Save Changes
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </button>
        </div>

      </form>
    </section>

  </main>
</div>

<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <div class="footer-brand">voltiq</div>
      <p class="footer-copy">© <%= new Date().getFullYear() %> voltiq. atmospheric precision.</p>
    </div>
    <div class="footer-links">
      <a href="/privacy">PRIVACY</a>
      <a href="/terms">TERMS</a>
      <a href="/sustainability">SUSTAINABILITY</a>
      <a href="/careers">CAREERS</a>
    </div>
  </div>
</footer>

<script>
  // ---- Profile picture: click-to-upload with live preview ----
  const avatarInput = document.getElementById('avatarInput');
  const avatarPreview = document.getElementById('avatarPreview');
  const avatarFieldWrap = document.getElementById('avatarFieldWrap');
  const avatarFileName = document.getElementById('avatarFileName');

  function openFilePicker() {
    avatarInput.click();
  }
  avatarFieldWrap.addEventListener('click', openFilePicker);
  avatarFieldWrap.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      openFilePicker();
    }
  });

  avatarInput.addEventListener('change', function () {
    const file = avatarInput.files && avatarInput.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function (e) {
      avatarPreview.src = e.target.result;
    };
    reader.readAsDataURL(file);
    avatarFileName.textContent = file.name;
  });
</script>

</body>
</html>
