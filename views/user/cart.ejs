<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Your Bag · Voltiq' %></title>
  <link rel="stylesheet" href="/css/user/cart.css">
</head>
<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <div class="header-left">
      <a href="/" class="brand-logo">voltiq</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/support" class="nav-link">Support</a>
      </nav>
    </div>

    <div class="header-search">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" class="search-input" placeholder="Search..." aria-label="Search products">
    </div>

    <div class="header-actions">
      <a href="/account" class="icon-btn" aria-label="User Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <a href="/wishlist" class="icon-btn" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </a>
      
      <!-- Cart Active Pill with Badge -->
      <a href="/cart" class="icon-btn active" aria-label="Shopping Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count-badge">2</span>
      </a>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="main-container">
    
    <!-- PAGE HEADING -->
    <h1 class="page-title-heading">Your Bag</h1>

    <!-- 2-COLUMN CART LAYOUT -->
    <div class="cart-layout-grid">
      
      <!-- LEFT COLUMN: CART ITEMS LIST -->
      <div class="cart-items-list" id="cartItemsList">
        
        <!-- Cart Item 1: iPhone 17 -->
        <div class="cart-item-card" data-price="79900">
          <div class="item-thumb-box">
            <img src="/images/avatar.jpg" alt="iPhone 17">
          </div>

          <div class="item-details-box">
            <div class="item-header-row">
              <div class="item-info">
                <h3>iPhone 17</h3>
                <p>Lilac, 256GB</p>
              </div>
              <span class="item-price">₹79,900</span>
            </div>

            <div class="item-controls-row">
              <div class="qty-pill">
                <button type="button" class="qty-btn" onclick="updateQty(this, -1)">-</button>
                <span class="qty-val">1</span>
                <button type="button" class="qty-btn" onclick="updateQty(this, 1)">+</button>
              </div>

              <button type="button" class="btn-remove-item" onclick="removeCartItem(this)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                Remove
              </button>
            </div>
          </div>
        </div>

        <!-- Cart Item 2: iPad Pro M4 -->
        <div class="cart-item-card" data-price="99900">
          <div class="item-thumb-box">
            <img src="/images/avatar.jpg" alt="iPad Pro M4">
          </div>

          <div class="item-details-box">
            <div class="item-header-row">
              <div class="item-info">
                <h3>iPad Pro M4</h3>
                <p>Silver Titanium, 512GB</p>
              </div>
              <span class="item-price">₹99,900</span>
            </div>

            <div class="item-controls-row">
              <div class="qty-pill">
                <button type="button" class="qty-btn" onclick="updateQty(this, -1)">-</button>
                <span class="qty-val">1</span>
                <button type="button" class="qty-btn" onclick="updateQty(this, 1)">+</button>
              </div>

              <button type="button" class="btn-remove-item" onclick="removeCartItem(this)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                Remove
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: ORDER SUMMARY + ASSISTANCE -->
      <div class="cart-summary-column">
        
        <!-- Order Summary Card -->
        <div class="summary-card">
          <h2 class="summary-title">Order Summary</h2>

          <div class="summary-lines" id="summaryLines">
            <div class="summary-line-item">
              <span>iPhone 17 (x1)</span>
              <span class="amount">₹79,900</span>
            </div>
            <div class="summary-line-item">
              <span>iPad Pro M4 (x1)</span>
              <span class="amount">₹99,900</span>
            </div>
          </div>

          <div class="summary-divider"></div>

          <div class="summary-total-row">
            <span class="summary-total-label">Total</span>
            <span class="summary-total-amount" id="cartTotalAmount">₹1,79,800</span>
          </div>

          <button type="button" class="btn-checkout" onclick="proceedToCheckout()">
            Checkout
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>

          <div class="secure-checkout-text">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Secure Checkout
          </div>
        </div>

        <!-- Need Assistance Card -->
        <div class="assistance-card">
          <div class="assistance-icon-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <div class="assistance-content">
            <h4 class="assistance-title">Need assistance?</h4>
            <p class="assistance-text">Our specialist team is available 24/7 to help with your purchase.</p>
            <a href="/support" class="assistance-link">Chat with us</a>
          </div>
        </div>

      </div>

    </div>

    <!-- ESSENTIALS / COMPLETE YOUR LOOK SECTION -->
    <section class="essentials-section">
      <span class="essentials-sub-label">ESSENTIALS</span>
      <h2 class="essentials-heading">Complete Your Look</h2>

      <div class="essentials-grid">
        
        <!-- Card 1: Apple Watch Ultra 2 -->
        <div class="essential-card">
          <div class="essential-thumb-box">
            <span class="essential-badge">Ecosystem</span>
            <img src="/images/avatar.jpg" alt="Apple Watch Ultra 2">
          </div>
          <div class="essential-body">
            <h3 class="essential-title">Apple Watch Ultra 2</h3>
            <p class="essential-desc">Titanium case with Dark Purple Ocean Band. Precision...</p>
          </div>
          <div class="essential-footer">
            <span class="essential-price">₹89,900</span>
            <button type="button" class="btn-circle-add" aria-label="Add to Bag" onclick="addEssential('Apple Watch Ultra 2')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Card 2: AirPods Max -->
        <div class="essential-card">
          <div class="essential-thumb-box">
            <span class="essential-badge">Premium Audio</span>
            <img src="/images/avatar.jpg" alt="AirPods Max">
          </div>
          <div class="essential-body">
            <h3 class="essential-title">AirPods Max</h3>
            <p class="essential-desc">Space Grey & Soft Purple finish. Immersive high-fidelity sound...</p>
          </div>
          <div class="essential-footer">
            <span class="essential-price">₹59,900</span>
            <button type="button" class="btn-circle-add" aria-label="Add to Bag" onclick="addEssential('AirPods Max')">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Card 3: voltiq Care+ -->
        <div class="service-info-card">
          <div class="service-icon-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>voltiq Care+</h3>
          <p>Protect your new devices with extended warranty and coverage.</p>
          <a href="/care" class="service-link">Learn More</a>
        </div>

        <!-- Card 4: Trade-in -->
        <div class="service-info-card">
          <div class="service-icon-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
            </svg>
          </div>
          <h3>Trade-in</h3>
          <p>Get credit for your old device towards your next voltiq purchase.</p>
          <a href="/trade-in" class="service-link">Estimate Value</a>
        </div>

      </div>
    </section>

  </main>

  <!-- SITE FOOTER -->
  <footer class="site-footer">
    <div class="footer-left">
      <div class="footer-logo">voltiq</div>
      <div class="copyright">© <%= new Date().getFullYear() %> voltiq. Atmospheric Precision in Technology.</div>
    </div>

    <div class="footer-links">
      <a href="/privacy" class="footer-link">Privacy Policy</a>
      <a href="/terms" class="footer-link">Terms of Service</a>
      <a href="/shipping" class="footer-link">Shipping</a>
      <a href="/support" class="footer-link">Support</a>
    </div>
  </footer>

  <!-- CLIENT INTERACTION SCRIPT -->
  <script>
    function updateQty(btn, change) {
      const qtySpan = btn.parentElement.querySelector('.qty-val');
      let currentVal = parseInt(qtySpan.textContent);
      currentVal += change;
      if (currentVal < 1) currentVal = 1;
      qtySpan.textContent = currentVal;
      recalculateCart();
    }

    function removeCartItem(btn) {
      if (confirm('Remove item from your bag?')) {
        const itemCard = btn.closest('.cart-item-card');
        itemCard.style.opacity = '0';
        itemCard.style.transform = 'translateY(-10px)';
        setTimeout(() => {
          itemCard.remove();
          recalculateCart();
        }, 200);
      }
    }

    function recalculateCart() {
      const cards = document.querySelectorAll('.cart-item-card');
      let total = 0;
      cards.forEach(card => {
        const price = parseInt(card.getAttribute('data-price'));
        const qty = parseInt(card.querySelector('.qty-val').textContent);
        total += (price * qty);
      });

      document.getElementById('cartTotalAmount').textContent = '₹' + total.toLocaleString('en-IN');
    }

    function proceedToCheckout() {
      alert('Proceeding to checkout...');
    }

    function addEssential(name) {
      alert(`${name} added to your bag!`);
    }
  </script>

</body>
</html>
