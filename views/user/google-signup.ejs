<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sign up with Google · Voltiq' %></title>
  <link rel="stylesheet" href="/css/user/google-signup.css">
</head>
<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <a href="/" class="brand-logo">voltiq</a>
    <button class="help-btn" aria-label="Help & Support" onclick="location.href='/support'">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
        <line x1="12" y1="17" x2="12.01" y2="17"></line>
      </svg>
    </button>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="main-content">
    <div class="google-signup-card">
      
      <!-- Google Logo -->
      <div class="google-icon-wrapper">
        <svg class="google-svg-logo" viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.66 0 6.84 5.37 3.08 13.16l7.98 6.19C12.95 13.43 17.99 9.5 24 9.5z"></path>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path>
          <path fill="#FBBC05" d="M11.06 28.65c-.52-1.57-.81-3.26-.81-5c0-1.74.29-3.43.81-5l-7.98-6.19C1.18 15.48 0 19.58 0 23.65c0 4.07 1.18 8.17 3.08 11.19l7.98-6.19z"></path>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.01 0-11.05-3.93-12.94-9.85l-7.98 6.19C6.84 42.63 14.66 48 24 48z"></path>
        </svg>
      </div>

      <!-- Card Title & Subtitle -->
      <h1 class="card-title">Sign up with Google</h1>
      <p class="card-subtitle">Choose an account to continue to <span class="brand-highlight">voltiq</span></p>

      <!-- Account Options List -->
      <div class="account-options-list">
        
        <!-- Account Option 1: Existing Google Account -->
        <a href="<%= typeof googleAuthUrl !== 'undefined' ? googleAuthUrl : '/auth/google/callback' %>" class="account-option-row">
          <div class="option-left">
            <img src="<%= typeof user !== 'undefined' && user.avatar ? user.avatar : '/images/female_avatar.jpg' %>" alt="Profile Picture" class="user-avatar-img">
            <div class="user-info">
              <span class="user-name"><%= typeof user !== 'undefined' && user.name ? user.name : 'Faslul Farisa' %></span>
              <span class="user-email"><%= typeof user !== 'undefined' && user.email ? user.email : 'faslulfarisa7@gmail.com' %></span>
            </div>
          </div>
          <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

        <!-- Account Option 2: Use another account -->
        <a href="<%= typeof googleAuthUrl !== 'undefined' ? googleAuthUrl : '/auth/google/select' %>" class="account-option-row">
          <div class="option-left">
            <div class="user-avatar-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <span class="option-action-text">Use another account</span>
          </div>
          <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>

      </div>

      <!-- Consent Notice -->
      <p class="disclaimer-text">
        To continue, Google will share your name, email address, language preference, and profile picture with voltiq.
      </p>

      <!-- Card Footer Bar -->
      <div class="card-footer-bar">
        <div class="language-dropdown">
          <select class="language-select" aria-label="Select Language">
            <option value="en-US" selected>English (United States)</option>
            <option value="en-GB">English (United Kingdom)</option>
            <option value="es">Español</option>
            <option value="fr">Français</option>
          </select>
          <span class="select-arrow">▾</span>
        </div>

        <div class="card-footer-links">
          <a href="/support" class="card-footer-link">Help</a>
          <a href="/privacy" class="card-footer-link">Privacy</a>
          <a href="/terms" class="card-footer-link">Terms</a>
        </div>
      </div>

    </div>
  </main>

  <!-- SITE FOOTER -->
  <footer class="site-footer">
    <div class="footer-brand">voltiq</div>
    <div class="footer-copyright">
      © <%= new Date().getFullYear() %> Voltiq Electronics. All rights reserved.
    </div>
    <div class="site-footer-links">
      <a href="/privacy" class="site-footer-link">Privacy Policy</a>
      <a href="/terms" class="site-footer-link">Terms of Service</a>
      <a href="/support" class="site-footer-link">Help Center</a>
    </div>
  </footer>

</body>
</html>
