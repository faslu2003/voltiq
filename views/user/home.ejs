<%
// ---- Data (passed in from the route as `locals`) ----
// Use locals.xxx (not `typeof xxx !== 'undefined' ? xxx : ...`) to avoid
// EJS's `with(locals)` temporal-dead-zone ReferenceError on self-reference.
const categories = locals.categories || [
  { name: 'Smartphones', icon: 'smartphone' },
  { name: 'Laptops', icon: 'laptop' },
  { name: 'Audio', icon: 'headphones' },
  { name: 'Accessories', icon: 'watch' }
];

const flagships = locals.flagships || [
  {
    name: 'iPhone 17 Pro',
    tagline: 'Titanium Excellence',
    price: '1,39,900',
    badges: ['NEW', '5G'],
    image: 'https://images.unsplash.com/photo-1591337676887-a217a6970a8a?q=80&w=600&auto=format&fit=crop'
  },
  {
    name: 'MacBook Air M5',
    tagline: 'Thin. Light. Mighty.',
    price: '99,900',
    badges: ['BEST SELLER'],
    image: 'https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?q=80&w=600&auto=format&fit=crop'
  },
  {
    name: 'Galaxy S26',
    tagline: 'Visionary Precision',
    price: '79,900',
    badges: ['LIMITED'],
    image: 'https://images.unsplash.com/photo-1610945415295-d9bbf067e59c?q=80&w=600&auto=format&fit=crop'
  },
  {
    name: 'AirPods Max',
    tagline: 'Spatial Audio Art',
    price: '59,900',
    badges: ['HIFI'],
    image: 'https://images.unsplash.com/photo-1618366712010-f4ae9c647dcb?q=80&w=600&auto=format&fit=crop'
  }
];

const features = locals.features || [
  {
    title: 'Secure',
    desc: 'End-to-end encrypted transactions and extended hardware protection plans.',
    icon: 'shield'
  },
  {
    title: 'Instant',
    desc: 'Next-day delivery on all flagship units with real-time atmospheric tracking.',
    icon: 'zap'
  },
  {
    title: '24/7 Help',
    desc: 'Our expert tech curators are available around the clock for precision support.',
    icon: 'headset'
  }
];
%><!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>voltiq · The Future of Tech, Refined.</title>
<link rel="stylesheet" href="/css/user/home.css">
</head>
<body>

<!-- ============ TOP NAV ============ -->
<header class="topnav">
  <div class="topnav-inner">
    <a href="/" class="brand">voltiq</a>
    <nav class="main-links">
      <a href="/" class="active">Home</a>
      <a href="/new-arrivals">New Arrivals</a>
      <a href="/support">Support</a>
    </nav>
    <div class="search">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <span>Search...</span>
    </div>
    <div class="topnav-icons">
      <a href="/profile" class="icon-btn">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="/wishlist" class="icon-btn">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
      </a>
      <a href="/cart" class="icon-btn">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.5 3h2l2.4 12.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.6L21 8H6"/></svg>
      </a>
    </div>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero">
  <img class="hero-bg" src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?q=80&w=1600&auto=format&fit=crop" alt="">
  <div class="hero-overlay"></div>
  <div class="hero-inner">
    <h1 class="hero-title">The Future of Tech,<br><em>Refined.</em></h1>
    <p class="hero-sub">Discover the latest flagship devices from iPhone, MacBook, and Samsung. Engineered for performance, designed for clarity.</p>
    <div class="hero-actions">
      <a href="/shop" class="btn-solid">Shop Now</a>
      <a href="/collections" class="btn-outline-light">Explore Collection</a>
    </div>
  </div>
</section>

<!-- ============ CATEGORY STRIP ============ -->
<section class="categories">
  <div class="categories-inner">
    <% categories.forEach(function(cat){ %>
      <a href="/category/<%= cat.name.toLowerCase() %>" class="category-card">
        <span class="category-icon">
          <% if (cat.icon === 'smartphone') { %>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
          <% } else if (cat.icon === 'laptop') { %>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="1"/><path d="M2 20h20"/></svg>
          <% } else if (cat.icon === 'headphones') { %>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14v-3a9 9 0 0 1 18 0v3"/><rect x="2" y="14" width="5" height="7" rx="1.5"/><rect x="17" y="14" width="5" height="7" rx="1.5"/></svg>
          <% } else if (cat.icon === 'watch') { %>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M9 7V4h6v3"/><path d="M9 17v3h6v-3"/></svg>
          <% } %>
        </span>
        <span class="category-name"><%= cat.name %></span>
      </a>
    <% }); %>
  </div>
</section>

<!-- ============ LATEST FLAGSHIPS ============ -->
<section class="flagships">
  <div class="section-inner">
    <div class="section-head">
      <div>
        <h2 class="section-title">Latest Flagships</h2>
        <p class="section-sub">The pinnacle of engineering, now within reach.</p>
      </div>
      <a href="/products" class="link-view-all">
        View All Products
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="product-grid">
      <% flagships.forEach(function(p){ %>
        <a href="/product/<%= p.name.toLowerCase().replace(/\s+/g,'-') %>" class="product-card">
          <div class="product-image-wrap">
            <img src="<%= p.image %>" alt="<%= p.name %>">
          </div>
          <div class="product-badges">
            <% p.badges.forEach(function(b){ %><span class="badge"><%= b %></span><% }); %>
          </div>
          <h3 class="product-name"><%= p.name %></h3>
          <p class="product-tagline"><%= p.tagline %></p>
          <p class="product-price">₹<%= p.price %></p>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============ PROMO BANNER ============ -->
<section class="promo-section">
  <div class="promo-card">
    <span class="promo-pill">LIMITED TIME OFFER</span>
    <h2 class="promo-title">Level up your setup.</h2>
    <p class="promo-sub">Get 20% off all flagship accessories when you bundle with a smartphone or laptop. Use code: <strong>VOLT20</strong></p>
    <a href="/shop/accessories" class="btn-solid">Shop Accessories</a>
  </div>
</section>

<!-- ============ FEATURES ============ -->
<section class="features">
  <div class="features-inner">
    <% features.forEach(function(f){ %>
      <div class="feature-item">
        <span class="feature-icon">
          <% if (f.icon === 'shield') { %>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
          <% } else if (f.icon === 'zap') { %>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
          <% } else if (f.icon === 'headset') { %>
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 14v-3a9 9 0 0 1 18 0v3"/><rect x="2" y="14" width="5" height="7" rx="1.5"/><rect x="17" y="14" width="5" height="7" rx="1.5"/><path d="M19 21a3 3 0 0 1-3 2h-2"/></svg>
          <% } %>
        </span>
        <h3 class="feature-title"><%= f.title %></h3>
        <p class="feature-desc"><%= f.desc %></p>
      </div>
    <% }); %>
  </div>
</section>

<!-- ============ FOOTER ============ -->
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-about">
      <span class="footer-brand">voltiq</span>
      <p>Atmospheric Precision in Electronics. Elevating the standard of digital lifestyle through curated flagship innovation.</p>
    </div>

    <div class="footer-col">
      <h4>Shop</h4>
      <a href="/category/smartphones">Smartphones</a>
      <a href="/category/laptops">Laptops</a>
      <a href="/category/audio">Audio</a>
    </div>

    <div class="footer-col">
      <h4>Company</h4>
      <a href="/sustainability">Sustainability</a>
      <a href="/store-locator">Store Locator</a>
      <a href="/privacy">Privacy Policy</a>
    </div>

    <div class="footer-col">
      <h4>Support</h4>
      <a href="/support">Support Center</a>
      <a href="/terms">Terms of Service</a>
      <div class="footer-icons">
        <a href="/language" class="footer-icon-btn" aria-label="Language">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"/></svg>
        </a>
        <a href="/chat" class="footer-icon-btn" aria-label="Chat support">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <span class="footer-copy">© <%= new Date().getFullYear() %> voltiq. Atmospheric Precision in Electronics.</span>
    <div class="footer-locale">
      <a href="/settings/language">English (US)</a>
      <a href="/settings/currency">INR (₹)</a>
    </div>
  </div>
</footer>

</body>
</html>
