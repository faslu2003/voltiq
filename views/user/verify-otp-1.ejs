<%
// ---- Data (passed in from the route as `locals`) ----
// Use locals.xxx (not `typeof xxx !== 'undefined' ? xxx : ...`) to avoid
// EJS's `with(locals)` temporal-dead-zone ReferenceError on self-reference.
const codeLength = locals.codeLength || 6;
const resendSeconds = locals.resendSeconds || 58;
const error = locals.error || null;
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email</title>

    <link rel="stylesheet" href="/css/user/verify-otp.css">
</head>

<body>

    <!-- Dark Blurred Background -->
    <div class="overlay">

        <!-- Verification Card -->
        <div class="verification-card">

            <!-- Email Icon -->
            <div class="icon-wrapper">

                <svg width="38" height="38" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">

                    <path d="M4 6H20V18H4V6Z" stroke="#694CAC" stroke-width="1.7" stroke-linejoin="round" />

                    <path d="M4 7L12 13L20 7" stroke="#694CAC" stroke-width="1.7" stroke-linecap="round"
                        stroke-linejoin="round" />

                </svg>

            </div>

            <!-- Heading -->
            <h1>Verify Your Email</h1>

            <!-- Description -->
            <p class="description">
                We've sent a 6-digit verification code to
                <span>faslul@example.com</span>.
                Enter it below to confirm your identity.
            </p>

            <!-- OTP Form -->
            <form action="/email/verify-otp-1" method="POST">

                <div class="otp-container">

                    <input
                        type="text"
                        maxlength="1"
                        class="otp-input"
                        name="otp1"
                    >

                    <input
                        type="text"
                        maxlength="1"
                        class="otp-input"
                        name="otp2"
                    >

                    <input
                        type="text"
                        maxlength="1"
                        class="otp-input"
                        name="otp3"
                    >

                    <input
                        type="text"
                        maxlength="1"
                        class="otp-input"
                        name="otp4"
                    >

                    <input
                        type="text"
                        maxlength="1"
                        class="otp-input"
                        name="otp5"
                    >

                    <input
                        type="text"
                        maxlength="1"
                        class="otp-input"
                        name="otp6"
                    >

                </div>

                <button type="submit" class="verify-btn">
                    Verify &amp; Continue
                </button>

            </form>

            <!-- Timer -->
            <p class="timer">

                Didn't receive the code?

                <a href="#">
                    Resend in 00:52
                </a>

            </p>

            <!-- Divider -->
            <div class="divider">
                <span></span>
                <p>OR</p>
                <span></span>
            </div>

            <!-- Back Link -->
            <a href="/profile" class="back-link">

                ← Back to Profile Settings

            </a>

        </div>

    </div>

</body>

</html>