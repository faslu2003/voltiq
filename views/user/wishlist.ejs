<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Your Wishlist · Voltiq' %></title>
  <link rel="stylesheet" href="/css/user/wishlist.css">
</head>
<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <div class="header-left">
      <a href="/" class="brand-logo">voltiq</a>
      <nav class="main-nav">
        <a href="/" class="nav-link">Home</a>
        <a href="/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/support" class="nav-link">Support</a>
      </nav>
    </div>

    <div class="header-search">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" class="search-input" placeholder="Search..." aria-label="Search products">
    </div>

    <div class="header-actions">
      <a href="/account" class="icon-btn" aria-label="User Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>
      
      <!-- Wishlist Active Pill -->
      <a href="/wishlist" class="icon-btn active" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </a>

      <a href="/cart" class="icon-btn" aria-label="Shopping Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </a>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="main-container">
    
    <!-- PAGE HEADING -->
    <div class="page-heading-group">
      <h1>Your Wishlist</h1>
      <p>Manage your saved favorites and complete your atmospheric tech collection.</p>
    </div>

    <!-- WISHLIST ITEMS GRID (4 COLUMNS) -->
    <section class="wishlist-grid" id="wishlistGrid">
      
      <!-- Card 1: iPhone 17 -->
      <div class="wishlist-card">
        <div class="card-image-box">
          <span class="stock-badge">In Stock</span>
          <img src="/images/avatar.jpg" alt="iPhone 17" class="card-image">
        </div>
        <div class="card-body">
          <h3 class="card-title">iPhone 17</h3>
          <span class="card-subtitle">256GB, LILAC</span>
          <span class="card-price">₹79,900</span>
        </div>
        <div class="card-actions-row">
          <button type="button" class="btn-add-cart" onclick="moveToCart(this, 'iPhone 17')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add to Cart
          </button>
          <button type="button" class="btn-remove-item" title="Remove from Wishlist" onclick="removeFromWishlist(this)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Card 2: iPad Pro M4 -->
      <div class="wishlist-card">
        <div class="card-image-box">
          <span class="stock-badge">In Stock</span>
          <img src="/images/avatar.jpg" alt="iPad Pro M4" class="card-image">
        </div>
        <div class="card-body">
          <h3 class="card-title">iPad Pro M4</h3>
          <span class="card-subtitle">512GB, SILVER</span>
          <span class="card-price">₹99,900</span>
        </div>
        <div class="card-actions-row">
          <button type="button" class="btn-add-cart" onclick="moveToCart(this, 'iPad Pro M4')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add to Cart
          </button>
          <button type="button" class="btn-remove-item" title="Remove from Wishlist" onclick="removeFromWishlist(this)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Card 3: MacBook Air M5 -->
      <div class="wishlist-card">
        <div class="card-image-box">
          <span class="stock-badge">In Stock</span>
          <img src="/images/avatar.jpg" alt="MacBook Air M5" class="card-image">
        </div>
        <div class="card-body">
          <h3 class="card-title">MacBook Air M5</h3>
          <span class="card-subtitle">16GB UNIFIED MEMORY</span>
          <span class="card-price">₹1,14,900</span>
        </div>
        <div class="card-actions-row">
          <button type="button" class="btn-add-cart" onclick="moveToCart(this, 'MacBook Air M5')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add to Cart
          </button>
          <button type="button" class="btn-remove-item" title="Remove from Wishlist" onclick="removeFromWishlist(this)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Card 4: Watch Ultra 2 -->
      <div class="wishlist-card">
        <div class="card-image-box">
          <span class="stock-badge">In Stock</span>
          <img src="/images/avatar.jpg" alt="Watch Ultra 2" class="card-image">
        </div>
        <div class="card-body">
          <h3 class="card-title">Watch Ultra 2</h3>
          <span class="card-subtitle">TITANIUM, PURPLE BAND</span>
          <span class="card-price">₹89,900</span>
        </div>
        <div class="card-actions-row">
          <button type="button" class="btn-add-cart" onclick="moveToCart(this, 'Watch Ultra 2')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add to Cart
          </button>
          <button type="button" class="btn-remove-item" title="Remove from Wishlist" onclick="removeFromWishlist(this)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
            </svg>
          </button>
        </div>
      </div>

    </section>

    <!-- RECOMMENDED FOR YOU SECTION -->
    <section class="recommended-section">
      <div class="recommended-header">
        <h2>Recommended for you</h2>
        <a href="/shop" class="link-view-shop">View Shop →</a>
      </div>

      <div class="recommended-grid">
        
        <!-- Rec Card 1: AirPods Max -->
        <div class="rec-card">
          <div class="rec-image-box">
            <img src="/images/avatar.jpg" alt="AirPods Max" class="rec-image">
          </div>
          <div class="rec-details">
            <h3 class="rec-title">AirPods Max</h3>
            <span class="rec-price">₹59,900</span>
          </div>
          <button type="button" class="btn-quick-add" onclick="quickAdd('AirPods Max')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add
          </button>
        </div>

        <!-- Rec Card 2: Apple AirTag -->
        <div class="rec-card">
          <div class="rec-image-box">
            <img src="/images/avatar.jpg" alt="Apple AirTag" class="rec-image">
          </div>
          <div class="rec-details">
            <h3 class="rec-title">Apple AirTag</h3>
            <span class="rec-price">₹3,490</span>
          </div>
          <button type="button" class="btn-quick-add" onclick="quickAdd('Apple AirTag')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add
          </button>
        </div>

        <!-- Rec Card 3: Sony A7R V -->
        <div class="rec-card">
          <div class="rec-image-box">
            <img src="/images/avatar.jpg" alt="Sony A7R V" class="rec-image">
          </div>
          <div class="rec-details">
            <h3 class="rec-title">Sony A7R V</h3>
            <span class="rec-price">₹3,49,900</span>
          </div>
          <button type="button" class="btn-quick-add" onclick="quickAdd('Sony A7R V')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add
          </button>
        </div>

        <!-- Rec Card 4: Samsung S26 -->
        <div class="rec-card">
          <div class="rec-image-box">
            <img src="/images/avatar.jpg" alt="Samsung S26" class="rec-image">
          </div>
          <div class="rec-details">
            <h3 class="rec-title">Samsung S26</h3>
            <span class="rec-price">₹1,24,900</span>
          </div>
          <button type="button" class="btn-quick-add" onclick="quickAdd('Samsung S26')">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            Add
          </button>
        </div>

      </div>
    </section>

  </main>

  <!-- SITE FOOTER -->
  <footer class="site-footer">
    <div class="footer-left">
      <div class="footer-logo">voltiq</div>
      <div class="copyright">© <%= new Date().getFullYear() %> voltiq. atmospheric precision.</div>
    </div>

    <div class="footer-center-links">
      <a href="/privacy" class="footer-link">Privacy Policy</a>
      <a href="/terms" class="footer-link">Terms of Service</a>
      <a href="/shipping" class="footer-link">Shipping Info</a>
      <a href="/contact" class="footer-link">Contact Us</a>
    </div>

    <div class="footer-social-icons">
      <a href="#" class="social-circle-btn" aria-label="Language / Global">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </a>

      <a href="#" class="social-circle-btn" aria-label="Email Support">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>
    </div>
  </footer>

  <!-- CLIENT INTERACTION JAVASCRIPT -->
  <script>
    function removeFromWishlist(btn) {
      if (confirm('Remove this item from your wishlist?')) {
        const card = btn.closest('.wishlist-card');
        card.style.opacity = '0';
        card.style.transform = 'scale(0.9)';
        setTimeout(() => {
          card.remove();
        }, 200);
      }
    }

    function moveToCart(btn, itemName) {
      alert(`${itemName} has been added to your shopping cart!`);
    }

    function quickAdd(itemName) {
      alert(`${itemName} added to your cart!`);
    }
  </script>

</body>
</html>
