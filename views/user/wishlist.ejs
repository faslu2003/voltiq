<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Your Wishlist · Voltiq' %>
  </title>
  <link rel="stylesheet" href="/css/user/wishlist.css">
</head>

<body>

  <!-- SITE HEADER -->
  <header class="site-header">
    <div class="header-left">
      <a href="/" class="brand-logo">voltiq</a>
      <nav class="main-nav">
        <a href="/home" class="nav-link">Home</a>
        <a href="/new-arrivals" class="nav-link">New Arrivals</a>
        <a href="/support" class="nav-link">Support</a>
      </nav>
    </div>

    <div class="header-search">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" class="search-input" placeholder="Search..." aria-label="Search products">
    </div>

    <div class="header-actions">
      <a href="/profile" class="icon-btn" aria-label="User Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <!-- Wishlist Active Pill -->
      <a href="/wishlist" class="icon-btn active" aria-label="Wishlist">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="none">
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
          </path>
        </svg>
      </a>

      <a href="/cart" class="icon-btn" aria-label="Shopping Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </a>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="main-container">

    <!-- PAGE HEADING -->
    <div class="page-heading-group">
      <h1>Your Wishlist</h1>
      <p>Manage your saved favorites and complete your atmospheric tech collection.</p>
    </div>

    <!-- WISHLIST ITEMS GRID (4 COLUMNS) -->
    <section class="wishlist-grid" id="wishlistGrid">

      <% wishlistItems.forEach((item)=> { %>

        <!-- Card -->
        <div class="wishlist-card">
          <a href="/products/details/<%= item.product._id %>">

            <div class="card-image-box">
              <span class="stock-badge">
                <%= item.variant.stock===0 ? 'Out of Stock' : 'In Stock' %>
              </span>
              <img src="<%= item.variant.imgUrls[0] %>" alt="<%= item.product.name %>" class="card-image">
            </div>
            <div class="card-body">
              <h3 class="card-title">
                <%= item.product.name %>
              </h3>
              <span class="card-subtitle">
                <%= `${item.variant.storage}, ${item.variant.color}` %>
              </span>
              <span class="card-price">₹<%= item.variant.price %></span>
            </div>

          </a>

          <div class="card-actions-row">
              <button type="button" class="btn-add-cart" data-variant-id="<%= item.variant._id %>"
                onclick="moveToCart(this)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                Add to Cart
              </button>
              <button type="button" class="btn-remove-item" data-variant-id="<%= item.variant._id %>"
                title="Remove from Wishlist" onclick="removeFromWishlist(this)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>

        </div>

        <% }) %>

    </section>

  </main>

  <!-- SITE FOOTER -->
  <footer class="site-footer">
    <div class="footer-left">
      <div class="footer-logo">voltiq</div>
      <div class="copyright">© <%= new Date().getFullYear() %> voltiq. atmospheric precision.</div>
    </div>

    <div class="footer-center-links">
      <a href="/privacy" class="footer-link">Privacy Policy</a>
      <a href="/terms" class="footer-link">Terms of Service</a>
      <a href="/shipping" class="footer-link">Shipping Info</a>
      <a href="/contact" class="footer-link">Contact Us</a>
    </div>

    <div class="footer-social-icons">
      <a href="#" class="social-circle-btn" aria-label="Language / Global">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
      </a>

      <a href="#" class="social-circle-btn" aria-label="Email Support">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </a>
    </div>
  </footer>

  <!-- CLIENT INTERACTION JAVASCRIPT -->
  <script>

    async function removeFromWishlist(btn) {
      const variantId = btn.dataset.variantId;

      const data = await fetch('/wishlist/remove', {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ variantId })
      });

      const result = await data.json();

      if (result.success) {
        const card = btn.closest('.wishlist-card');
        card.style.opacity = '0';
        card.style.transform = 'scale(0.9)';
        setTimeout(() => {
          card.remove();
        }, 200);
      }
    }

    async function moveToCart(btn) {
      const variantId = btn.dataset.variantId;

      const data = await fetch('/wishlist/move-to-cart', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          variantId
        })
      });

      const result = await data.json();

      const toast = document.getElementById('toast');

      if (!result.success) {
        toast.textContent = result.message;
        toast.classList.add('toast-error');
        toast.classList.add('show');

        setTimeout(() => {
          toast.classList.remove('show');
          toast.classList.remove('toast-error');
        }, 3000);
      }
      else {
        toast.textContent = "Product added to cart."
        toast.classList.add('toast-message');
        toast.classList.add('show');
        setTimeout(() => {
          toast.classList.remove('show');
          toast.classList.remove('toast-message');
        }, 3000);

        const card = btn.closest('.wishlist-card');
        card.style.opacity = '0';
        card.style.transform = 'scale(0.9)';
        setTimeout(() => {
          card.remove();
        }, 200);
      }
    }

    function quickAdd(itemName) {
      alert(`${itemName} added to your cart!`);
    }
  </script>

  <div id="toast" class="toast"></div>

</body>

</html>