<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kalnia:wght@100..700&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&family=Kalnia:wght@100..700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="css/user/sign-up-in.css">
    <title>Sign In</title>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>

<body>

    <header>

        <h2 id="logo">voltiq</h2>

    </header>

    <div id="wrapper">

        <% if (error) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
            <% } %>
                <% if (message) { %>
                    <div class="alert alert-success">
                        <%= message %>
                    </div>
                    <% } %>

                        <form action="/signin" method="post">

                            <p id="welcome-msg">Welcome Back</p>

                            <div class="input-box">
                                <label for="">Email Address</label>
                                <input type="text" placeholder="name@example.com" name="email" value="<%=data.email || ''%>">
                            </div>

                            <div class="input-box">
                                <div id="forgot-password">
                                    <label for="">Password</label> <a href="/signin/reset-password">Forgot Password?</a>
                                </div>
                                <input type="password" placeholder="Enter your password" name="password">
                            </div>

                            <div>
                                <button type="submit" id="signin-btn">Sign In</button>
                            </div>

                            <div id="divider">
                                <span>OR</span>
                            </div>

                            <!-- <button type="button" id="google-btn"> Google</button> -->
                            <div id="g_id_onload" data-client_id="<%= process.env.GOOGLE_CLIENT_ID %>"
                                data-login_uri="http://localhost:3000/auth/google" data-auto_prompt="false">
                            </div>

                            <div class="g_id_signin" data-type="standard" data-size="large" data-theme="outline"
                                data-text="continue_with" data-shape="rectangular">
                            </div>

                            <div id="signup">
                                <p>Don't have an account? <a href="/signup">Sign Up</a></p>
                            </div>

                        </form>

    </div>

</body>

</html>